# PeakLogic local development — copy to `.env` in this folder (gitignored).
# Loaded automatically on `npm start` / `npm run dev`.

# Optional: enable Tools → Cellular SIMs on appliance (cloud mode enables this by default)
# PEAKLOGIC_CELLULAR_SIMS=1

# Optional: enable Tools → Cloud Sims on appliance (cloud mode enables this by default)
# PEAKLOGIC_CLOUD_SIMS=1

# Optional: cloud deployment mode (or use npm run start:cloud)
# PEAKLOGIC_DEPLOYMENT=cloud