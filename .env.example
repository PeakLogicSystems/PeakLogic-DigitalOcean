PORT=3100
NODE_ENV=development

# MongoDB — local docker-compose default; production uses DO Managed MongoDB (mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mooreview_cloud

# JWT signing secret — change in production
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Hierarchy limits (defaults match product spec)
MAX_LOCATIONS_PER_TENANT=1000
MAX_SYSTEMS_PER_LOCATION=1000
MAX_DEVICES_PER_SYSTEM=1000
