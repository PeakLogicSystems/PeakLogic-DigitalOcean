# LilyGO T-ETH-ELITE-A7670X (integrated ESP32-S3 + W5500 + A7670)

CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_T_ETH_ELITE_A7670X=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_WIFI_ENABLED=y

CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y

CONFIG_FREERTOS_HZ=1000

# ESP-IDF 6: PPP for A7670 WAN (esp_modem)
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV4=y

# MQTT bridge buffers
CONFIG_MQTT_BUFFER_SIZE=4096

# Simetry/Teal Smart SIM
CONFIG_DEVCFG_MODEM_APN_DEFAULT="teal"

# WPA soft-AP join crashes with PSA/pthread mutex on IDF 6 — use internal Wi-Fi crypto
# CONFIG_ESP_WIFI_MBEDTLS_CRYPTO is not set
