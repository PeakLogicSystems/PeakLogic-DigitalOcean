# LilyGO T-ETH-ELITE-A7670X — Parc ST soft PLC
# Default image: no modem (Wi-Fi WAN) for cloud-arduino / bench testing.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_T_ETH_ELITE_A7670X=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Bench / cloud-arduino: Wi-Fi STA WAN (LTE off while fallback is on)
CONFIG_GATEWAY_WAN_WIFI_FALLBACK=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_WIFI_ENABLED=y

CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y
CONFIG_FREERTOS_HZ=1000

# MQTT buffer for put_program (MVBC base64)
CONFIG_MQTT_BUFFER_SIZE=20480

# Sequent SM-I-010 on T-ETH default I2C
CONFIG_SM_I010_ENABLE=y
CONFIG_SM_I010_SDA_GPIO=17
CONFIG_SM_I010_SCL_GPIO=18
CONFIG_SM_I010_STACK=0

# Duplex CT transmitters 0–1 V on GPIO 32–38 → I1_RAW..I7_RAW
CONFIG_CT_ADC_ENABLE=y
CONFIG_CT_ADC_GPIO_AI1=32
CONFIG_CT_ADC_GPIO_AI2=33
CONFIG_CT_ADC_GPIO_AI3=34
CONFIG_CT_ADC_GPIO_AI4=35
CONFIG_CT_ADC_GPIO_AI5=36
CONFIG_CT_ADC_GPIO_AI6=37
CONFIG_CT_ADC_GPIO_AI7=38
# LED default freed — GPIO 38 used by CT AI7
CONFIG_BOARD_STATUS_LED_GPIO=-1

# ESP-IDF 6: legacy driver/i2c.h until SM-I-010 migrates to i2c_master
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y

# ESP-IDF 6: PPP for A7670 WAN when Wi-Fi fallback is off
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV4=y
