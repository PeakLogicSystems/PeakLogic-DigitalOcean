# Waveshare ESP32-S3-Relay-1CH-U — Parc remote I/O / optional ST
# Build: idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults.waveshare_relay_1ch" set-target esp32s3

CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_T_ETH_ELITE_A7670X=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

CONFIG_GATEWAY_WAN_WIFI_FALLBACK=y
CONFIG_DEVCFG_WIFI_AP_SSID_DEFAULT="PeakLogic-Relay1CH"

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_FREERTOS_HZ=1000
CONFIG_MQTT_BUFFER_SIZE=20480

CONFIG_SM_I010_ENABLE=n
CONFIG_CT_ADC_ENABLE=n
CONFIG_GPIO_RELAY_ENABLE=y
CONFIG_GPIO_RELAY_PIN=1
CONFIG_GPIO_DI1_PIN=2
CONFIG_MV_PLATFORM_ID="waveshare-esp32s3-relay-1ch"
CONFIG_BOARD_STATUS_LED_GPIO=-1
