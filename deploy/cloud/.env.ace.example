# ACE Septic & Waste — LiftPoint Light fleet (PeakLogic cloud)
# Copy to deploy/cloud/.env (merge with .env.example)

PEAKLOGIC_PORT=3090
PEAKLOGIC_DEPLOYMENT=cloud
PEAKLOGIC_TENANT_ID=ace-septic-waste

MONGODB_URI=mongodb://mongodb:27017
PEAKLOGIC_CONFIG_URI=mongodb://mongodb:27017
PEAKLOGIC_CONFIG_DB=peaklogic_config
MONGODB_DB=peaklogic

PEAKLOGIC_MQTT_BROKER=mqtt://mosquitto:1883
MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=peaklogic
MOSQUITTO_PASS=change-me

# Nexcomm MQTT bridge — point at Azure IoT Hub / Nexus fan-out
NEXUS_MQTT_BROKER=mqtt://127.0.0.1:1883

# Open project ace-liftpoint-fleet after deploy.
# PdM: starts_analytics (all sites) + run_amps_creep (CT-equipped subset)
# Sample scaffold: 8 sites (4 CT, 4 starts-only)
# Bulk import: st/fixtures/fleet_import_ace.csv (ace-septic-waste)

# Operator: ACE Septic & Waste
# Parent: The Purple Standard
