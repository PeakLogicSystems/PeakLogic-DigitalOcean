# PeakLogic Cloud — C-store Opta Parc (portable multi-tenant SaaS)
# Copy to deploy/cloud/.env for runtime 3090 + Mosquitto, OR merge into /etc/peaklogic/runtime.env
# Do NOT set PEAKLOGIC_TENANT_ID on multi-tenant SaaS (:3100) — create customers in /admin/tenants

PEAKLOGIC_PORT=3090
PEAKLOGIC_DEPLOYMENT=cloud

MONGODB_URI=mongodb://mongodb:27017
PEAKLOGIC_CONFIG_URI=mongodb://mongodb:27017
PEAKLOGIC_CONFIG_DB=peaklogic_config
MONGODB_DB=peaklogic

PEAKLOGIC_MQTT_BROKER=mqtt://mosquitto:1883
MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=peaklogic
MOSQUITTO_PASS=change-me

MQTT_PARC_BROKER=mqtt://127.0.0.1:1883

# After SaaS install (port 3100): create tenant → import cstore-opta-parc-starter.est.zip
# Enable runtime 3090: deploy/cloud/debian/enable-runtime-3090.sh
# Onboarding: docs/CSTORE_OPTA_PARC_CLOUD.md
# Field Opta: docs/OPTA_PARC_CLOUD.md
