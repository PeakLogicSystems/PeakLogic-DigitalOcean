# PeakLogic cloud VM — environment (copy to `.env`)

# App
PEAKLOGIC_PORT=3090
PEAKLOGIC_DEPLOYMENT=cloud
PEAKLOGIC_TENANT_ID=local

# MongoDB (docker-compose service name `mongodb`; not exposed on host by default)
MONGODB_URI=mongodb://mongodb:27017
PEAKLOGIC_CONFIG_URI=mongodb://mongodb:27017
PEAKLOGIC_CONFIG_DB=peaklogic_config
MONGODB_DB=peaklogic

# MQTT broker (docker-compose service `mosquitto`; 1883 plain, 8883 TLS when enabled)
PEAKLOGIC_MQTT_BROKER=mqtt://mosquitto:1883
# PEAKLOGIC_MQTT_BROKER=mqtts://mosquitto:8883

# Mosquitto auth (default: credentials required; set MOSQUITTO_ALLOW_ANONYMOUS=true for dev)
MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=peaklogic
MOSQUITTO_PASS=change-me
MOSQUITTO_TLS=true
MOSQUITTO_TLS_PORT=8883
PEAKLOGIC_DOMAIN=peaklogic.io

# Pass same credentials to peaklogic hub (System setup → MQTT Parc username/password)
# mqttParc.username=peaklogic
# mqttParc.password=change-me
# mqttParc.brokerUrl=mqtts://peaklogic.io:8883

# Optional auth (leave empty for anonymous Mosquitto in dev)
# PEAKLOGIC_TOKEN=

# Historian (optional — configure in UI or override here)
# MONGODB_COLLECTION=tag_logs
# MONGODB_EDGE_COLLECTION=edge_inference
# MONGODB_SAMPLE_MS=5000

# Site appliance uplink (configure on each PeakLogic appliance, not usually on cloud VM)
# cloudRemote.enabled=true
# cloudRemote.tenantId=<from pairing>
# cloudRemote.gatewayId=<appliance uuid>
# cloudRemote.brokerUrl=mqtt://<droplet-ip>:1883

# Cellular SIM management (enabled by default when PEAKLOGIC_DEPLOYMENT=cloud)
# PEAKLOGIC_CELLULAR_SIMS=1

# NextCentury cloud hub — 15 sites × 1500 devices auto-sync (3 tags/device + status).
# Default when PEAKLOGIC_DEPLOYMENT=cloud and unset: 70912. Override only if your fleet differs.
# PEAKLOGIC_MAX_TAGS=70912
