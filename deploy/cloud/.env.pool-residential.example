# PeakLogic Pool cloud — Maple Street Pool (residential)
# Copy to deploy/cloud/.env (merge with .env.example)

PEAKLOGIC_PORT=3090
PEAKLOGIC_DEPLOYMENT=cloud
PEAKLOGIC_TENANT_ID=pool-cloud

MONGODB_URI=mongodb://mongodb:27017
PEAKLOGIC_CONFIG_URI=mongodb://mongodb:27017
PEAKLOGIC_CONFIG_DB=peaklogic_config
MONGODB_DB=peaklogic

PEAKLOGIC_MQTT_BROKER=mqtt://mosquitto:1883
MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=peaklogic
MOSQUITTO_PASS=change-me

# Residential pool — 1 cellular gateway (chemistry + status uplink)
# Open project: pool-cloud-residential
# Homeowner login role: homeowner

# Device ID:
#   mv_pool_maple_01
