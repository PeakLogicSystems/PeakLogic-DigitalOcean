# Putnam County Utilities — PeakLogic cloud VM
# Copy to deploy/cloud/.env (merge with .env.example)

PEAKLOGIC_PORT=3090
PEAKLOGIC_DEPLOYMENT=cloud
PEAKLOGIC_TENANT_ID=putnam-county-utilities

MONGODB_URI=mongodb://mongodb:27017
PEAKLOGIC_CONFIG_URI=mongodb://mongodb:27017
PEAKLOGIC_CONFIG_DB=peaklogic_config
MONGODB_DB=peaklogic

PEAKLOGIC_MQTT_BROKER=mqtt://mosquitto:1883
MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=peaklogic
MOSQUITTO_PASS=change-me

PEAKLOGIC_CELLULAR_SIMS=1

# Fleet: 6 Nexcomm lift MQTT drivers (lift_station_epi) + 1 plant appliance relay
# Point NEXUS_MQTT_BROKER at Nexcomm/Azure MQTT bridge or local mirror.
# Open project putnam-county-cloud after deploy.

# Tenant slug: putnam-county-utilities
# Plant gatewayId: mv_pcu_mle_plant_01
# Lift serials: 40a36bce47f3, 40a36bcd7bb4, 40a36bc74cee, 40a36bc74b17, 40a36bce4ce2, 40a36bc74e62
