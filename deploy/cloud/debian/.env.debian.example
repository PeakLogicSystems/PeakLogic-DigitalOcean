# DEPRECATED for SaaS droplets — use saas.env.example + install-saas.sh (port 3100).
# This file remains for legacy install.sh only (do not use for peaklogic.io).

PORT=3090
PEAKLOGIC_PORT=3090
PEAKLOGIC_DEPLOYMENT=cloud
PEAKLOGIC_PRODUCT=cloud
PEAKLOGIC_DATA=/var/lib/peaklogic

MONGO_URL=mongodb://127.0.0.1:27017/peaklogic
MONGODB_URI=mongodb://127.0.0.1:27017/peaklogic
PEAKLOGIC_CONFIG_URI=mongodb://127.0.0.1:27017/peaklogic
PEAKLOGIC_CONFIG_DB=peaklogic_config
MONGODB_DB=peaklogic

PEAKLOGIC_MQTT_BROKER=mqtt://127.0.0.1:1883

# Mosquitto provisioning (install.sh reads these)
MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=peaklogic
MOSQUITTO_PASS=CHANGE_ME_before_production
MOSQUITTO_TLS=true
MOSQUITTO_TLS_PORT=8883
PEAKLOGIC_DOMAIN=peaklogic.io
