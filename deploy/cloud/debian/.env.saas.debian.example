# PeakLogic multi-tenant SaaS (port 3100) — copy to /etc/peaklogic/saas.env by install-saas.sh
# Uses DigitalOcean Managed MongoDB (mongodb+srv://). Do NOT use local mongod for production SaaS.

PORT=3100
NODE_ENV=production
PEAKLOGIC_DEPLOYMENT=cloud

# DigitalOcean Managed MongoDB — paste the FULL connection string from:
#   DO Control Panel -> Databases -> your cluster -> Connection details -> Connection string
# Example hostname: db-mongodb-nyc3-12345.mongo.ondigitalocean.com
# Do NOT leave USER, PASSWORD, or the hostname as placeholders.
MONGODB_URI=mongodb+srv://doadmin:YOUR_PASSWORD_HERE@db-mongodb-nyc3-XXXXX.mongo.ondigitalocean.com/peaklogic_cloud?tls=true&authSource=admin&replicaSet=db-mongodb-nyc3-XXXXX
MONGODB_DB=peaklogic_cloud

# Required — generate long random strings before production
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRES_IN=7d
PLATFORM_ADMIN_KEY=CHANGE_ME_PLATFORM_ADMIN

# Public URLs (for links in emails / pairing — set to your domain)
PUBLIC_APP_URL=https://peaklogic.io
PUBLIC_API_URL=https://peaklogic.io

# Optional MQTT broker on this host — enable with enable-saas-mqtt.sh (Phase 1)
# PEAKLOGIC_MQTT_BROKER=mqtt://127.0.0.1:1883

# --- Phase 1 archive compaction (cloud 2) — see enable-phase1-archive-compact.sh ---
# ARCHIVE_SERVER_URL=http://10.x.x.x:8090
# ARCHIVE_SERVER_TOKEN=CHANGE_ME
# MONGODB_COLLECTION=tag_logs

# --- Optional edge runtime (port 3090) — enable later with enable-runtime-3090.sh ---
# PEAKLOGIC_RUNTIME_ENABLED=false
# RUNTIME_PORT=3090
