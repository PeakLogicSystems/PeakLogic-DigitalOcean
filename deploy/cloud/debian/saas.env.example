# PeakLogic SaaS — copied to /etc/peaklogic/saas.env on first install-saas.sh.
# Edit MOSQUITTO_PASS before production, then re-run install-saas.sh.

PORT=3100
PEAKLOGIC_PORT=3100
PEAKLOGIC_DEPLOYMENT=cloud
PEAKLOGIC_PRODUCT=mvp-suite
PEAKLOGIC_DATA=/var/lib/peaklogic

# Seeded on first boot (change in production)
PEAKLOGIC_SEED_TENANT=demo
PEAKLOGIC_SEED_ADMIN_EMAIL=admin@demo.local
PEAKLOGIC_SEED_ADMIN_PASSWORD=ChangeMeAdmin!
PEAKLOGIC_SEED_OPERATOR_EMAIL=operator@demo.local
PEAKLOGIC_SEED_OPERATOR_PASSWORD=demo

MONGO_URL=mongodb://127.0.0.1:27017/peaklogic
MONGODB_URI=mongodb://127.0.0.1:27017/peaklogic
PEAKLOGIC_CONFIG_URI=mongodb://127.0.0.1:27017/peaklogic
PEAKLOGIC_CONFIG_DB=peaklogic_config
MONGODB_DB=peaklogic

PEAKLOGIC_MQTT_BROKER=mqtt://127.0.0.1:1883

# Mosquitto provisioning (install-saas.sh reads these)
MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=peaklogic
MOSQUITTO_PASS=CHANGE_ME_before_production

# NextCentury Meters API (optional — used when driver email/password are blank in drivers.json)
# NEXTCENTURY_EMAIL=
# NEXTCENTURY_PASSWORD=
