# Phase 1 archive droplet — copy to /etc/peaklogic/archive.env on peaklogic-archive
# Token MUST match ARCHIVE_SERVER_TOKEN on SaaS (/etc/peaklogic/saas.env)

PORT=8090
ARCHIVE_ROOT=/data/archive
ARCHIVE_SERVER_TOKEN=CHANGE_ME_SHARED_ARCHIVE_TOKEN

# Optional bind (default all interfaces — rely on DO firewall for SaaS IP only)
# HOST=0.0.0.0
