# Phase 1 MQTT droplet — copy to /etc/peaklogic/mqtt.env on peaklogic-mqtt
# See docs/CLOUD_DEPLOY_DO_PHASE1_ATL-MQTT.md and deploy/cloud/MQTT.md

PEAKLOGIC_DOMAIN=mqtt.peaklogic.io

MOSQUITTO_USER=peaklogic
MOSQUITTO_PASS=CHANGE_ME_STRONG_SECRET
MOSQUITTO_ALLOW_ANONYMOUS=false

# TLS listener (8883). Prefer Let's Encrypt after DNS A record exists.
MOSQUITTO_TLS=true
MOSQUITTO_TLS_PORT=8883

# Plain listener (1883) — keep for Opta / lab; restrict via DO firewall when possible
MOSQUITTO_PLAIN=true
MOSQUITTO_PLAIN_PORT=1883
