# Phase 1 Atlanta SaaS — copy to /etc/peaklogic/saas.env on peaklogic-saas
# See docs/CLOUD_DEPLOY_DO_PHASE1_ATL-MQTT.md

PORT=3100
NODE_ENV=production
PEAKLOGIC_DEPLOYMENT=cloud

# DigitalOcean Managed MongoDB (full connection string — no placeholders)
MONGODB_URI=mongodb+srv://doadmin:YOUR_PASSWORD_HERE@db-mongodb-nyc3-XXXXX.mongo.ondigitalocean.com/peaklogic_cloud?tls=true&authSource=admin&replicaSet=db-mongodb-nyc3-XXXXX
MONGODB_DB=peaklogic_cloud

JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRES_IN=7d
PLATFORM_ADMIN_KEY=CHANGE_ME_PLATFORM_ADMIN

PUBLIC_APP_URL=https://peaklogic.io
PUBLIC_API_URL=https://peaklogic.io

# Dedicated MQTT droplet (Phase 1 Atlanta recommended)
PEAKLOGIC_MQTT_BROKER=mqtts://mqtt.peaklogic.io:8883
# Until TLS is ready: mqtt://mqtt.peaklogic.io:1883
MOSQUITTO_USER=peaklogic
MOSQUITTO_PASS=CHANGE_ME_same_as_mv_mqtt

# Shared secret for mv-mqtt log shipper → POST /api/mqtt-broker-log/ingest
# Generate: openssl rand -hex 24
PEAKLOGIC_MQTT_LOG_INGEST_TOKEN=CHANGE_ME_MQTT_LOG_INGEST_TOKEN

# Archive droplet (cloud 2) — token must match archive.env
ARCHIVE_SERVER_URL=http://ARCHIVE_DROPLET_IP:8090
ARCHIVE_SERVER_TOKEN=CHANGE_ME_SHARED_ARCHIVE_TOKEN

# ---------------------------------------------------------------------------
# PeakLogic System Admin (seeded on first boot)
# When 2FA/MFA is enabled, store recovery / TOTP settings in the 2FA block below.
# ---------------------------------------------------------------------------
PEAKLOGIC_SEED_TENANT=peaklogic
PEAKLOGIC_SEED_ADMIN_EMAIL=admin@peaklogic.io
PEAKLOGIC_SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Optional tenant operator (leave blank to skip seeding)
# PEAKLOGIC_SEED_OPERATOR_EMAIL=
# PEAKLOGIC_SEED_OPERATOR_PASSWORD=

# ---------------------------------------------------------------------------
# Two-factor authentication (add when 2FA is enabled)
# ---------------------------------------------------------------------------
# PEAKLOGIC_ADMIN_2FA_ENABLED=false
# PEAKLOGIC_ADMIN_2FA_METHOD=totp
# PEAKLOGIC_ADMIN_2FA_SECRET=
# PEAKLOGIC_ADMIN_2FA_RECOVERY_CODES=
