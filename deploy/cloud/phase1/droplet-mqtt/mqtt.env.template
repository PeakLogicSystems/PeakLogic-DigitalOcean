# PeakLogic Phase 1 — dedicated MQTT droplet (cloud-mqtt-atl1)
# Copy to /etc/peaklogic/mqtt.env BEFORE install-mqtt-droplet.sh

PEAKLOGIC_DOMAIN=mqtt.peaklogic.io

MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=peaklogic
MOSQUITTO_PASS=CHANGE_ME_MQTT_PASSWORD

MOSQUITTO_TLS=true
MOSQUITTO_TLS_PORT=8883

# Plain :1883 stays open on VPC for SaaS / ingest hub clients (peaklogic.conf listener).
