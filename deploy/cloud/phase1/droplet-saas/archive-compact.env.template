# PeakLogic Phase 1 — day-7 archive compaction (cloud 1)
# Copy to /etc/peaklogic/archive-compact.env BEFORE enable-phase1-archive-compact.sh
# MONGODB_URI is inherited from saas.env via systemd (same cluster).

MONGODB_DB=peaklogic_cloud
MONGODB_COLLECTION=tag_logs

# Cloud 2 archive droplet — prefer private VPC IP (10.x.x.x), not public IP
ARCHIVE_SERVER_URL=http://10.0.0.2:8090
ARCHIVE_SERVER_TOKEN=CHANGE_ME_ARCHIVE_TOKEN

ARCHIVE_COMPACT_DRY_RUN=0
ARCHIVE_ZSTD_LEVEL=3
ZSTD_BIN=zstd

# Manual test day override (optional):
# ARCHIVE_COMPACT_DAY=2026-06-24
