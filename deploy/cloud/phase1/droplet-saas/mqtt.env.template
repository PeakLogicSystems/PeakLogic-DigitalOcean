# PeakLogic Phase 1 — MQTT on SaaS droplet (cloud 1)
# Copy to /etc/peaklogic/mqtt.env BEFORE enable-saas-mqtt.sh

PEAKLOGIC_DOMAIN=peaklogic.io

MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=peaklogic
MOSQUITTO_PASS=CHANGE_ME_MQTT_PASSWORD

# Use TLS for field appliances (recommended after certbot on peaklogic.io)
MOSQUITTO_TLS=true
MOSQUITTO_TLS_PORT=8883

# For lab only before TLS cert exists:
# MOSQUITTO_TLS=false
