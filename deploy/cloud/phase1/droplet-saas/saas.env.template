# PeakLogic Phase 1 — cloud 1 (SaaS hot droplet)
# Copy to /etc/peaklogic/saas.env BEFORE install-saas.sh (or edit after template install).
# Managed MongoDB — NOT local mongod.

PORT=3100
NODE_ENV=production
PEAKLOGIC_DEPLOYMENT=cloud
PEAKLOGIC_PRODUCT=cloud
PEAKLOGIC_DATA=/var/lib/peaklogic

# DigitalOcean Managed MongoDB — paste FULL connection string from DO Databases panel.
MONGODB_URI=mongodb+srv://doadmin:YOUR_PASSWORD@db-mongodb-nyc3-XXXXX.mongo.ondigitalocean.com/peaklogic_cloud?tls=true&authSource=admin&replicaSet=db-mongodb-nyc3-XXXXX
MONGODB_DB=peaklogic_cloud

# Generate on your PC: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_IN=7d

# Generate on your PC: openssl rand -hex 24
PLATFORM_ADMIN_KEY=CHANGE_ME_PLATFORM_ADMIN

PUBLIC_APP_URL=https://peaklogic.io
PUBLIC_API_URL=https://peaklogic.io

# Dedicated MQTT droplet (recommended — docs/CLOUD_DEPLOY_DO_PHASE1_ATL-MQTT.md):
# Set via configure-saas-mqtt-remote.sh after cloud-mqtt-atl1 is up:
# PEAKLOGIC_MQTT_BROKER=mqtt://10.x.x.x:1883
#
# Legacy colocated MQTT on this host (enable-saas-mqtt.sh):
# PEAKLOGIC_MQTT_BROKER=mqtt://127.0.0.1:1883
