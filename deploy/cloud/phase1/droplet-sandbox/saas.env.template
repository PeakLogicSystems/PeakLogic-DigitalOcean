# PeakLogic sandbox — single droplet (test.peaklogic.io)
# Region: nyc1 (or any) — NOT production Atlanta stack.
# All Phase 1 roles on one server for integration / pre-prod testing.

PORT=3100
NODE_ENV=production
PEAKLOGIC_DEPLOYMENT=cloud
PEAKLOGIC_PRODUCT=cloud
PEAKLOGIC_DATA=/var/lib/peaklogic

# Separate DO Managed Mongo cluster from production (nyc1 recommended)
MONGODB_URI=mongodb+srv://doadmin:YOUR_PASSWORD@db-mongodb-nyc1-XXXXX.mongo.ondigitalocean.com/peaklogic_sandbox?tls=true&authSource=admin&replicaSet=db-mongodb-nyc1-XXXXX
MONGODB_DB=peaklogic_sandbox

JWT_SECRET=CHANGE_ME_SANDBOX_JWT
JWT_EXPIRES_IN=7d
PLATFORM_ADMIN_KEY=CHANGE_ME_SANDBOX_ADMIN

PUBLIC_APP_URL=https://test.peaklogic.io
PUBLIC_API_URL=https://test.peaklogic.io

# Set after enable-saas-mqtt.sh
# PEAKLOGIC_MQTT_BROKER=mqtt://127.0.0.1:1883
