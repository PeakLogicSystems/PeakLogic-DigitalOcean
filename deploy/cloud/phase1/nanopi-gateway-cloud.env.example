# NanoPi FriendlyWrt — cloud Mosquitto bridge credentials
# Copy to nanopi-gateway-cloud.env (gitignored) for local bench notes.
# On the device, write the password file directly:
#   echo 'YOUR_MOSQUITTO_PASS' > /etc/mosquitto/cloud.pass
#
# See deploy/cloud/phase1/NANOPI-OPTA-GATEWAY-MQTT.md

CLOUD_HOST=mqtt.peaklogic.io
CLOUD_PORT=8883
CLOUD_USER=peaklogic
MOSQUITTO_PASS=REPLACE_WITH_MOSQUITTO_PASS_FROM_mv-mqtt
