# PeakLogic Phase 1 production deploy configuration
# Region: atl1 (Atlanta) OR nyc1 (New York) — same 3-droplet layout.
# If DO has no Atlanta: use nyc1 — see deploy/cloud/phase1/NYC1-PRODUCTION.md
#
# Copy to phase1-prod.local.env or phase1-atl.local.env (gitignored), then:
#   npm run deploy:phase1-prod
#
# Prerequisites: VPC, Mongo, 3 droplets, firewalls, archive volume (all same region).

# --- SSH targets (public IPs or root@hostname) ---
ARCHIVE_SSH=root@ARCHIVE_PUBLIC_IP
MQTT_SSH=root@MQTT_PUBLIC_IP
SAAS_SSH=root@SAAS_PUBLIC_IP

# Optional SSH key (leave empty to use default agent / ~/.ssh/config)
SSH_KEY=

# --- VPC private IPs (fill after droplets exist, or leave empty for auto-detect on archive/mqtt) ---
ARCHIVE_PRIVATE_IP=
MQTT_PRIVATE_IP=

# --- Public IPs (for verification / pre-DNS PUBLIC_* URLs) ---
SAAS_PUBLIC_IP=

# --- DNS / URLs ---
PEAKLOGIC_DOMAIN=peaklogic.io
MQTT_DOMAIN=mqtt.peaklogic.io
CERTBOT_EMAIL=admin@peaklogic.io

# Pre-DNS verification (use http://SAAS_PUBLIC_IP). After cutover set https://peaklogic.io
PUBLIC_APP_URL=http://SAAS_PUBLIC_IP
PUBLIC_API_URL=http://SAAS_PUBLIC_IP

# --- DigitalOcean Managed MongoDB (full connection string; atl1 or nyc1 host) ---
MONGODB_URI=mongodb+srv://doadmin:PASSWORD@private-peaklogic-prod-mongo-xxxxx.mongo.ondigitalocean.com/peaklogic_cloud?tls=true&authSource=admin
MONGODB_DB=peaklogic_cloud

# --- Secrets (generate: openssl rand -hex 32 / -hex 24 / -hex 16) ---
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_IN=7d
PLATFORM_ADMIN_KEY=CHANGE_ME_PLATFORM_ADMIN
ARCHIVE_SERVER_TOKEN=CHANGE_ME_ARCHIVE_TOKEN
MOSQUITTO_USER=peaklogic
MOSQUITTO_PASS=CHANGE_ME_MQTT_PASSWORD

# --- Archive paths ---
ARCHIVE_ROOT=/data/archive

# --- Certbot (set false for IP-only smoke test before DNS) ---
RUN_MQTT_CERTBOT=true
RUN_SAAS_CERTBOT=false

# --- Bundle paths (auto-detected from dist/ if empty) ---
SAAS_BUNDLE=
ARCHIVE_BUNDLE=
