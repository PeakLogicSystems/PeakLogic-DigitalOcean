[Unit]
Description=MooreVIEW Cloud server
After=network.target mongod.service

[Service]
Type=simple
WorkingDirectory=/opt/mooreview-cloud
Environment=NODE_ENV=production
Environment=MOOREVIEW_DATA=/var/lib/mooreview
Environment=MONGODB_URI=mongodb://127.0.0.1:27017
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
