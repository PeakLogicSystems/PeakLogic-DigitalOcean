[Unit]
Description=PeakLogic Cloud server
After=network.target mongod.service

[Service]
Type=simple
WorkingDirectory=/opt/peaklogic-cloud
Environment=NODE_ENV=production
Environment=PEAKLOGIC_DATA=/var/lib/peaklogic
Environment=MONGODB_URI=mongodb://127.0.0.1:27017
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
