{
  "name": "peaklogic-cloud",
  "version": "0.1.0",
  "description": "PeakLogic multi-tenant cloud API — tenant → location → system → device",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:runtime": "node server.js",
    "dev": "node --watch src/server.js",
    "indexes": "node src/db/indexes.js",
    "migrate": "node src/db/indexes.js",
    "seed": "node scripts/seed.js",
    "test": "node --test test/limits.test.js test/cloudApi.test.js test/userProfile.test.js",
    "test:all": "node --test test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "modbus-serial": "^8.0.25",
    "mongodb": "^6.12.0",
    "mqtt": "^5.16.0",
    "nodemailer": "^6.10.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4"
  }
}
