[Unit]
Description=PeakLogic SaaS platform
After=network.target mongod.service mosquitto.service

[Service]
Type=simple
User=peaklogic
Group=peaklogic
WorkingDirectory=/home/peaklogic
EnvironmentFile=/etc/peaklogic/saas.env
Environment=NODE_ENV=production
Environment=PEAKLOGIC_DEPLOYMENT=cloud
Environment=PEAKLOGIC_PRODUCT=cloud
Environment=PEAKLOGIC_DATA=/var/lib/peaklogic
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
