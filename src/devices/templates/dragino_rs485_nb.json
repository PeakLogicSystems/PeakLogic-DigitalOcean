{
  "id": "dragino_rs485_nb",
  "label": "Dragino RS485-NB — RS485→MQTT gateway (MV Cloud)",
  "vendor": "Dragino",
  "model": "RS485-NB",
  "transport": "mqtt_parc_telemetry",
  "sharedBus": false,
  "driverId": "dragino_01",
  "tagsFromDevice": true,
  "diCount": 0,
  "aiCount": 10,
  "defaults": {
    "deviceId": "dragino_01",
    "topicPrefix": "peaklogic/v1",
    "cloudBrokerHost": "peaklogic.io",
    "cloudBrokerPort": 1883,
    "cloudTenantId": "",
    "draginoTopicPrefix": "dragino",
    "draginoTopicSuffix": "uplink"
  },
  "driver": {
    "enabled": true,
    "timeoutMs": 10000,
    "telemetryOnly": true,
    "remoteExecution": false
  },
  "tags": {
    "explicit": [
      {
        "id": "CELL_SIGNAL",
        "type": "INT",
        "role": "input",
        "comment": "NB-IoT RSSI code (0–31, 99=unknown)"
      },
      {
        "id": "CELL_BATTERY_V",
        "type": "REAL",
        "role": "input",
        "comment": "Internal battery voltage (V)"
      },
      {
        "id": "MB_REG_1",
        "type": "INT",
        "role": "input",
        "comment": "Modbus holding/input register 1 (from Payload hex decode)"
      },
      {
        "id": "MB_REG_2",
        "type": "INT",
        "role": "input",
        "comment": "Modbus holding/input register 2"
      },
      {
        "id": "MB_REG_3",
        "type": "INT",
        "role": "input",
        "comment": "Modbus holding/input register 3"
      },
      {
        "id": "MB_REG_4",
        "type": "INT",
        "role": "input",
        "comment": "Modbus holding/input register 4"
      }
    ]
  },
  "telemetrySchema": {
    "tags": "CELL_SIGNAL, CELL_BATTERY_V, MB_REG_n (auto from Payload hex)",
    "dragino": "imei, imsi, model, payloadHex, time"
  },
  "notes": "Cellular RS485 gateway to PeakLogic Cloud (NB-IoT). Not an Opta LAN bridge — use LilyGO T-ETH for Opta→cloud. Configure Dragino AT+SERVADDR=peaklogic.io,1883 and AT+PUBTOPIC=peaklogic/v1/dragino_01/telemetry (or tenant-scoped peaklogic/v1/{tenantId}/dragino_01/telemetry). Hub auto-converts Dragino JSON to Parc tags. See docs/DRAGINO_PARC_CLOUD.md. Sample: st/fixtures/dragino-rs485-nb-telemetry-sample.json."
}
