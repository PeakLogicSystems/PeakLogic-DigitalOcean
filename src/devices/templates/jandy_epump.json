{
  "id": "jandy_epump",
  "label": "Jandy ePump VS — RS-485",
  "vendor": "Jandy",
  "model": "ePump variable-speed pump",
  "transport": "jandy_rs485",
  "sharedBus": true,
  "driverId": "jandy_bus",
  "diCount": 0,
  "doCount": 0,
  "aiCount": 3,
  "hrCount": 0,
  "defaults": {
    "serialPort": "COM4",
    "baud": 9600,
    "deviceAddr": 120,
    "deviceClass": "epump",
    "parity": "none",
    "stopBits": 1,
    "pollIntervalMs": 60000,
    "busGapMs": 120
  },
  "driver": {
    "enabled": true,
    "timeoutMs": 2000,
    "frameDelayMs": 30
  },
  "tags": {
    "jandy": [
      { "id": "JEP_RPM", "type": "INT", "role": "input", "point": "rpm", "deviceClass": "epump", "comment": "Actual RPM" },
      { "id": "JEP_WATTS", "type": "INT", "role": "input", "point": "watts", "deviceClass": "epump", "comment": "Power draw (W)" },
      { "id": "JEP_RUNNING", "type": "BOOL", "role": "input", "point": "running", "deviceClass": "epump" },
      { "id": "JEP_RPM_CMD", "type": "INT", "role": "output", "point": "rpm_cmd", "deviceClass": "epump", "comment": "Speed setpoint RPM" },
      { "id": "JEP_RUN_CMD", "type": "BOOL", "role": "output", "point": "run_cmd", "deviceClass": "epump", "comment": "Start/stop pump" },
      { "id": "JEP_WATTS_CMD", "type": "INT", "role": "output", "point": "watts_cmd", "deviceClass": "epump", "comment": "Power setpoint (W)" }
    ]
  }
}
