{
  "id": "lift_station_dual_duplex",
  "label": "Lift station — dual duplex",
  "vendor": "PeakLogic",
  "model": "Opta + D1608E — dual duplex alternator (ALT2, 2 pumps)",
  "transport": "mqtt_parc",
  "stationType": "dual_duplex",
  "defaultProgram": "logic/36_duplex_lift_station.st",
  "stProgram": "logic/36_duplex_lift_station.st",
  "stProgramLabel": "DUPLEXLS",
  "tagsFromDevice": true,
  "diCount": 8,
  "doCount": 4,
  "aiCount": 8,
  "defaults": {
    "deviceId": "lift_dd_01",
    "reportIntervalMs": 200,
    "scanMs": 100,
