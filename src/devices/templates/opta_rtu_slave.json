{
  "id": "opta_rtu_slave",
  "label": "Arduino Opta — Modbus RTU Slave (example sketch)",
  "vendor": "Arduino",
  "model": "Opta RS485 / WiFi",
  "transport": "modbus_rtu",
  "driverId": "opta_rtu",
  "diCount": 8,
  "doCount": 4,
  "aiCount": 8,
  "hrCount": 8,
  "defaults": {
    "serialPort": "COM3",
    "baud": 9600,
    "slaveId": 2,
    "parity": "none",
    "stopBits": 1
  },
  "driver": {
    "enabled": true,
    "timeoutMs": 1000
  },
  "tags": {
    "discrete": [{ "prefix": "I", "count": 8, "start": 0 }],
    "coil": [{ "prefix": "R", "count": 4, "start": 0 }],
    "input": [
      { "prefix": "I", "suffix": "_RAW", "count": 8, "start": 0 },
      { "prefix": "HM", "suffix": "", "count": 8, "start": 8 }
    ],
    "holding": [{ "prefix": "H", "count": 8, "start": 0 }]
  }
}
