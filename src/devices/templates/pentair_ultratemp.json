{
  "id": "pentair_ultratemp",
  "label": "Pentair UltraTemp / MasterTemp — RS-485",
  "vendor": "Pentair",
  "model": "UltraTemp heat pump (direct RS-485)",
  "transport": "pentair_rs485",
  "sharedBus": false,
  "driverId": "pentair_hp",
  "diCount": 0,
  "doCount": 0,
  "aiCount": 4,
  "hrCount": 0,
  "defaults": {
    "serialPort": "COM4",
    "baud": 9600,
    "deviceAddr": 112,
    "deviceClass": "ultratemp",
    "parity": "none",
    "stopBits": 1,
    "pollIntervalMs": 300000
  },
  "driver": {
    "enabled": true,
    "timeoutMs": 2000,
    "frameDelayMs": 30
  },
  "tags": {
    "pentair": [
      {
        "id": "HP_MODE",
        "type": "INT",
        "role": "input",
        "point": "mode",
        "comment": "0=off 1=heat 2=cool"
      },
      {
        "id": "HP_RUNNING",
        "type": "BOOL",
        "role": "input",
        "point": "running",
        "comment": "Heat pump compressor active"
      },
      {
        "id": "HP_COOLING",
        "type": "BOOL",
        "role": "input",
        "point": "cooling",
        "comment": "Cooling mode active"
      },
      {
        "id": "HP_OFFSET_F",
        "type": "INT",
        "role": "input",
        "point": "offset_temp",
        "comment": "Offset temp byte from status frame"
      },
      {
        "id": "HP_MODE_CMD",
        "type": "INT",
        "role": "output",
        "point": "mode_cmd",
        "comment": "Set 0=off 1=heat 2=cool (UltraTemp)"
      },
      {
        "id": "HP_RUN_CMD",
        "type": "BOOL",
        "role": "output",
        "point": "run_cmd",
        "comment": "Network run — maps to heat mode when on"
      }
    ]
  }
}
