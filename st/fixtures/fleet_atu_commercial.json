          {
            "type": "dual_atu",
            "count": 1
          }
        ],
        "lifts": [
          {
            "type": "simplex",
            "count": 4
          }
        ]
      },
      {
        "designGpd": 10000,
        "atu": [
          {
            "type": "quad_atu",
            "count": 4
          }
        ],
        "lifts": [
          {
            "type": "simplex",
            "count": 20
          }
        ]
      },
      {
        "designGpd": 10000,
        "profile": "dwts",
        "atu": [
          {
            "type": "quad_atu",
            "count": 2,
            "gpdEach": 5000,
            "modules": "4× 1,250 gal parallel + drip"
          }
        ],
        "lifts": [
          {
            "type": "simplex",
            "count": 20,
            "role": "collection",
            "note": "10 simplex lifts per zone → duplex booster"
          },
          {
            "type": "dual_duplex",
            "count": 2,
            "role": "booster",
            "note": "Zone booster → trash tank → parallel ATU"
          }
        ]
      }
    ]
