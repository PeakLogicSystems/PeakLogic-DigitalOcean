          SetInt(LIGHT_STA, 3);
        ELSE
          IF LIGHT_OP = 4 AND IsON(LIGHT_SCHED_EN) AND IsON(VPB1) THEN
            IF IsOFF(LIGHT_PULSE_BUSY_Z1) THEN TurnON(LIGHT_Z1); END_IF;
            IF IsOFF(LIGHT_PULSE_BUSY_Z2) THEN TurnON(LIGHT_Z2); END_IF;
