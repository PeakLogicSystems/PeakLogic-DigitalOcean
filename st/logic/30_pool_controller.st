      IF IsOFF(LIGHT_PULSE_BUSY_Z6) THEN TurnON(LIGHT_Z6); END_IF;
      SetInt(LIGHT_STA, 1);
    ELSE
      IF LIGHT_OP = 2 THEN
        IF IsOFF(LIGHT_PULSE_BUSY_Z1) THEN
          IF IsON(LIGHT_Z1_EN) THEN TurnON(LIGHT_Z1); ELSE TurnOFF(LIGHT_Z1); END_IF;
        END_IF;
