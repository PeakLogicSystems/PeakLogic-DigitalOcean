(*
  Dual ATU — 2 duplex alternators, each TPO-gated
  Tags: st/fixtures/tags.dual_atu.json
*)

(* ===== Unit 1: TPO1 + ALT1 ===== *)

IF IsON(TPO1_EN) AND IsOFF(TPO1_OFFLINE) THEN
  SetInt(TPO1_TOD, TPO1_TOD + TPO1_TOD_STEP);
  IF TPO1_TOD >= 1440 THEN SetInt(TPO1_TOD, TPO1_TOD - 1440); END_IF;
END_IF;
IF IsON(TPO1_OFFLINE) THEN
  TurnOFF(TPO1_OUT); TurnOFF(TPO1_GAP); SetInt(TPO1_PULSE_REM, 0); SetInt(TPO1_STA, 1);
ELSE
  IF IsOFF(TPO1_EN) THEN
    TurnOFF(TPO1_OUT); TurnOFF(TPO1_GAP); SetInt(TPO1_PULSE_REM, 0); SetInt(TPO1_STA, 0);
  ELSE
    IF IsON(TPO1_24HR) OR (TPO1_TOD >= TPO1_START AND TPO1_TOD < TPO1_END) THEN
      IF TPO1_PULSE_REM <= 0 THEN
        IF IsON(TPO1_OUT) THEN
          TurnOFF(TPO1_OUT); TurnON(TPO1_GAP); SetInt(TPO1_PULSE_REM, TPO1_OFF_MIN); SetInt(TPO1_STA, 3);
        ELSE
          TurnON(TPO1_OUT); TurnOFF(TPO1_GAP); SetInt(TPO1_PULSE_REM, TPO1_ON_MIN); SetInt(TPO1_STA, 2);
        END_IF;
      ELSE
        SetInt(TPO1_PULSE_REM, TPO1_PULSE_REM - TPO1_TOD_STEP);
        IF TPO1_PULSE_REM < 0 THEN SetInt(TPO1_PULSE_REM, 0); END_IF;
      END_IF;
    ELSE
      TurnOFF(TPO1_OUT); TurnOFF(TPO1_GAP); SetInt(TPO1_PULSE_REM, 0); SetInt(TPO1_STA, 4);
    END_IF;
  END_IF;
END_IF;

IF IsON(TPO1_OUT) THEN TurnON(SYS_RUN); ELSE TurnOFF(SYS_RUN); END_IF;
AltEnable(ALT1, SYS_RUN);
AltAutoFault(ALT1, SYS_RUN);
AltAdvance(ALT1, ALT_BUMP);
AltOff(ALT1, ALT_OFF);
AltHigh(ALT1, LVL_HIGH);
AltLow(ALT1, LVL_LAG);
AltOnline(ALT1, 1, MOTOR1_ONLINE);
AltOnline(ALT1, 2, MOTOR2_ONLINE);
AltUnitOut(ALT1, 1, MOTOR1_RUN);
AltUnitOut(ALT1, 2, MOTOR2_RUN);
AltLead(ALT1, LEAD_RUN);
IF AltFault(ALT1) THEN TurnON(ALT_FAULT); ELSE TurnOFF(ALT_FAULT); END_IF;
TurnOFF(ALT_BUMP);

(* ===== Unit 2: TPO2 + ALT2 ===== *)

IF IsON(TPO2_EN) AND IsOFF(TPO2_OFFLINE) THEN
  SetInt(TPO2_TOD, TPO2_TOD + TPO2_TOD_STEP);
  IF TPO2_TOD >= 1440 THEN SetInt(TPO2_TOD, TPO2_TOD - 1440); END_IF;
END_IF;
IF IsON(TPO2_OFFLINE) THEN
  TurnOFF(TPO2_OUT); TurnOFF(TPO2_GAP); SetInt(TPO2_PULSE_REM, 0); SetInt(TPO2_STA, 1);
ELSE
  IF IsOFF(TPO2_EN) THEN
    TurnOFF(TPO2_OUT); TurnOFF(TPO2_GAP); SetInt(TPO2_PULSE_REM, 0); SetInt(TPO2_STA, 0);
  ELSE
    IF IsON(TPO2_24HR) OR (TPO2_TOD >= TPO2_START AND TPO2_TOD < TPO2_END) THEN
      IF TPO2_PULSE_REM <= 0 THEN
        IF IsON(TPO2_OUT) THEN
          TurnOFF(TPO2_OUT); TurnON(TPO2_GAP); SetInt(TPO2_PULSE_REM, TPO2_OFF_MIN); SetInt(TPO2_STA, 3);
        ELSE
          TurnON(TPO2_OUT); TurnOFF(TPO2_GAP); SetInt(TPO2_PULSE_REM, TPO2_ON_MIN); SetInt(TPO2_STA, 2);
        END_IF;
      ELSE
        SetInt(TPO2_PULSE_REM, TPO2_PULSE_REM - TPO2_TOD_STEP);
        IF TPO2_PULSE_REM < 0 THEN SetInt(TPO2_PULSE_REM, 0); END_IF;
      END_IF;
    ELSE
      TurnOFF(TPO2_OUT); TurnOFF(TPO2_GAP); SetInt(TPO2_PULSE_REM, 0); SetInt(TPO2_STA, 4);
    END_IF;
  END_IF;
END_IF;

IF IsON(TPO2_OUT) THEN TurnON(SYS_RUN2); ELSE TurnOFF(SYS_RUN2); END_IF;
AltEnable(ALT2, SYS_RUN2);
AltAutoFault(ALT2, SYS_RUN2);
AltAdvance(ALT2, ALT_BUMP2);
AltOff(ALT2, ALT_OFF2);
AltHigh(ALT2, LVL_HIGH2);
AltLow(ALT2, LVL_LAG2);
AltOnline(ALT2, 1, MOTOR3_ONLINE);
AltOnline(ALT2, 2, MOTOR4_ONLINE);
AltUnitOut(ALT2, 1, MOTOR3_RUN);
AltUnitOut(ALT2, 2, MOTOR4_RUN);
AltLead(ALT2, LEAD_RUN2);
IF AltFault(ALT2) THEN TurnON(ALT_FAULT2); ELSE TurnOFF(ALT_FAULT2); END_IF;
TurnOFF(ALT_BUMP2);

