(* PeakLogic ATU Service cloud fleet rollup *)
(* Mirror FLEET_*_ALM from each device primary alarm after Drivers → Sync tags *)

IF FLEET_HARBOR_QATU_1_ALM OR FLEET_HARBOR_QATU_2_ALM OR FLEET_HARBOR_QATU_3_ALM OR FLEET_HARBOR_QATU_4_ALM OR FLEET_HARBOR_LS_1_ALM OR FLEET_HARBOR_LS_2_ALM OR FLEET_HARBOR_LS_3_ALM OR FLEET_HARBOR_LS_4_ALM OR FLEET_HARBOR_LS_5_ALM OR FLEET_HARBOR_LS_6_ALM OR FLEET_HARBOR_LS_7_ALM OR FLEET_HARBOR_LS_8_ALM OR FLEET_HARBOR_LS_9_ALM OR FLEET_HARBOR_LS_10_ALM OR FLEET_HARBOR_LS_11_ALM OR FLEET_HARBOR_LS_12_ALM OR FLEET_HARBOR_LS_13_ALM OR FLEET_HARBOR_LS_14_ALM OR FLEET_HARBOR_LS_15_ALM OR FLEET_HARBOR_LS_16_ALM OR FLEET_HARBOR_LS_17_ALM OR FLEET_HARBOR_LS_18_ALM OR FLEET_HARBOR_LS_19_ALM OR FLEET_HARBOR_LS_20_ALM THEN TurnON(FLEET_ANY_ALM); ELSE TurnOFF(FLEET_ANY_ALM); END_IF;
IF FLEET_HARBOR_QATU_1_ALM OR FLEET_HARBOR_QATU_2_ALM OR FLEET_HARBOR_QATU_3_ALM OR FLEET_HARBOR_QATU_4_ALM THEN TurnON(FLEET_ATU_ALM); ELSE TurnOFF(FLEET_ATU_ALM); END_IF;
IF FLEET_HARBOR_LS_1_ALM OR FLEET_HARBOR_LS_2_ALM OR FLEET_HARBOR_LS_3_ALM OR FLEET_HARBOR_LS_4_ALM OR FLEET_HARBOR_LS_5_ALM OR FLEET_HARBOR_LS_6_ALM OR FLEET_HARBOR_LS_7_ALM OR FLEET_HARBOR_LS_8_ALM OR FLEET_HARBOR_LS_9_ALM OR FLEET_HARBOR_LS_10_ALM OR FLEET_HARBOR_LS_11_ALM OR FLEET_HARBOR_LS_12_ALM OR FLEET_HARBOR_LS_13_ALM OR FLEET_HARBOR_LS_14_ALM OR FLEET_HARBOR_LS_15_ALM OR FLEET_HARBOR_LS_16_ALM OR FLEET_HARBOR_LS_17_ALM OR FLEET_HARBOR_LS_18_ALM OR FLEET_HARBOR_LS_19_ALM OR FLEET_HARBOR_LS_20_ALM THEN TurnON(FLEET_LIFT_ALM); ELSE TurnOFF(FLEET_LIFT_ALM); END_IF;
IF FLEET_ANY_ALM THEN TurnON(SITE_ALM); ELSE TurnOFF(SITE_ALM); END_IF;
