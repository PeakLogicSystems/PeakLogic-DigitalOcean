(* PeakLogic ATU Service cloud fleet rollup *)
(* Mirror FLEET_*_ALM from each device primary alarm after Drivers → Sync tags *)

IF FLEET_MAGNOLIA_LS_1_ALM OR FLEET_MAGNOLIA_LS_2_ALM OR FLEET_MAGNOLIA_LS_3_ALM OR FLEET_MAGNOLIA_LS_4_ALM OR FLEET_MAGNOLIA_LS_5_ALM OR FLEET_MAGNOLIA_LS_6_ALM OR FLEET_MAGNOLIA_LS_7_ALM OR FLEET_MAGNOLIA_LS_8_ALM OR FLEET_MAGNOLIA_LS_9_ALM OR FLEET_MAGNOLIA_LS_10_ALM OR FLEET_MAGNOLIA_LS_11_ALM OR FLEET_MAGNOLIA_LS_12_ALM OR FLEET_MAGNOLIA_LS_13_ALM OR FLEET_MAGNOLIA_LS_14_ALM OR FLEET_MAGNOLIA_LS_15_ALM OR FLEET_MAGNOLIA_LS_16_ALM OR FLEET_MAGNOLIA_LS_17_ALM OR FLEET_MAGNOLIA_LS_18_ALM OR FLEET_MAGNOLIA_LS_19_ALM OR FLEET_MAGNOLIA_LS_20_ALM OR FLEET_MAGNOLIA_BS_1_ALM OR FLEET_MAGNOLIA_BS_2_ALM OR FLEET_MAGNOLIA_DWTU_1_ALM OR FLEET_MAGNOLIA_DWTU_2_ALM THEN TurnON(FLEET_ANY_ALM); ELSE TurnOFF(FLEET_ANY_ALM); END_IF;
IF FLEET_MAGNOLIA_DWTU_1_ALM OR FLEET_MAGNOLIA_DWTU_2_ALM THEN TurnON(FLEET_ATU_ALM); ELSE TurnOFF(FLEET_ATU_ALM); END_IF;
IF FLEET_MAGNOLIA_LS_1_ALM OR FLEET_MAGNOLIA_LS_2_ALM OR FLEET_MAGNOLIA_LS_3_ALM OR FLEET_MAGNOLIA_LS_4_ALM OR FLEET_MAGNOLIA_LS_5_ALM OR FLEET_MAGNOLIA_LS_6_ALM OR FLEET_MAGNOLIA_LS_7_ALM OR FLEET_MAGNOLIA_LS_8_ALM OR FLEET_MAGNOLIA_LS_9_ALM OR FLEET_MAGNOLIA_LS_10_ALM OR FLEET_MAGNOLIA_LS_11_ALM OR FLEET_MAGNOLIA_LS_12_ALM OR FLEET_MAGNOLIA_LS_13_ALM OR FLEET_MAGNOLIA_LS_14_ALM OR FLEET_MAGNOLIA_LS_15_ALM OR FLEET_MAGNOLIA_LS_16_ALM OR FLEET_MAGNOLIA_LS_17_ALM OR FLEET_MAGNOLIA_LS_18_ALM OR FLEET_MAGNOLIA_LS_19_ALM OR FLEET_MAGNOLIA_LS_20_ALM OR FLEET_MAGNOLIA_BS_1_ALM OR FLEET_MAGNOLIA_BS_2_ALM THEN TurnON(FLEET_LIFT_ALM); ELSE TurnOFF(FLEET_LIFT_ALM); END_IF;
IF FLEET_ANY_ALM THEN TurnON(SITE_ALM); ELSE TurnOFF(SITE_ALM); END_IF;
