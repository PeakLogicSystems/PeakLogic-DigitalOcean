(* facility-hvac-iot-link — dual AHU + dual condenser on one Opta + EZ Meter PQ *)

(* —— Dual air handlers — I1–I4 fan CT, I5–I8 NTC, X1_IRAW1–2 leak analog —— *)
IF AHU1_FAN_AMPS > H_CT_AMPS THEN TurnON(AHU1_FAN_FLT); ELSE TurnOFF(AHU1_FAN_FLT); END_IF;
IF AHU1_START_AMPS > H_CT_AMPS THEN TurnON(AHU1_START_FLT); ELSE TurnOFF(AHU1_START_FLT); END_IF;
IF AHU2_FAN_AMPS > H_CT_AMPS THEN TurnON(AHU2_FAN_FLT); ELSE TurnOFF(AHU2_FAN_FLT); END_IF;
IF AHU2_START_AMPS > H_CT_AMPS THEN TurnON(AHU2_START_FLT); ELSE TurnOFF(AHU2_START_FLT); END_IF;

IF IsON(AHU1_PAN_LEAK) OR IsON(AHU1_FAN_FLT) OR IsON(AHU1_START_FLT)
   OR (AHU1_SUPPLY_TEMP_F > H_SUPPLY_HI_F) THEN
  TurnON(AHU1_FAIL_ALM);
ELSE
  TurnOFF(AHU1_FAIL_ALM);
END_IF;

IF IsON(AHU2_PAN_LEAK) OR IsON(AHU2_FAN_FLT) OR IsON(AHU2_START_FLT)
   OR (AHU2_SUPPLY_TEMP_F > H_SUPPLY_HI_F) THEN
  TurnON(AHU2_FAIL_ALM);
ELSE
  TurnOFF(AHU2_FAIL_ALM);
END_IF;

(* —— Dual condenser — one Opta + D1608E: fan/comp I1–I8, D1608E NTC —— *)
IF IsON(COND1_FAN_FLT) OR IsON(COND1_COMP_FLT)
   OR (COND1_HI_TEMP_F > H_COND_HI_F) OR (COND1_LO_TEMP_F < H_COND_LO_F) THEN
  TurnON(COND1_FAIL_ALM);
ELSE
  TurnOFF(COND1_FAIL_ALM);
END_IF;

IF IsON(COND2_FAN_FLT) OR IsON(COND2_COMP_FLT)
   OR (COND2_HI_TEMP_F > H_COND_HI_F) OR (COND2_LO_TEMP_F < H_COND_LO_F) THEN
  TurnON(COND2_FAIL_ALM);
ELSE
  TurnOFF(COND2_FAIL_ALM);
END_IF;

IF IsON(AHU1_FAIL_ALM) OR IsON(AHU2_FAIL_ALM) OR IsON(COND1_FAIL_ALM) OR IsON(COND2_FAIL_ALM) THEN
  TurnON(SITE_ALM);
ELSE
  TurnOFF(SITE_ALM);
END_IF;

(* —— EZ Meter facility PQ (host Modbus) —— *)
MECH_PQ_KW_SUM := (DDS_W_A + DDS_W_B + DDS_W_C) / 1000.0;
MECH_PQ_KVA_SUM := (DDS_VA_A + DDS_VA_B + DDS_VA_C) / 1000.0;
IF MECH_PQ_KVA_SUM > 0.01 THEN
  MECH_PQ_PF_SYS := MECH_PQ_KW_SUM / MECH_PQ_KVA_SUM;
ELSE
  MECH_PQ_PF_SYS := 1.0;
END_IF;
MECH_PQ_V_AVG := (DDS_V_A + DDS_V_B + DDS_V_C) / 3.0;
MECH_PQ_I_SUM := DDS_I_A + DDS_I_B + DDS_I_C;

IF MECH_METER_KWH >= DDS_METER_KWH_PREV THEN
  MECH_METER_INTERVAL_KWH := MECH_METER_KWH - DDS_METER_KWH_PREV;
ELSE
  MECH_METER_INTERVAL_KWH := 0.0;
END_IF;
DDS_METER_KWH_PREV := MECH_METER_KWH;

IF MECH_PQ_V_AVG > 1.0 THEN
  IF DDS_V_A >= DDS_V_B AND DDS_V_A >= DDS_V_C THEN
    IF DDS_V_B >= DDS_V_C THEN
      MECH_PQ_V_IMBAL_PCT := (DDS_V_A - DDS_V_C) / MECH_PQ_V_AVG * 100.0;
    ELSE
      MECH_PQ_V_IMBAL_PCT := (DDS_V_A - DDS_V_B) / MECH_PQ_V_AVG * 100.0;
    END_IF;
  ELSIF DDS_V_B >= DDS_V_A AND DDS_V_B >= DDS_V_C THEN
    IF DDS_V_A >= DDS_V_C THEN
      MECH_PQ_V_IMBAL_PCT := (DDS_V_B - DDS_V_C) / MECH_PQ_V_AVG * 100.0;
    ELSE
      MECH_PQ_V_IMBAL_PCT := (DDS_V_B - DDS_V_A) / MECH_PQ_V_AVG * 100.0;
    END_IF;
  ELSE
    IF DDS_V_A >= DDS_V_B THEN
      MECH_PQ_V_IMBAL_PCT := (DDS_V_C - DDS_V_B) / MECH_PQ_V_AVG * 100.0;
    ELSE
      MECH_PQ_V_IMBAL_PCT := (DDS_V_C - DDS_V_A) / MECH_PQ_V_AVG * 100.0;
    END_IF;
  END_IF;
ELSE
  MECH_PQ_V_IMBAL_PCT := 0.0;
END_IF;

IF DDS_V_A < MECH_PQ_CFG_UV_V OR DDS_V_B < MECH_PQ_CFG_UV_V OR DDS_V_C < MECH_PQ_CFG_UV_V THEN
  TurnON(MECH_PQ_UNDERVOLT);
ELSE
  TurnOFF(MECH_PQ_UNDERVOLT);
END_IF;

IF DDS_V_A > MECH_PQ_CFG_OV_V OR DDS_V_B > MECH_PQ_CFG_OV_V OR DDS_V_C > MECH_PQ_CFG_OV_V THEN
  TurnON(MECH_PQ_OVERVOLT);
ELSE
  TurnOFF(MECH_PQ_OVERVOLT);
END_IF;

IF (DDS_V_A < 10.0 AND (DDS_V_B > 50.0 OR DDS_V_C > 50.0))
  OR (DDS_V_B < 10.0 AND (DDS_V_A > 50.0 OR DDS_V_C > 50.0))
  OR (DDS_V_C < 10.0 AND (DDS_V_A > 50.0 OR DDS_V_B > 50.0)) THEN
  TurnON(MECH_PQ_PHASE_LOSS);
ELSE
  TurnOFF(MECH_PQ_PHASE_LOSS);
END_IF;

IF MECH_PQ_V_IMBAL_PCT > MECH_PQ_CFG_IMBAL_PCT THEN
  TurnON(MECH_PQ_V_IMBAL);
ELSE
  TurnOFF(MECH_PQ_V_IMBAL);
END_IF;

IF MECH_PQ_I_SUM > MECH_PQ_CFG_LOAD_I AND MECH_PQ_PF_SYS < MECH_PQ_CFG_LOW_PF THEN
  TurnON(MECH_PQ_LOW_PF);
ELSE
  TurnOFF(MECH_PQ_LOW_PF);
END_IF;

IF DDS_HZ_A < MECH_PQ_CFG_FREQ_MIN OR DDS_HZ_A > MECH_PQ_CFG_FREQ_MAX THEN
  TurnON(MECH_PQ_FREQ_FAULT);
ELSE
  TurnOFF(MECH_PQ_FREQ_FAULT);
END_IF;

IF MECH_PQ_UNDERVOLT OR MECH_PQ_OVERVOLT OR MECH_PQ_PHASE_LOSS OR MECH_PQ_V_IMBAL OR MECH_PQ_LOW_PF OR MECH_PQ_FREQ_FAULT THEN
  TurnON(MECH_PQ_ALM);
ELSE
  TurnOFF(MECH_PQ_ALM);
END_IF;

IF MECH_PQ_ALM THEN TurnON(FACILITY_ALM); END_IF;
IF IsON(SITE_ALM) THEN TurnON(FACILITY_ALM); END_IF;
