(* hvac-rtu-opta — rooftop unit on Opta + D1608E *)

IF RTU_BLOWER_AMPS > H_CT_AMPS THEN TurnON(RTU_BLOWER_FLT); ELSE TurnOFF(RTU_BLOWER_FLT); END_IF;
IF RTU_BLOWER_START_AMPS > H_CT_AMPS THEN TurnON(RTU_BLOWER_START_FLT); ELSE TurnOFF(RTU_BLOWER_START_FLT); END_IF;

IF IsON(RTU_BLOWER_FLT) OR IsON(RTU_BLOWER_START_FLT)
   OR IsON(RTU_FAN_FLT) OR IsON(RTU_COMP_FLT)
   OR IsON(RTU_PAN_LEAK)
   OR (RTU_SUPPLY_TEMP_F > H_SUPPLY_HI_F)
   OR (RTU_HI_TEMP_F > H_COND_HI_F) OR (RTU_LO_TEMP_F < H_COND_LO_F) THEN
  TurnON(RTU_FAIL_ALM);
ELSE
  TurnOFF(RTU_FAIL_ALM);
END_IF;

IF IsON(RTU_FAIL_ALM) THEN TurnON(SITE_ALM); ELSE TurnOFF(SITE_ALM); END_IF;
