(* MLE plant — 2× separate 125K gal integrated circular MLE tanks *)

(* Tank 1 — integrated MLE *)
IF T1_LVL > 95.0 THEN TurnON(T1_HI); ELSE TurnOFF(T1_HI); END_IF;
IF T1_LVL < 10.0 THEN TurnON(T1_LO); ELSE TurnOFF(T1_LO); END_IF;
IF NOT T1_BLOW1_RUN AND NOT T1_BLOW2_RUN THEN TurnON(T1_BLOW_ALM); ELSE TurnOFF(T1_BLOW_ALM); END_IF;
IF T1_BLOW_ALM OR T1_AER_DO < 1.5 OR T1_ANOX_DO > 1.0 OR T1_ANOX_ORP > -50.0 THEN TurnON(T1_AER_ALM); ELSE TurnOFF(T1_AER_ALM); END_IF;
IF T1_HI OR T1_LO OR T1_PH < 6.0 OR T1_PH > 9.0 OR T1_AER_ALM OR T1_IR_FLOW < 40.0 THEN TurnON(T1_ALM); ELSE TurnOFF(T1_ALM); END_IF;

(* Tank 2 — integrated MLE *)
IF T2_LVL > 95.0 THEN TurnON(T2_HI); ELSE TurnOFF(T2_HI); END_IF;
IF T2_LVL < 10.0 THEN TurnON(T2_LO); ELSE TurnOFF(T2_LO); END_IF;
IF NOT T2_BLOW1_RUN AND NOT T2_BLOW2_RUN THEN TurnON(T2_BLOW_ALM); ELSE TurnOFF(T2_BLOW_ALM); END_IF;
IF T2_BLOW_ALM OR T2_AER_DO < 1.5 OR T2_ANOX_DO > 1.0 OR T2_ANOX_ORP > -50.0 THEN TurnON(T2_AER_ALM); ELSE TurnOFF(T2_AER_ALM); END_IF;
IF T2_HI OR T2_LO OR T2_PH < 6.0 OR T2_PH > 9.0 OR T2_AER_ALM OR T2_IR_FLOW < 40.0 THEN TurnON(T2_ALM); ELSE TurnOFF(T2_ALM); END_IF;

(* Plant summary *)
IF T1_ALM OR T2_ALM OR CTRL_ALM THEN TurnON(PLANT_ALM); ELSE TurnOFF(PLANT_ALM); END_IF;
