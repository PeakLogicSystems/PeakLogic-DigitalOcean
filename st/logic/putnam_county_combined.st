ELSIF YELV_LVL_LAG2 THEN SetReal(YELV_TANK_LVL, 78.0);
ELSIF YELV_X1_I3 THEN SetReal(YELV_TANK_LVL, 68.0);
ELSIF YELV_X1_I2 THEN SetReal(YELV_TANK_LVL, 45.0);
ELSIF NOT YELV_X1_I4 THEN SetReal(YELV_TANK_LVL, 12.0);
END_IF;
