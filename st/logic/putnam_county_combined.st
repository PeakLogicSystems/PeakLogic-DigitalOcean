IF YELV_X1_I7 THEN TurnON(YELV_PHASE_FAULT); ELSE TurnOFF(YELV_PHASE_FAULT); END_IF;
IF YELV_TPX_ALM THEN TurnON(FLEET_YELV_ALM); ELSE TurnOFF(FLEET_YELV_ALM); END_IF;
IF YELV_TPX_ALM THEN SetInt(YELV_STATION_STA, 1);
ELSIF YELV_X1_I1 THEN SetInt(YELV_STATION_STA, 2);
ELSE SetInt(YELV_STATION_STA, 0); END_IF;

