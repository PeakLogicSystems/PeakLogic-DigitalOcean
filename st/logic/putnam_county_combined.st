(* MLE plant — 2× separate 125K gal integrated circular MLE tanks *)
(* Shared blower farm: 3× centrifugal (aerobic) + 3× PD (anoxic) *)

(* Shared blower alarms *)
IF NOT AER_CEN_BLOW1_RUN AND NOT AER_CEN_BLOW2_RUN AND NOT AER_CEN_BLOW3_RUN THEN TurnON(AER_BLOW_ALM); ELSE TurnOFF(AER_BLOW_ALM); END_IF;
IF NOT ANOX_PD_BLOW1_RUN AND NOT ANOX_PD_BLOW2_RUN AND NOT ANOX_PD_BLOW3_RUN THEN TurnON(ANOX_BLOW_ALM); ELSE TurnOFF(ANOX_BLOW_ALM); END_IF;

(* Tank 1 — integrated MLE *)
IF T1_LVL > 95.0 THEN TurnON(T1_HI); ELSE TurnOFF(T1_HI); END_IF;
IF T1_LVL < 10.0 THEN TurnON(T1_LO); ELSE TurnOFF(T1_LO); END_IF;
IF T1_LVL > 15.0 AND NOT T1_SCRAPER_RUN THEN TurnON(T1_SCRAPER_ALM); ELSE TurnOFF(T1_SCRAPER_ALM); END_IF;
IF T1_LVL > 20.0 AND NOT T1_WAS_PUMP1_RUN AND NOT T1_WAS_PUMP2_RUN THEN TurnON(T1_WAS_PUMP_ALM); ELSE TurnOFF(T1_WAS_PUMP_ALM); END_IF;
IF T1_HI OR T1_LO OR T1_PH < 6.0 OR T1_PH > 9.0 OR AER_BLOW_ALM OR ANOX_BLOW_ALM OR T1_AER_DO < 1.5 OR T1_ANOX_DO > 1.0 OR T1_ANOX_ORP > -50.0 OR T1_IR_FLOW < 40.0 OR T1_SCRAPER_ALM OR T1_WAS_PUMP_ALM THEN TurnON(T1_ALM); ELSE TurnOFF(T1_ALM); END_IF;

(* Tank 2 — integrated MLE *)
IF T2_LVL > 95.0 THEN TurnON(T2_HI); ELSE TurnOFF(T2_HI); END_IF;
IF T2_LVL < 10.0 THEN TurnON(T2_LO); ELSE TurnOFF(T2_LO); END_IF;
IF T2_LVL > 15.0 AND NOT T2_SCRAPER_RUN THEN TurnON(T2_SCRAPER_ALM); ELSE TurnOFF(T2_SCRAPER_ALM); END_IF;
IF T2_LVL > 20.0 AND NOT T2_WAS_PUMP1_RUN AND NOT T2_WAS_PUMP2_RUN THEN TurnON(T2_WAS_PUMP_ALM); ELSE TurnOFF(T2_WAS_PUMP_ALM); END_IF;
IF T2_HI OR T2_LO OR T2_PH < 6.0 OR T2_PH > 9.0 OR AER_BLOW_ALM OR ANOX_BLOW_ALM OR T2_AER_DO < 1.5 OR T2_ANOX_DO > 1.0 OR T2_ANOX_ORP > -50.0 OR T2_IR_FLOW < 40.0 OR T2_SCRAPER_ALM OR T2_WAS_PUMP_ALM THEN TurnON(T2_ALM); ELSE TurnOFF(T2_ALM); END_IF;

(* Plant summary *)
IF T1_ALM OR T2_ALM OR CTRL_ALM OR AER_BLOW_ALM OR ANOX_BLOW_ALM THEN TurnON(PLANT_ALM); ELSE TurnOFF(PLANT_ALM); END_IF;

(* Control building — electrical *)
IF GEN_FUEL_LOW OR GEN_FAULT THEN TurnON(CTRL_ALM); ELSE TurnOFF(CTRL_ALM); END_IF;

(* --- Putnam lift fleet rollup --- *)
(* Putnam County cloud fleet rollup *)

