(* Default VPB memory mirrors Waveshare DI1–DI8 and Q1–Q8 *)
IF IsON(DI1) THEN TurnON(VPB1); ELSE TurnOFF(VPB1); END_IF;
IF IsON(VPB1) THEN TurnON(Q1); ELSE TurnOFF(Q1); END_IF;
IF IsON(VPB1) THEN TurnON(VPB11); ELSE TurnOFF(VPB11); END_IF;
(* Mirror DI1 -> VPB1 / VPB11, drive Q1 *)
IF IsON(DI1) THEN TurnON(VPB1); ELSE TurnOFF(VPB1); END_IF;
IF IsON(VPB1) THEN TurnON(Q1); ELSE TurnOFF(Q1); END_IF;
IF IsON(VPB1) THEN TurnON(VPB11); ELSE TurnOFF(VPB11); END_IF;
