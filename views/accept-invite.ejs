<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PeakLogic — <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/peaklogic.css">
</head>
<body class="bg-light">
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card shadow border-0" style="border-radius: 1rem;">
        <div class="card-body p-5">
          <h3 class="fw-bold text-secondary mb-2">Accept invite</h3>
          <% if (invalid) { %>
            <p class="text-muted small mb-4"><%= error %></p>
            <p class="text-center small mb-0"><a href="/login">Back to sign in</a></p>
          <% } else { %>
            <p class="text-muted small mb-4">
              Join <strong><%= tenantName %></strong> as <strong><%= email %></strong>.
              Organization slug: <code><%= tenantSlug %></code>
            </p>
            <% if (error) { %>
              <div class="alert alert-danger py-2 small"><%= error %></div>
            <% } %>
            <form action="/accept-invite" method="POST">
              <input type="hidden" name="token" value="<%= token %>">
              <div class="form-floating mb-3">
                <input type="password" name="password" class="form-control" id="password"
                       minlength="8" required autofocus>
                <label for="password">Choose a password</label>
              </div>
              <div class="form-floating mb-4">
                <input type="password" name="passwordConfirm" class="form-control" id="passwordConfirm"
                       minlength="8" required>
                <label for="passwordConfirm">Confirm password</label>
              </div>
              <div class="d-grid mb-3">
                <button type="submit" class="btn btn-purple btn-lg">Create account</button>
              </div>
            </form>
            <p class="text-center small mb-0"><a href="/login">Back to sign in</a></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<% if (!invalid) { %>
<script>
  document.querySelector('form')?.addEventListener('submit', (e) => {
    const a = document.getElementById('password').value;
    const b = document.getElementById('passwordConfirm').value;
    if (a !== b) {
      e.preventDefault();
      alert('Passwords do not match.');
    }
  });
</script>
<% } %>
</body>
</html>
