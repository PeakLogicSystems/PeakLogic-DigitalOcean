<%
  const staffLabel = typeof staffUser !== 'undefined' && staffUser ? staffUser : 'Platform Admin';
  const staffInitial = String(staffLabel).trim()[0]?.toUpperCase() || '?';
%>
<nav class="navbar navbar-expand-lg navbar-dark nav-peaklogic px-3 mb-4">
  <a href="/admin/tenants" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none mb-0">
    <img src="/branding/peaklogic-icon.svg" alt="" class="brand-logo-icon">
    <span class="brand-logotype"><span class="brand-logotype-peak">Peak</span><span class="brand-logotype-logic">Logic</span></span>
    <span class="text-white-50 small ms-1">Platform</span>
  </a>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
    <span class="navbar-toggler-icon"></span>
  </button>
  <div class="collapse navbar-collapse" id="adminNav">
    <ul class="navbar-nav me-auto">
      <li class="nav-item">
        <a class="nav-link <%= activeNav === 'tenants' ? 'active' : '' %>" href="/admin/tenants"><i class="bi bi-building"></i> Tenants</a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= activeNav === 'new' ? 'active' : '' %>" href="/admin/tenants/new"><i class="bi bi-building-add"></i> Create tenant</a>
      </li>
    </ul>
    <div class="dropdown">
      <button class="btn d-flex align-items-center gap-2 text-white user-menu-btn" type="button" data-bs-toggle="dropdown">
        <span class="user-avatar"><%= staffInitial %></span>
        <span class="d-none d-md-inline small"><%= staffLabel %></span>
        <i class="bi bi-chevron-down small"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><a class="dropdown-item" href="/"><i class="bi bi-arrow-left-right me-1"></i> Tenant app</a></li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item" href="/admin/logout"><i class="bi bi-box-arrow-right me-1"></i> Log out</a></li>
      </ul>
    </div>
  </div>
</nav>
