<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof productLabel !== 'undefined' ? productLabel : 'PeakLogic' %> Platform — <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/peaklogic.css">
</head>
<body class="bg-light">

<div class="container-fluid vh-100 p-0 overflow-hidden">
  <div class="row h-100 g-0">
    <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-center position-relative splash-gradient text-white p-5">
      <div class="position-relative z-1">
        <h1 class="display-5 fw-bold brand-mark"><%= typeof productLabel !== 'undefined' ? productLabel : 'PeakLogic' %></h1>
        <p class="lead opacity-75">Platform superuser console — manage tenants, CMMS entitlements, and organization onboarding.</p>
      </div>
    </div>
    <div class="col-lg-6 d-flex align-items-center justify-content-center p-4">
      <div class="card shadow border-0 w-100" style="max-width: 420px; border-radius: 1rem;">
        <div class="card-body p-4 p-md-5">
          <h2 class="h4 fw-bold mb-1">Platform admin</h2>
          <p class="text-muted small mb-4">Enter the platform admin key from server environment.</p>
          <% if (error) { %>
            <div class="alert alert-danger py-2 small"><%= error %></div>
          <% } %>
          <form method="POST" action="/admin/login">
            <div class="form-floating mb-4">
              <input type="password" name="platformAdminKey" class="form-control" id="platformAdminKey"
                     placeholder="Platform admin key" required autofocus autocomplete="off">
              <label for="platformAdminKey">Platform admin key</label>
            </div>
            <div class="d-grid mb-3">
              <button type="submit" class="btn btn-purple btn-lg transition-btn">Sign in</button>
            </div>
          </form>
          <p class="text-center small text-muted mb-0">
            <a href="/login">Tenant login</a> · <a href="/">Home</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

</body>
</html>
