<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="utf-8">

  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>PeakLogic Platform — <%= title %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link rel="stylesheet" href="/css/peaklogic.css">

</head>

<body class="bg-light">



<%- include('_nav') %>

<%
  var pageCreated = locals.created === true;
  var pageProfileUpdated = locals.profileUpdated === true;
  var pageSettingsUpdated = locals.settingsUpdated === true;
  var pageError = locals.error || null;
%>

<main class="container pb-5">

  <div class="mb-3">

    <a href="/admin/tenants" class="text-decoration-none small">&larr; All tenants</a>

  </div>



  <% if (pageCreated) { %>
    <div class="alert alert-success">
      Tenant created successfully.
      <div class="small mt-2 mb-0">
        Tenant sign-in: <a href="/login?tenantSlug=<%= encodeURIComponent(tenant.slug) %>">/login</a>
        · slug <code><%= tenant.slug %></code>
        · use the admin email and password you set when creating this tenant.
      </div>
      <% if (locals.stationProvisioned) { %>
        <div class="small mt-2 mb-0">First lift station provisioned — it appears on the customer's <strong>Assets</strong> map.</div>
      <% } %>
    </div>
  <% } %>
  <% if (pageProfileUpdated) { %>
    <div class="alert alert-success">Organization name and slug updated.</div>
  <% } %>
  <% if (pageSettingsUpdated) { %>
    <div class="alert alert-success">Tenant settings saved.</div>
  <% } %>
  <% if (pageError) { %>
    <div class="alert alert-danger"><%= pageError %></div>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card dashboard-card mb-4">
        <div class="card-header bg-white fw-semibold">Organization</div>
        <div class="card-body">
          <form method="POST" action="/admin/tenants/<%= tenant.id %>/profile" class="row g-3">
            <div class="col-md-6">
              <label class="form-label small" for="tenantName">Display name</label>
              <input type="text" class="form-control form-control-sm" id="tenantName" name="tenantName"
                     value="<%= tenant.name %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small" for="tenantSlug">Login slug</label>
              <input type="text" class="form-control form-control-sm" id="tenantSlug" name="tenantSlug"
                     value="<%= tenant.slug %>" required>
              <div class="form-text">Users enter this slug at sign-in. Changing it updates the login URL.</div>
            </div>
            <div class="col-12">
              <button type="submit" class="btn btn-purple btn-sm">Save organization</button>
            </div>
          </form>
        </div>
      </div>

      <div class="card dashboard-card mb-4">
        <div class="card-header bg-white fw-semibold"><%= tenant.name %></div>

        <div class="card-body">

          <dl class="row mb-0 small">

            <dt class="col-sm-3">Slug</dt><dd class="col-sm-9"><code><%= tenant.slug %></code></dd>

            <dt class="col-sm-3">ID</dt><dd class="col-sm-9"><code><%= tenant.id %></code></dd>

            <dt class="col-sm-3">Users</dt><dd class="col-sm-9"><%= userCount %></dd>

            <dt class="col-sm-3">Created</dt><dd class="col-sm-9"><%= new Date(tenant.createdAt).toLocaleString() %></dd>

          </dl>

        </div>

      </div>



      <div class="card dashboard-card">

        <div class="card-header bg-white fw-semibold">Users</div>

        <ul class="list-group list-group-flush">

          <% users.forEach(function(u) { %>

            <li class="list-group-item d-flex justify-content-between small">

              <span><%= u.email %> <span class="badge bg-light text-dark border"><%= u.role %></span></span>

              <span class="text-muted"><%= u.active ? 'active' : 'inactive' %></span>

            </li>

          <% }); %>

        </ul>

      </div>

    </div>



    <div class="col-lg-5">

      <div class="card dashboard-card">

        <div class="card-header bg-white fw-semibold">Plans &amp; entitlements</div>

        <div class="card-body">

          <p class="small text-muted mb-3">

            CMMS:

            <% if (tenant.cmmsEnabled) { %>

              <span class="badge bg-success">enabled</span> plan <strong><%= tenant.cmms.plan %></strong>

            <% } else { %>

              <span class="badge bg-secondary">disabled</span>

            <% } %>

            · PeakLogic tier: <strong><%= tenant.plan %></strong>

          </p>

          <form method="POST" action="/admin/tenants/<%= tenant.id %>/cmms" id="tenantSettingsForm">

            <div class="mb-3">

              <label class="form-label small fw-semibold" for="peaklogicPlan">PeakLogic tier</label>

              <select name="peaklogicPlan" id="peaklogicPlan" class="form-select form-select-sm">

                <% tenantPlans.forEach(function(p) { %>

                  <option value="<%= p %>" <%= tenant.plan === p ? 'selected' : '' %>><%= p %></option>

                <% }); %>

              </select>

              <div class="form-text">Subscription tier for this organization (limits &amp; billing).</div>

            </div>

            <hr class="my-3">

            <div class="form-check mb-3">

              <input class="form-check-input" type="checkbox" name="enabled" id="cmmsEnabled" value="true"

                     <%= tenant.cmmsEnabled ? 'checked' : '' %>>

              <label class="form-check-label" for="cmmsEnabled">CMMS module enabled</label>

            </div>

            <div class="mb-3">

              <label class="form-label small fw-semibold" for="cmmsPlan">CMMS plan</label>

              <select name="cmmsPlan" id="cmmsPlan" class="form-select form-select-sm"

                      <%= tenant.cmmsEnabled ? '' : 'disabled' %>>

                <% cmmsPlans.forEach(function(p) { %>

                  <option value="<%= p %>" <%= tenant.cmms.plan === p ? 'selected' : '' %>><%= p %></option>

                <% }); %>

              </select>

              <div class="form-text">Applies only when CMMS is enabled. Click <strong>Save settings</strong> after changes.</div>

            </div>

            <button type="submit" class="btn btn-purple btn-sm">Save settings</button>

          </form>

        </div>

      </div>

      <div class="card dashboard-card border-danger">
        <div class="card-header bg-white fw-semibold text-danger">Delete tenant</div>
        <div class="card-body">
          <p class="small text-muted mb-3">
            Permanently removes this organization, all users, sites, devices, projects, and telemetry.
            This cannot be undone.
          </p>
          <form method="POST" action="/admin/tenants/<%= tenant.id %>/delete"
                onsubmit="return confirm('Delete tenant <%= tenant.slug %> and ALL its data?');">
            <label class="form-label small" for="confirmSlug">Type <code><%= tenant.slug %></code> to confirm</label>
            <div class="input-group input-group-sm mb-2" style="max-width:320px">
              <input type="text" class="form-control" id="confirmSlug" name="confirmSlug" required
                     placeholder="<%= tenant.slug %>" autocomplete="off">
              <button type="submit" class="btn btn-outline-danger">Delete</button>
            </div>
          </form>
        </div>
      </div>

    </div>

  </div>

</main>



<script>
  (function () {
    const form = document.getElementById('tenantSettingsForm');
    const enabled = document.getElementById('cmmsEnabled');
    const cmmsPlan = document.getElementById('cmmsPlan');
    if (!form || !enabled || !cmmsPlan) return;
    function syncCmmsPlan() {
      cmmsPlan.disabled = !enabled.checked;
    }
    enabled.addEventListener('change', syncCmmsPlan);
    form.addEventListener('submit', function () {
      cmmsPlan.disabled = false;
    });
    syncCmmsPlan();
  })();
</script>

</body>

</html>

