<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PeakLogic Control Center — <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" href="/branding/peaklogic-icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/peaklogic.css">
</head>
<body class="bg-light">
<div class="top-accent-bar"></div>

<%- include('_nav') %>

<%
  var pageCreated = locals.created === true;
  var pageSettingsUpdated = locals.settingsUpdated === true;
  var pageError = locals.error || null;
%>

<main class="container pb-5">
  <div class="mb-3">
    <a href="/admin/tenants" class="text-decoration-none small">&larr; All tenants</a>
  </div>

  <% if (pageCreated) { %>
    <div class="alert alert-success">
      Tenant created successfully.
      <div class="small mt-2 mb-0">
        Tenant sign-in: <a href="/login?tenantSlug=<%= encodeURIComponent(tenant.tenantSlug) %>">/login</a>
        · slug <code><%= tenant.tenantSlug %></code>
        · use the admin email and password you set when creating this tenant.
      </div>
    </div>
  <% } %>
  <% if (pageSettingsUpdated) { %>
    <div class="alert alert-success">Tenant settings saved.</div>
  <% } %>
  <% if (pageError) { %>
    <div class="alert alert-danger"><%= pageError %></div>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card dashboard-card mb-4">
        <div class="card-header bg-white fw-semibold"><%= tenant.name %></div>
        <div class="card-body">
          <dl class="row mb-0 small">
            <dt class="col-sm-3">Slug</dt><dd class="col-sm-9"><code><%= tenant.tenantSlug %></code></dd>
            <dt class="col-sm-3">ID</dt><dd class="col-sm-9"><code><%= tenant.id %></code></dd>
            <dt class="col-sm-3">Users</dt><dd class="col-sm-9"><%= userCount %></dd>
            <dt class="col-sm-3">Created</dt><dd class="col-sm-9"><%= new Date(tenant.createdAt).toLocaleString() %></dd>
          </dl>
        </div>
      </div>

      <div class="card dashboard-card">
        <div class="card-header bg-white fw-semibold">Users</div>
        <ul class="list-group list-group-flush">
          <% users.forEach(function(u) { %>
            <li class="list-group-item d-flex justify-content-between small">
              <span><%= u.email %> <span class="badge bg-light text-dark border"><%= u.role %></span></span>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card dashboard-card">
        <div class="card-header bg-white fw-semibold">CMMS entitlement</div>
        <div class="card-body">
          <p class="small text-muted mb-3">
            CMMS:
            <% if (tenant.cmmsEnabled) { %>
              <span class="badge bg-success">enabled</span>
            <% } else { %>
              <span class="badge bg-secondary">disabled</span>
            <% } %>
          </p>
          <form method="POST" action="/admin/tenants/<%= tenant.id %>/cmms">
            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" name="enabled" id="cmmsEnabled" value="true"
                     <%= tenant.cmmsEnabled ? 'checked' : '' %>>
              <label class="form-check-label" for="cmmsEnabled">CMMS module enabled</label>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-semibold" for="externalUrl">External CMMS URL</label>
              <input type="text" class="form-control form-control-sm" id="externalUrl" name="externalUrl"
                     value="<%= tenant.cmmsExternalUrl || '' %>" placeholder="https://…">
              <div class="form-text">Optional — link to an external CMMS instance for this tenant.</div>
            </div>
            <button type="submit" class="btn btn-purple btn-sm">Save settings</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/shell-foot') %>
