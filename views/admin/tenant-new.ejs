<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PeakLogic Control Center — <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" href="/branding/peaklogic-favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/peaklogic.css?v=<%= assetV %>">
</head>
<body class="bg-light">
<div class="top-accent-bar"></div>
<%- include('_nav') %>
<% var formData = (locals && locals.form) ? locals.form : {}; %>

<main class="container pt-4 pb-5">
  <div class="mb-3">
    <a href="/admin/tenants" class="text-decoration-none small">&larr; All tenants</a>
  </div>
  <h2 class="h4 mb-3">New customer</h2>

  <% if (locals.error) { %><div class="alert alert-danger"><%= locals.error %></div><% } %>

  <div class="card dashboard-card" style="max-width: 560px;">
    <div class="card-body p-4">
      <form method="POST" action="/admin/tenants">
        <div class="mb-3">
          <label class="form-label">Organization name</label>
          <input type="text" name="tenantName" class="form-control" required
                 placeholder="Acme Utilities" value="<%= formData.tenantName || '' %>">
        </div>
        <div class="mb-3">
          <label class="form-label">Slug</label>
          <input type="text" name="tenantSlug" class="form-control"
                 placeholder="acme-utilities (auto-generated if blank)" pattern="[a-z0-9][a-z0-9-]*"
                 value="<%= formData.tenantSlug || '' %>">
        </div>
        <div class="mb-3">
          <label class="form-label">Admin email</label>
          <input type="email" name="email" class="form-control" required
                 placeholder="admin@acme.example" value="<%= formData.email || '' %>">
        </div>
        <div class="mb-4">
          <label class="form-label">Admin password</label>
          <input type="password" name="password" class="form-control" required minlength="8">
        </div>
        <div class="form-check mb-4">
          <input class="form-check-input" type="checkbox" name="cmmsEnabled" id="cmmsEnabled"
            <%= formData.cmmsEnabled === 'on' || formData.cmmsEnabled === 'true' ? 'checked' : '' %>>
          <label class="form-check-label" for="cmmsEnabled">Enable CMMS for this customer</label>
        </div>
        <button type="submit" class="btn btn-purple">Create customer</button>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/shell-foot') %>
