<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PeakLogic Platform — <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/peaklogic.css">
  <style>
    .wiz-steps { display:flex; gap:.5rem; flex-wrap:wrap; margin-bottom:1.25rem; }
    .wiz-step-tab { flex:1 1 0; min-width:120px; padding:.6rem .75rem; border-radius:.5rem;
      background:#fff; border:1px solid #e3e3e8; color:#6c6c78; font-size:.85rem; }
    .wiz-step-tab .n { display:inline-flex; width:1.4rem; height:1.4rem; border-radius:50%;
      background:#e9e9ef; color:#6c6c78; align-items:center; justify-content:center; font-weight:600; margin-right:.4rem; }
    .wiz-step-tab.active { border-color:#49104F; color:#49104F; box-shadow:0 0 0 1px #49104F inset; }
    .wiz-step-tab.active .n { background:#49104F; color:#fff; }
    .wiz-step-tab.done .n { background:#2e7d32; color:#fff; }
    .wiz-panel { display:none; }
    .wiz-panel.active { display:block; }
  </style>
</head>
<body class="bg-light">
<%- include('_nav') %>
<% var formData = (locals && locals.form) ? locals.form : {}; %>
<% var types = (locals && locals.stationTypes) ? locals.stationTypes : []; %>
<% var counties = (locals && locals.counties) ? locals.counties : []; %>

<main class="container pb-5">
  <h2 class="h4 mb-1">New customer</h2>
  <p class="text-muted small mb-3">Guided setup: create the customer, pick a station type, set the address, then the edge/admin details.</p>

  <% if (locals.error) { %><div class="alert alert-danger"><%= locals.error %></div><% } %>

  <div class="wiz-steps" id="wizSteps">
    <div class="wiz-step-tab" data-step="0"><span class="n">1</span>Who</div>
    <div class="wiz-step-tab" data-step="1"><span class="n">2</span>What</div>
    <div class="wiz-step-tab" data-step="2"><span class="n">3</span>Where</div>
    <div class="wiz-step-tab" data-step="3"><span class="n">4</span>Local admin</div>
    <div class="wiz-step-tab" data-step="4"><span class="n">5</span>Review</div>
  </div>

  <form method="POST" action="/admin/tenants" id="wizForm">

    <!-- Step 1 — WHO -->
    <div class="wiz-panel" data-panel="0">
      <div class="card dashboard-card mb-3">
        <div class="card-header bg-white fw-semibold">Who — customer</div>
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Organization name</label>
              <input type="text" name="tenantName" id="tenantName" class="form-control" required
                     placeholder="Putnam County Utilities" value="<%= formData.tenantName || '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">Slug</label>
              <input type="text" name="tenantSlug" id="tenantSlug" class="form-control" required
                     placeholder="putnam-county-utilities" pattern="[a-z0-9][a-z0-9-]*"
                     value="<%= formData.tenantSlug || '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">Admin email</label>
              <input type="email" name="email" class="form-control" required
                     placeholder="admin@putnamutilities.gov" value="<%= formData.email || '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">Admin password</label>
              <input type="password" name="password" class="form-control" required minlength="8">
            </div>
            <div class="col-md-8 d-flex align-items-center">
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="cmmsEnabled" id="cmmsEnabled"
                  <%= formData.cmmsEnabled === 'on' || formData.cmmsEnabled === 'true' ? 'checked' : '' %>>
                <label class="form-check-label" for="cmmsEnabled">Enable CMMS for this customer</label>
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label">CMMS plan</label>
              <select name="cmmsPlan" class="form-select">
                <% cmmsPlans.forEach(function(p) { %>
                  <option value="<%= p %>" <%= formData.cmmsPlan === p ? 'selected' : '' %>><%= p %></option>
                <% }); %>
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 2 — WHAT -->
    <div class="wiz-panel" data-panel="1">
      <div class="card dashboard-card mb-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <span class="fw-semibold">What — first lift station</span>
          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" name="addStation" id="addStation"
                   <%= formData.addStation === undefined || formData.addStation === 'on' || formData.addStation === 'true' ? 'checked' : '' %>>
            <label class="form-check-label small" for="addStation">Provision a station now</label>
          </div>
        </div>
        <div class="card-body p-4">
          <div class="row g-3 wiz-station">
            <div class="col-md-12">
              <label class="form-label">Device / station type</label>
              <select name="stationType" id="stationType" class="form-select">
                <% types.forEach(function(t) { %>
                  <option value="<%= t.id %>"
                    data-program="<%= t.program %>" data-template="<%= t.templateId %>" data-pumps="<%= t.pumpCount %>"
                    <%= (formData.stationType || 'triplex') === t.id ? 'selected' : '' %>>
                    <%= t.label %> — <%= t.description %>
                  </option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-8">
              <label class="form-label">Station name</label>
              <input type="text" name="stationName" class="form-control"
                     placeholder="125 Yelvington Rd Triplex" value="<%= formData.stationName || '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label">Station slug</label>
              <input type="text" name="stationSlug" class="form-control"
                     placeholder="yelvington-triplex" pattern="[a-z0-9][a-z0-9-]*"
                     value="<%= formData.stationSlug || '' %>">
            </div>
          </div>
          <p class="text-muted small mb-0 wiz-nostation d-none">Station provisioning is turned off — the customer will be created without a lift station. You can add one later from Assets or Sites.</p>
        </div>
      </div>
    </div>

    <!-- Step 3 — WHERE -->
    <div class="wiz-panel" data-panel="2">
      <div class="card dashboard-card mb-3">
        <div class="card-header bg-white fw-semibold">Where — location</div>
        <div class="card-body p-4">
          <div class="row g-3 wiz-station">
            <div class="col-md-6">
              <label class="form-label">Address</label>
              <input type="text" name="address" class="form-control"
                     placeholder="125 Yelvington Rd, Palatka, FL 32131" value="<%= formData.address || '' %>">
            </div>
            <div class="col-md-2">
              <label class="form-label">County</label>
              <select name="county" class="form-select">
                <% counties.forEach(function(c) { %>
                  <option value="<%= c.slug %>" <%= (formData.county || 'putnam') === c.slug ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-2">
              <label class="form-label">Latitude</label>
              <input type="text" name="lat" class="form-control" placeholder="29.6441" value="<%= formData.lat || '' %>">
            </div>
            <div class="col-md-2">
              <label class="form-label">Longitude</label>
              <input type="text" name="lng" class="form-control" placeholder="-81.5888" value="<%= formData.lng || '' %>">
            </div>
            <div class="form-text col-12">Leave lat/lng blank to drop the pin at the county centroid.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 4 — LOCAL ADMIN -->
    <div class="wiz-panel" data-panel="3">
      <div class="card dashboard-card mb-3">
        <div class="card-header bg-white fw-semibold">Local admin — edge device</div>
        <div class="card-body p-4">
          <div class="row g-3 wiz-station">
            <div class="col-md-4">
              <label class="form-label">MQTT device ID</label>
              <input type="text" name="deviceId" class="form-control"
                     placeholder="mv_pcu_yelvington_01" value="<%= formData.deviceId || '' %>">
            </div>
            <div class="col-md-3">
              <label class="form-label">Device slug</label>
              <input type="text" name="deviceSlug" class="form-control"
                     placeholder="dev-pcu-yelvington" pattern="[a-z0-9][a-z0-9-]*" value="<%= formData.deviceSlug || '' %>">
            </div>
            <div class="col-md-2">
              <label class="form-label">Scan (ms)</label>
              <input type="number" name="scanMs" class="form-control" min="10" value="<%= formData.scanMs || '100' %>">
            </div>
            <div class="col-md-3">
              <label class="form-label">ST program</label>
              <input type="text" id="programPreview" class="form-control bg-light" readonly>
            </div>
            <div class="col-md-4">
              <label class="form-label">Device template</label>
              <input type="text" id="templatePreview" class="form-control bg-light" readonly>
            </div>
            <div class="form-text col-12">Program and template are set automatically from the station type and run on the Opta Parc at the edge.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 5 — REVIEW -->
    <div class="wiz-panel" data-panel="4">
      <div class="card dashboard-card mb-3">
        <div class="card-header bg-white fw-semibold">Review</div>
        <div class="card-body p-4">
          <dl class="row mb-0" id="wizReview"></dl>
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-between mb-5">
      <button type="button" class="btn btn-outline-secondary" id="wizBack">Back</button>
      <div>
        <a href="/admin/tenants" class="btn btn-outline-secondary me-2">Cancel</a>
        <button type="button" class="btn btn-purple" id="wizNext">Next</button>
        <button type="submit" class="btn btn-purple d-none" id="wizSubmit">Create customer</button>
      </div>
    </div>
  </form>
</main>

<script>
  (function () {
    var form = document.getElementById('wizForm');
    var panels = Array.prototype.slice.call(form.querySelectorAll('.wiz-panel'));
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.wiz-step-tab'));
    var backBtn = document.getElementById('wizBack');
    var nextBtn = document.getElementById('wizNext');
    var submitBtn = document.getElementById('wizSubmit');
    var addStation = document.getElementById('addStation');
    var typeSel = document.getElementById('stationType');
    var programPrev = document.getElementById('programPreview');
    var templatePrev = document.getElementById('templatePreview');
    var review = document.getElementById('wizReview');

    // Steps that only apply when a station is being provisioned.
    var STATION_STEPS = [1, 2, 3];
    var current = 0;

    function stationOn() { return addStation && addStation.checked; }

    function isStepActive(i) {
      if (STATION_STEPS.indexOf(i) !== -1 && !stationOn()) {
        // Keep step 2 (index 1) visible to expose the toggle; skip 3 & 4.
        return i === 1;
      }
      return true;
    }

    function activeSteps() {
      var out = [];
      for (var i = 0; i < panels.length; i++) if (isStepActive(i)) out.push(i);
      return out;
    }

    function syncType() {
      if (!typeSel) return;
      var opt = typeSel.options[typeSel.selectedIndex];
      if (programPrev) programPrev.value = opt ? opt.getAttribute('data-program') : '';
      if (templatePrev) templatePrev.value = opt ? opt.getAttribute('data-template') : '';
    }

    function toggleStationFields() {
      var on = stationOn();
      form.querySelectorAll('.wiz-station').forEach(function (row) {
        row.querySelectorAll('input, select').forEach(function (el) { el.disabled = !on; });
      });
      var msg = form.querySelector('.wiz-nostation');
      if (msg) msg.classList.toggle('d-none', on);
    }

    function val(name) {
      var el = form.querySelector('[name="' + name + '"]');
      return el ? el.value.trim() : '';
    }

    function buildReview() {
      var rows = [
        ['Customer', val('tenantName') + ' (' + val('tenantSlug') + ')'],
        ['Admin email', val('email')],
        ['CMMS', document.getElementById('cmmsEnabled').checked ? ('on — ' + val('cmmsPlan')) : 'off'],
      ];
      if (stationOn()) {
        var typeLabel = typeSel.options[typeSel.selectedIndex].text;
        rows.push(['Station type', typeLabel]);
        rows.push(['Station', val('stationName') || '(auto from county)']);
        rows.push(['Where', (val('address') || '(no address)') + ' — ' + val('county')]);
        rows.push(['Map pin', (val('lat') && val('lng')) ? (val('lat') + ', ' + val('lng')) : 'county centroid']);
        rows.push(['Device', (val('deviceId') || '(auto)') + ' · ' + templatePrev.value]);
        rows.push(['Program', programPrev.value]);
      } else {
        rows.push(['Station', 'none — customer only']);
      }
      review.innerHTML = rows.map(function (r) {
        return '<dt class="col-sm-3 text-muted">' + r[0] + '</dt><dd class="col-sm-9">' + (r[1] || '') + '</dd>';
      }).join('');
    }

    function render() {
      var steps = activeSteps();
      if (steps.indexOf(current) === -1) current = steps[0];
      panels.forEach(function (p, i) { p.classList.toggle('active', i === current); });
      tabs.forEach(function (t, i) {
        var isStep = steps.indexOf(i) !== -1;
        t.style.display = isStep ? '' : 'none';
        t.classList.toggle('active', i === current);
        t.classList.toggle('done', isStep && steps.indexOf(i) < steps.indexOf(current));
      });
      var pos = steps.indexOf(current);
      backBtn.disabled = pos <= 0;
      var isLast = pos === steps.length - 1;
      nextBtn.classList.toggle('d-none', isLast);
      submitBtn.classList.toggle('d-none', !isLast);
      if (current === 4) buildReview();
    }

    function validatePanel(i) {
      var panel = panels[i];
      var fields = panel.querySelectorAll('input, select');
      for (var k = 0; k < fields.length; k++) {
        var el = fields[k];
        if (!el.disabled && !el.checkValidity()) { el.reportValidity(); return false; }
      }
      return true;
    }

    nextBtn.addEventListener('click', function () {
      if (!validatePanel(current)) return;
      var steps = activeSteps();
      var pos = steps.indexOf(current);
      if (pos < steps.length - 1) { current = steps[pos + 1]; render(); }
    });
    backBtn.addEventListener('click', function () {
      var steps = activeSteps();
      var pos = steps.indexOf(current);
      if (pos > 0) { current = steps[pos - 1]; render(); }
    });
    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        var target = parseInt(t.getAttribute('data-step'), 10);
        if (activeSteps().indexOf(target) === -1) return;
        // Only allow jumping backward or to the immediate next validated step.
        if (target > current && !validatePanel(current)) return;
        current = target; render();
      });
    });
    if (addStation) addStation.addEventListener('change', function () { toggleStationFields(); render(); });
    if (typeSel) typeSel.addEventListener('change', syncType);

    syncType();
    toggleStationFields();
    render();
  })();
</script>
</body>
</html>
