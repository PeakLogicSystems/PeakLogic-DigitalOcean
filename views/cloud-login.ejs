<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · PeakLogic Control Center</title>
  <link rel="icon" href="/branding/peaklogic-favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* PeakLogic brand — matches public/css/peaklogic.css (verified #7C3AED, see that file's header comment).
       Layout modeled on the NextCentury Meters login (app.nextcenturymeters.com/login):
       a single centered card on a full-page diagonal gradient, rather than a split hero/card shell. */
    :root {
      --ps-purple: #7c3aed;
      --ps-purple-dark: #6d28d9;
      --ps-purple-deep: #5b21b6;
      --ps-purple-light: #ede9fe;
      --peaklogic-navy: #0f172a;
      --peaklogic-navy-soft: #1e293b;
      --muted: #94a3b8;
      --border: #dee2e6;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      min-height: 100%;
    }
    body {
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1.25rem 5rem;
      background: linear-gradient(135deg, #1e2947 0%, var(--peaklogic-navy) 55%, var(--ps-purple-deep) 140%);
      color: #fff;
      position: relative;
    }
    .login-shell {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }
    .login-brand {
      display: flex;
      justify-content: center;
      margin-bottom: 3.5rem;
    }
    /* Sized and proportioned per the PeakLogic brand guide's "Logotype" spec:
       mark + wordmark in one SVG (viewBox 0 0 230 48), scaled as a single
       unit so the mark-to-wordmark ratio and gap never drift from brand. */
    .login-logotype {
      width: 38rem;
      max-width: 100%;
      height: auto;
    }
    .login-card {
      width: 100%;
      max-width: 400px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.2);
      padding: 2.5rem 2.5rem 1.75rem;
    }
    .login-card h1 {
      margin: 0 0 0.35rem;
      font-size: 1.35rem;
      font-weight: 700;
      color: #fff;
      text-align: center;
    }
    .login-card .lead {
      margin: 0 0 1.5rem;
      color: rgba(255, 255, 255, 0.65);
      font-size: 0.9rem;
      text-align: center;
    }
    .login-card label {
      display: block;
      margin: 0.85rem 0 0.35rem;
      font-size: 0.82rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.65);
    }
    .login-optional {
      font-weight: 400;
      color: rgba(255, 255, 255, 0.45);
      font-size: 0.8rem;
    }
    .login-card input {
      width: 100%;
      padding: 0.6rem 0.85rem;
      border-radius: 4px;
      border: none;
      background: #fff;
      color: var(--peaklogic-navy);
      font-size: 0.95rem;
    }
    .login-card input::placeholder { color: var(--muted); }
    .login-card input:focus {
      outline: 2px solid var(--ps-purple);
      outline-offset: 1px;
    }
    .login-card button {
      width: 100%;
      margin-top: 1.5rem;
      padding: 0.7rem 0.9rem;
      border: none;
      border-radius: 6px;
      background: var(--ps-purple);
      color: #fff;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.15s ease;
    }
    .login-card button:hover { background: var(--ps-purple-dark); }
    .login-card button.secondary {
      margin-top: 0.65rem;
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: rgba(255, 255, 255, 0.85);
    }
    .login-card button.secondary:hover { background: rgba(255, 255, 255, 0.08); }
    .login-err {
      color: #fca5a5;
      font-size: 0.88rem;
      min-height: 1.25em;
      margin-top: 0.85rem;
      text-align: center;
    }
    .login-links {
      margin-top: 1.1rem;
      font-size: 0.88rem;
      text-align: center;
    }
    .login-links a { color: rgba(255, 255, 255, 0.75); }
    .login-links a:hover { color: #fff; }
    .login-footer {
      position: absolute;
      bottom: 1rem;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.4);
      padding: 0 1rem;
    }
    .step-hidden { display: none; }
  </style>
</head>
<body>
  <div class="login-shell">
    <div class="login-brand">
      <svg class="login-logotype" viewBox="0 0 230 48" fill="none" role="img" aria-label="PeakLogic">
        <g transform="translate(0,6)">
          <path d="M0,36 L16,0 L28,20 L38,4 L48,36 Z" fill="#7C3AED"/>
          <path d="M28,20 L38,4 L48,36 Z" fill="#22C55E" opacity="0.85"/>
        </g>
        <text x="62" y="33" font-family="Inter, 'Segoe UI', sans-serif" font-weight="800" font-size="30" letter-spacing="-1" fill="#FFFFFF">Peak<tspan fill="#7C3AED">Logic</tspan></text>
      </svg>
    </div>
    <form class="login-card" id="login-form" autocomplete="on">
      <div id="step-credentials">
        <h1>Sign in</h1>
        <label for="organizationId">Organization ID <span class="login-optional">(optional)</span></label>
        <input id="organizationId" name="organizationId" autocomplete="organization">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" required>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
        <button type="submit">Sign in</button>
        <p class="login-links"><a href="/forgot-password">Forgot password?</a></p>
      </div>
      <div id="step-mfa" class="step-hidden">
        <h1>Verification code</h1>
        <p class="lead" id="mfa-lead">Enter the 6-digit code sent to your email.</p>
        <label for="mfaCode">Code</label>
        <input id="mfaCode" name="mfaCode" inputmode="numeric" autocomplete="one-time-code" maxlength="8">
        <button type="submit">Verify and sign in</button>
        <button type="button" class="secondary" id="mfa-back">Back</button>
      </div>
      <div class="login-err" id="login-err" role="alert"></div>
    </form>
  </div>
  <div class="login-footer">
    Copyright &copy; <%= new Date().getFullYear() %> PeakLogic. All rights reserved.
  </div>
  <script>
    const next = new URLSearchParams(location.search).get('next') || '/';
    let mfaToken = '';
    const stepCred = document.getElementById('step-credentials');
    const stepMfa = document.getElementById('step-mfa');
    const err = document.getElementById('login-err');

    function showMfa(hint) {
      stepCred.classList.add('step-hidden');
      stepMfa.classList.remove('step-hidden');
      document.getElementById('mfa-lead').textContent =
        'Enter the 6-digit code sent to ' + (hint || 'your email') + '.';
      document.getElementById('mfaCode').focus();
    }

    function showCredentials() {
      mfaToken = '';
      stepMfa.classList.add('step-hidden');
      stepCred.classList.remove('step-hidden');
      document.getElementById('mfaCode').value = '';
    }

    document.getElementById('mfa-back').addEventListener('click', showCredentials);

    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      err.textContent = '';
      try {
        if (mfaToken) {
          const res = await fetch('/api/auth/mfa/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              mfaToken,
              code: document.getElementById('mfaCode').value.trim(),
            }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || res.statusText || 'Verification failed');
          location.href = next.startsWith('/') ? next : '/';
          return;
        }
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            organizationId: document.getElementById('organizationId').value.trim(),
            email: document.getElementById('email').value.trim(),
            password: document.getElementById('password').value,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || res.statusText || 'Sign in failed');
        if (data.mfaRequired) {
          mfaToken = data.mfaToken;
          showMfa(data.emailHint);
          return;
        }
        location.href = next.startsWith('/') ? next : '/';
      } catch (ex) {
        err.textContent = ex.message || String(ex);
      }
    });
  </script>
</body>
</html>
