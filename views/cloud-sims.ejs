<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#7C3AED">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/branding/peaklogic-favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icons/icon-512.png">
  <script src="/js/pwa.js" defer></script>
  <title>Cloud Sims — PeakLogic</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/pc.css?v=<%= assetV %>">
</head>
<body class="cloud-sims-body">
  <div class="top-accent-bar"></div>
  <header class="topbar standalone-topbar">
    <div class="topbar-brand"><a href="/" class="standalone-home-link"><img src="/branding/peaklogic-icon.svg" alt="" class="topbar-brand-icon">Peak<span>Logic</span></a><span class="topbar-cloud-badge" title="PeakLogic Control Center">Control Center</span></div>
    <h1 class="standalone-title">Cloud Sim Management</h1>
    <div class="standalone-meta popup-header-actions">
      <span id="cloud-sims-status" class="muted cell-mono" aria-live="polite">Loading…</span>
      <span class="topbar-version muted cell-mono" title="PeakLogic release">v<%= appVersion %></span>
      <a href="/" class="btn popup-close page-close" title="Return to dashboard">Close</a>
    </div>
  </header>

  <main class="cloud-sims-main">
    <% if (!cloudSimsEnabled) { %>
    <section class="cloud-sims-disabled panel" role="alert">
      <h2>Cloud Sim management is disabled</h2>
      <p>Enable it in <a href="/">System setup</a> → <strong>Features</strong> → check <strong>Enable Cloud Sim management</strong> → <strong>Apply all settings</strong>, then reload this page.</p>
      <p class="muted">Or set <code>PEAKLOGIC_CLOUD_SIMS=1</code> in <code>.env</code> and restart the server, or run with <code>PEAKLOGIC_DEPLOYMENT=cloud</code>.</p>
    </section>
    <% } else { %>
    <p class="panel-hint cloud-sims-hint">
      Create virtual Opta / Modbus devices that publish tenant-scoped MQTT telemetry into the cloud Parc hub.
    </p>

    <section class="cloud-sims-create panel">
      <h2>Create sim</h2>
      <form id="cloud-sims-create-form" class="cloud-sims-form">
        <label>Name <input type="text" id="sim-name" required maxlength="128" placeholder="Demo Opta Line 1"></label>
        <label>Tenant ID <input type="text" id="sim-tenant" required maxlength="64" value="demo-tenant" pattern="[a-zA-Z0-9._-]+"></label>
        <label>Type
          <select id="sim-type">
            <option value="opta">Opta (virtual Parc telemetry)</option>
            <option value="modbus">Modbus (register tags)</option>
            <option value="mixed">Mixed (Opta + Modbus)</option>
          </select>
        </label>
        <label>MQTT device ID <input type="text" id="sim-device-id" maxlength="64" placeholder="auto-generated if blank"></label>
        <label>Interval (ms) <input type="number" id="sim-interval" min="200" step="100" value="2000"></label>
        <button type="submit" class="btn btn-primary">Create sim</button>
      </form>
      <p id="cloud-sims-create-msg" class="cloud-sims-msg muted" aria-live="polite"></p>
    </section>

    <section class="cloud-sims-list panel">
      <div class="cloud-sims-list-head">
        <h2>Sim instances</h2>
        <button type="button" class="btn" id="cloud-sims-refresh">Refresh</button>
      </div>
      <div id="cloud-sims-table-wrap">
        <p class="muted">Loading sims…</p>
      </div>
    </section>
    <% } %>
  </main>

  <script>window.PEAKLOGIC_DEPLOYMENT = '<%= deployment %>';</script>
  <script>window.PEAKLOGIC_CLOUD_SIMS_ENABLED = <%= cloudSimsEnabled ? 'true' : 'false' %>;</script>
  <script src="/js/api.js?v=<%= assetV %>"></script>
  <script src="/js/cloudSimsPage.js?v=<%= assetV %>"></script>
</body>
</html>
