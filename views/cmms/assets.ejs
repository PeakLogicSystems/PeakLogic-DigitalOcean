<%- include('../partials/shell-head', { title }) %>
<%- include('../partials/shell-nav', { user, tenant, cmmsEnabled, activeNav }) %>

<main class="container py-4">
  <h1 class="h3 mb-3">Assets</h1>
  <% if (message) { %><div class="alert alert-success py-2"><%= message %></div><% } %>
  <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card dashboard-card">
        <div class="table-responsive">
          <table class="table mb-0">
            <thead class="table-light"><tr><th>Name</th><th>Serial</th><th>Status</th></tr></thead>
            <tbody>
              <% if (!assets.length) { %>
                <tr><td colspan="3" class="text-muted p-3">No assets yet.</td></tr>
              <% } else { assets.forEach(function(a) { %>
                <tr>
                  <td><%= a.name %></td>
                  <td><code><%= a.serialNumber || '—' %></code></td>
                  <td><%= a.status %></td>
                </tr>
              <% }); } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <% if (['admin', 'operator'].includes(user.role)) { %>
    <div class="col-lg-5">
      <div class="card dashboard-card">
        <div class="card-header bg-white fw-semibold">Add asset</div>
        <div class="card-body">
          <form method="POST" action="/cmms/assets">
            <div class="mb-2"><input name="name" class="form-control" placeholder="Name" required></div>
            <div class="mb-2"><input name="serialNumber" class="form-control" placeholder="Serial number"></div>
            <div class="mb-2">
              <select name="facilityId" class="form-select">
                <option value="">Facility (optional)</option>
                <% facilities.forEach(function(f) { %>
                  <option value="<%= f._id %>"><%= f.name %></option>
                <% }); %>
              </select>
            </div>
            <button type="submit" class="btn btn-purple btn-sm">Add</button>
          </form>
        </div>
      </div>
    </div>
    <% } %>
  </div>
</main>

<%- include('../partials/shell-foot') %>
