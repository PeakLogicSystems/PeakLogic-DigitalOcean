<%- include('../partials/shell-head', { title }) %>
<%- include('../partials/shell-nav', { user, tenant, cmmsEnabled, activeNav }) %>

<main class="container py-4">
  <h1 class="h3 mb-4">CMMS Dashboard</h1>
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card dashboard-card text-white bg-purple">
        <div class="card-body">
          <h2 class="h6">Open work orders</h2>
          <p class="display-6 mb-0"><%= stats.openCount %></p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card dashboard-card">
        <div class="card-body">
          <h2 class="h6 text-muted">Total work orders</h2>
          <p class="display-6 mb-0"><%= stats.totalWorkOrders %></p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card dashboard-card">
        <div class="card-body">
          <h2 class="h6 text-muted">Assets</h2>
          <p class="display-6 mb-0"><%= stats.totalAssets %></p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card dashboard-card">
        <div class="card-body">
          <h2 class="h6 text-muted">Facilities</h2>
          <p class="display-6 mb-0"><%= stats.totalFacilities %></p>
        </div>
      </div>
    </div>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a href="/cmms/work-orders" class="btn btn-purple">Work Orders</a>
    <a href="/cmms/assets" class="btn btn-outline-purple">Assets</a>
    <a href="/cmms/facilities" class="btn btn-outline-purple">Facilities</a>
    <% if (user.role === 'admin') { %>
      <a href="/cmms/users" class="btn btn-outline-purple">Users</a>
    <% } %>
  </div>
</main>

<%- include('../partials/shell-foot') %>
