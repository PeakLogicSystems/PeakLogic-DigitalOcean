      <header class="popup-header popup-header-split">
        <h2 id="popup-drivers-title">Drivers</h2>
        <div class="popup-header-actions">
          <button type="button" id="btn-drivers-context-help" class="btn btn-sm btn-help-context" data-help-section="drivers" title="Help: Drivers">Help</button>
          <button type="button" class="btn popup-close" data-popup-close="drivers" title="Close">Close</button>
        </div>
      </header>
      <div class="drivers-shell">
        <nav class="drivers-nav setup-nav" aria-label="Drivers sections">
          <button type="button" class="setup-tab active" data-drivers-tab-btn="list">Driver list</button>
          <button type="button" class="setup-tab" data-drivers-tab-btn="modbus">Modbus RTU ↔ TCP</button>
          <button type="button" class="setup-tab" data-drivers-tab-btn="nextcentury">NextCentury API</button>
