<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PeakLogic</title>
  <link rel="stylesheet" href="/css/pc.css?v=<%= assetV %>">
</head>
<body class="dashboard-body">
  <header class="topbar">
    <div class="topbar-brand"><img src="/branding/peaklogic-icon.svg" alt="Logo" class="topbar-logo"></div>
    <div class="topbar-project-bar">
      <details class="topbar-project-details" id="project-menu-details">
        <summary class="topbar-project-trigger">Project <span class="topbar-project-caret" aria-hidden="true">▾</span></summary>
        <div id="project-menu" class="topbar-project-dropdown" role="menu" aria-label="Project">
          <button type="button" class="topbar-menu-item" id="btn-project-status" role="menuitem">Status…</button>
          <button type="button" class="topbar-menu-item" id="btn-project-about" role="menuitem">About…</button>
          <button type="button" class="topbar-menu-item" id="btn-project-setup" role="menuitem">System setup…</button>
          <button type="button" class="topbar-menu-item" id="btn-proj-new-menu" role="menuitem">New project…</button>
          <div class="topbar-menu-sep" role="separator"></div>
          <button type="button" class="topbar-menu-item" id="btn-open-est" role="menuitem">Open project…</button>
          <button type="button" class="topbar-menu-item" id="btn-export-est" role="menuitem">Export project file…</button>
          <button type="button" class="topbar-menu-item" id="btn-save-est" role="menuitem">Save project</button>
          <button type="button" class="topbar-menu-item" id="btn-save-est-as" role="menuitem">Save project as…</button>
          <button type="button" class="topbar-menu-item" id="btn-save-ws" role="menuitem">Save workspace</button>
          <div class="topbar-menu-sep" role="separator"></div>
          <div class="topbar-menu-field">
            <label for="proj-hmi-composer-mode">HMI composer mode</label>
            <select id="proj-hmi-composer-mode" class="topbar-menu-select" title="Grid tile editor for 2D HMI, or 3D facility spatial preview">
              <option value="grid">Grid — 2D tile editing</option>
              <option value="3d">3D — facility spatial view</option>
            </select>
          </div>
          <div class="topbar-menu-sep" role="separator"></div>
          <button type="button" class="topbar-menu-item" id="btn-delete-est" role="menuitem">Delete project…</button>
        </div>
        <input type="file" id="file-open-est" accept=".est,.json,application/json" hidden>
      </details>
      <span class="topbar-project-status" id="project-name" aria-live="polite" title="Current project">untitled</span>
    </div>
    <details class="topbar-tools-details topbar-project-details" id="tools-menu-details">
      <summary class="topbar-project-trigger topbar-tools-trigger">Tools <span class="topbar-project-caret" aria-hidden="true">▾</span></summary>
      <nav class="topbar-tools-dropdown topbar-project-dropdown" id="view-nav" aria-label="Tools" role="menu">
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="program" role="menuitem">Program</button>
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="tags" role="menuitem">Tags</button>
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="alarms" role="menuitem">Alarms <span id="alarms-tab-badge" class="alarms-tab-badge view-hidden" aria-hidden="true"></span></button>
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="drivers" role="menuitem">Drivers</button>
        <a href="/io-map" class="topbar-menu-item topbar-menu-link" role="menuitem" data-io-map-link>I/O Map</a>
        <a href="/peaklogic-draw" class="topbar-menu-item topbar-menu-link" role="menuitem">Facility Builder</a>
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="historian" role="menuitem">Historian</button>
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="report" role="menuitem">Report</button>
        <button type="button" class="topbar-menu-item view-tab" id="btn-help" data-popup-open="help" title="Help (F1)" role="menuitem">Help</button>
      </nav>
    </details>
    <div class="topbar-about-meta">
      <button type="button" class="topbar-text-btn" id="btn-topbar-about" title="About PeakLogic">About</button>
      <span class="topbar-version muted cell-mono" title="PeakLogic release">v<%= appVersion %></span>
    </div>
  </header>

  <main class="hmi-workspace">
    <section class="panel panel-hmi-main" id="sec-hmi-main">
      <div class="hmi-main-header">
        <h2>HMI</h2>
        <div class="hmi-main-actions">
          <label id="hmi-test-mode-wrap" class="hmi-test-mode-label view-hidden" title="Technician test mode — live refresh every 10s (normal view is 1 min)">
            <input type="checkbox" id="hmi-test-mode"> Test mode
          </label>
          <span id="hmi-poll-hint" class="muted cell-mono hmi-poll-hint"></span>
          <button type="button" class="btn btn-sm btn-help-context" data-help-section="hmi-overview" title="Help: HMI — overview">Help</button>
          <button type="button" id="btn-hmi-setup" class="btn">Setup…</button>
          <button type="button" id="btn-hmi-reload" class="btn">Reload screen</button>
        </div>
      </div>
      <div class="hmi-main-body">
        <nav id="hmi-nav-bar" class="hmi-nav-bar view-hidden" aria-label="HMI screen navigation"></nav>
        <div id="hmi-live-status" class="hmi-live-status">
          <div class="hmi-live-status-text">
            <div id="hmi-screen-title" class="muted cell-mono"></div>
            <p class="panel-hint hmi-display-hint">Live display — composed screen without grid lines. Open <strong>Setup…</strong> to edit on the tile grid.</p>
          </div>
          <button type="button" id="btn-hmi-hide-status" class="btn btn-sm hmi-live-status-toggle" title="Hide status message">Hide</button>
        </div>
        <button type="button" id="btn-hmi-show-status" class="btn btn-sm hmi-live-status-restore view-hidden" title="Show status message below screen tabs">Show status</button>
        <div class="hmi-live-stage-wrap">
          <aside id="hmi-alarm-sidebar" class="hmi-alarm-sidebar view-hidden" aria-label="Active alarms">
            <div class="hmi-alarm-sidebar-head">
              <div class="hmi-alarm-sidebar-head-main">
                <h3 class="hmi-alarm-sidebar-title">Active alarms</h3>
                <button type="button" id="btn-hmi-alarms-ack-all" class="btn btn-sm" disabled>Ack all</button>
              </div>
              <span id="hmi-alarm-sidebar-count" class="hmi-alarm-sidebar-count cell-mono"></span>
            </div>
            <div id="hmi-alarm-sidebar-body" class="hmi-alarm-sidebar-body"></div>
          </aside>
          <div id="hmi-viewport" class="hmi-viewport hmi-viewport-live hmi-display-viewport"></div>
        </div>
        <div id="hmi-room-popup" class="hmi-room-popup view-hidden" role="dialog" aria-modal="true" aria-labelledby="hmi-room-popup-title" aria-hidden="true">
          <div class="hmi-room-popup-backdrop" data-hmi-room-close></div>
          <div class="hmi-room-popup-panel">
            <header class="hmi-room-popup-header">
              <h2 id="hmi-room-popup-title" class="hmi-room-popup-title">Room</h2>
              <button type="button" class="btn btn-sm hmi-room-popup-close" data-hmi-room-close title="Close room detail">Close</button>
            </header>
            <div class="hmi-room-popup-body">
              <div id="hmi-room-popup-main" class="hmi-room-popup-main" aria-label="Room layout"></div>
              <aside id="hmi-room-popup-condenser" class="hmi-room-popup-condenser" aria-label="Roof condenser"></aside>
            </div>
            <div id="hmi-room-popup-flash" class="hmi-room-popup-flash view-hidden" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ST Program floating panel -->
  <div class="app-popup view-hidden program-shell-stub" data-popup="program" role="dialog" aria-labelledby="popup-program-title" aria-hidden="true"></div>
  <div class="popup-chrome popup-chrome-program popup-chrome-floater view-hidden" id="program-chrome" role="dialog" aria-labelledby="popup-program-title">
    <div class="hmi-setup-drag-bar popup-header-draggable" data-floater-drag-handle title="Drag to move">⠿ Move</div>
    <header class="popup-header popup-header-split popup-header-draggable">
      <h2 id="popup-program-title">ST Program <span class="popup-drag-hint muted">— drag bar or header · edges to resize</span></h2>
      <div class="popup-header-actions program-runtime-actions">
        <button type="button" class="btn btn-sm btn-help-context" data-help-section="st-editor" title="Help: ST program editor">Help</button>
        <label class="prog-remote-label" title="On: deploy and run ST on Opta. Off: ST runs on this PC (Opta can still serve I/O).">
          <input type="checkbox" id="prog-remote-exec"> Remote
        </label>
        <button type="button" id="btn-remote-connect" class="btn btn-sm" disabled title="Link HTTP driver to Opta">Connect</button>
        <button type="button" id="btn-remote-disconnect" class="btn btn-sm" disabled title="Unlink Opta HTTP driver">Disconnect</button>
        <span id="prog-remote-status" class="prog-remote-status muted cell-mono"></span>
        <button type="button" id="btn-start" class="btn ok" title="Validate and run ST">Start</button>
        <button type="button" id="btn-pause" class="btn warn" disabled>Pause</button>
        <button type="button" id="btn-stop" class="btn danger" disabled>Stop</button>
        <button type="button" class="btn popup-close" data-popup-close="program" title="Close">Close</button>
      </div>
    </header>
    <div class="popup-body popup-body-program popup-scroll program-floater-body">
      <p class="panel-hint">Edit ST below (Tab = indent, Ctrl+S = save). Live overlay: <strong>true</strong> conditions green (<code>✓</code>), output tags like <code>R1</code> in <code>TurnON(R1)</code> red when ON, numeric ops show <code>= value</code>. Override I/O from <strong>Tags</strong> (<strong>Force</strong> / <strong>Force val</strong> columns). Poll will not overwrite <em>unsaved</em> program edits.</p>
      <p class="panel-hint cell-mono" id="program-folder"></p>
      <div class="toolbar wrap">
        <button type="button" id="btn-prog-new" class="btn">New</button>
        <button type="button" id="btn-prog-open" class="btn">Open from st/…</button>
        <button type="button" id="btn-prog-import" class="btn">Import .st from disk…</button>
        <button type="button" id="btn-prog-save" class="btn primary">Save program</button>
        <button type="button" id="btn-prog-save-as" class="btn">Save as…</button>
        <input type="file" id="file-open-st" accept=".st,text/plain" hidden>
        <span class="sep"></span>
        <label>Library
          <select id="program-library"></select>
        </label>
        <button type="button" id="btn-prog-load" class="btn">Load selected</button>
        <button type="button" id="btn-prog-load-fixtures" class="btn" title="Replace all tags and drivers with st/fixtures/ for the selected program (demo/test)">Load fixtures</button>
        <button type="button" id="btn-prog-create-tags" class="btn" title="Add missing tags referenced by the active program (no overwrite)">Create tags from program</button>
        <button type="button" id="btn-prog-reload" class="btn" title="Re-read active .st file from disk">Reload from disk</button>
        <button type="button" id="btn-prog-clear" class="btn" title="Unload active program and clear editor">Clear active</button>
        <button type="button" id="btn-prog-revert" class="btn" title="Discard unsaved edits">Revert</button>
        <label class="tag-display-pick" title="How tag names appear in Live I/O and program tag list">Show
          <select id="program-tag-display" data-tag-display-mode></select>
        </label>
        <span id="program-active" class="muted"></span>
        <span id="program-edit-status" class="inline-msg muted"></span>
        <span id="prog-line-status" class="prog-line-status muted cell-mono" title="ST source line count vs PC and Parc limits"></span>
      </div>
      <div id="program-tag-legend" class="program-tag-legend view-hidden" aria-live="polite"></div>
      <div class="st-editor-wrap" id="st-editor-wrap">
        <pre class="st-editor-gutter" data-st-gutter aria-hidden="true">1</pre>
        <div class="st-editor-main">
          <pre class="st-editor-highlight" data-st-highlight aria-hidden="true"></pre>
          <textarea id="program-src" class="editor program-editor st-editor-input" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" wrap="off" aria-label="ST program source"></textarea>
        </div>
      </div>
      <div class="toolbar">
        <button type="button" id="btn-prog-pid" class="btn">PID loop…</button>
        <button type="button" id="btn-prog-validate" class="btn">Validate</button>
        <button type="button" id="btn-prog-debug-trace" class="btn" title="Show IF/THEN conditions and output tags using current tag values (no runtime start). Click again to clear.">Debug trace</button>
        <button type="button" id="btn-prog-apply" class="btn primary" title="Validate ST and load into PeakLogic runtime (does not save to disk). Deploy to Opta on Start when Remote is on.">Load for runtime</button>
        <span id="prog-deploy-estimate" class="prog-deploy-estimate muted cell-mono" hidden title="Estimated Opta HTTP deploy size when Remote is on"></span>
        <span id="program-errors" class="inline-msg"></span>
      </div>
    </div>
    <div class="popup-resize-handle popup-resize-w" data-resize="w" aria-hidden="true"></div>
    <div class="popup-resize-handle popup-resize-s" data-resize="s" aria-hidden="true"></div>
    <div class="popup-resize-handle popup-resize-e" data-resize="e" aria-hidden="true"></div>
    <div class="popup-resize-handle popup-resize-sw" data-resize="sw" aria-hidden="true"></div>
    <div class="popup-resize-handle popup-resize-se" data-resize="se" aria-hidden="true"></div>
  </div>

  <!-- Tags floating panel -->
  <div class="app-popup view-hidden tags-shell-stub" data-popup="tags" role="dialog" aria-labelledby="popup-tags-title" aria-hidden="true"></div>
  <div class="popup-chrome popup-chrome-tags popup-chrome-floater view-hidden" id="tags-chrome" role="dialog" aria-labelledby="popup-tags-title">
    <div class="hmi-setup-drag-bar popup-header-draggable" data-floater-drag-handle title="Drag to move">⠿ Move</div>
    <header class="popup-header popup-header-split popup-header-draggable">
      <h2 id="popup-tags-title">Tags <span id="tag-count" class="muted"></span> <span class="popup-drag-hint muted">— drag bar or header · edges to resize</span></h2>
      <div class="popup-header-actions">
        <button type="button" class="btn btn-sm btn-help-context" data-help-section="tags" title="Help: Tags">Help</button>
        <button type="button" class="btn popup-close" data-popup-close="tags" title="Close">Close</button>
      </div>
    </header>
    <div class="popup-body popup-body-tags tags-floater-body popup-scroll">
      <p class="panel-hint"><strong>Tag</strong> column: <strong>Tag id</strong> (used in ST programs) plus optional <strong>Label</strong> (HMI display only — not an ST alias). <strong>Hist</strong> column: check tags for live buffer and MongoDB archive logging (header checkbox selects all plottable tags); trend chart pens are configured separately under <strong>Historian → Pen config…</strong>; MongoDB logging under <strong>Logger config…</strong>. <strong>PID</strong>: wire <strong>PV / SP / CV</strong> in <strong>Addr</strong> to INT/REAL tags; gains in the SP column. <strong>Force</strong> columns: check <strong>On</strong>, edit value, <strong>Apply</strong>. Click a <strong>column header</strong> to sort.</p>
      <div class="toolbar">
        <button type="button" id="btn-tag-add" class="btn">Add BOOL</button>
        <button type="button" id="btn-tag-add-int" class="btn">Add INT</button>
        <button type="button" id="btn-tag-add-real" class="btn">Add REAL</button>
        <button type="button" id="btn-tag-add-counter" class="btn">Add counter</button>
        <button type="button" id="btn-tag-add-timer" class="btn">Add timer</button>
        <button type="button" id="btn-tag-add-pid" class="btn">Add PID</button>
        <button type="button" id="btn-tag-add-avg" class="btn">Add averager</button>
        <button type="button" id="btn-tag-save" class="btn primary">Save tags</button>
        <button type="button" id="btn-clear-tags" class="btn" title="Remove all tags from the project">Clear tags</button>
        <button type="button" id="btn-clear-forces" class="btn" title="Release all forced tags">Clear forces</button>
        <button type="button" id="btn-tags-live-io" class="btn" title="Floating live I/O for program tags">Live I/O…</button>
        <span id="tags-dirty-hint" class="inline-msg muted"></span>
      </div>
      <div id="tags-table" class="table-wrap scroll tags-table tags-table-scroll"></div>
    </div>
    <div class="popup-resize-handle popup-resize-w" data-resize="w" aria-hidden="true"></div>
    <div class="popup-resize-handle popup-resize-s" data-resize="s" aria-hidden="true"></div>
    <div class="popup-resize-handle popup-resize-e" data-resize="e" aria-hidden="true"></div>
    <div class="popup-resize-handle popup-resize-sw" data-resize="sw" aria-hidden="true"></div>
    <div class="popup-resize-handle popup-resize-se" data-resize="se" aria-hidden="true"></div>
  </div>

  <!-- Alarms floating panel -->
  <div class="app-popup view-hidden alarms-shell-stub" data-popup="alarms" role="dialog" aria-labelledby="popup-alarms-title" aria-hidden="true"></div>
  <div class="popup-chrome popup-chrome-alarms popup-chrome-floater view-hidden" id="alarms-chrome" role="dialog" aria-labelledby="popup-alarms-title">
    <div class="hmi-setup-drag-bar popup-header-draggable" data-floater-drag-handle title="Drag to move">⠿ Move</div>
    <header class="popup-header popup-header-split popup-header-draggable">
      <h2 id="popup-alarms-title">Alarms <span id="alarms-summary" class="muted"></span> <span class="popup-drag-hint muted">— drag bar or header · edges to resize</span></h2>
      <div class="popup-header-actions">
        <button type="button" class="btn btn-sm btn-help-context" data-help-section="alarms" title="Help: Alarms">Help</button>
        <button type="button" class="btn popup-close" data-popup-close="alarms" title="Close">Close</button>
      </div>
    </header>
    <div class="popup-body popup-body-alarms alarms-floater-body">
      <p class="panel-hint">Active alarms from the <strong>Tags</strong> database — limits for INT/REAL, on/off condition for BOOL. Configure alarms in the Tags table (<strong>Alarm</strong> columns). Acknowledged alarms stay listed until the condition clears.</p>
      <div class="toolbar wrap">
        <button type="button" id="btn-alarms-ack-all" class="btn">Ack all</button>
        <button type="button" id="btn-alarms-notify-setup" class="btn">Notification users…</button>
        <label class="alarms-filter">
          <input type="checkbox" id="alarms-show-acked"> Show acknowledged
        </label>
        <span id="alarms-meta" class="muted cell-mono"></span>
      </div>
      <div id="alarms-list" class="table-wrap alarms-list-scroll"></div>
    </div>
    <div class="popup-resize-handle popup-resize-w" data-resize="w" aria-hidden="true"></div>
    <div class="popup-resize-handle popup-resize-s" data-resize="s" aria-hidden="true"></div>
    <div class="popup-resize-handle popup-resize-e" data-resize="e" aria-hidden="true"></div>
    <div class="popup-resize-handle popup-resize-sw" data-resize="sw" aria-hidden="true"></div>
    <div class="popup-resize-handle popup-resize-se" data-resize="se" aria-hidden="true"></div>
  </div>

  <!-- Alarm notification users (opened from Alarms panel) -->
  <div class="app-popup view-hidden" data-popup="alarm-notify" role="dialog" aria-labelledby="popup-alarm-notify-title">
    <div class="popup-chrome popup-chrome-wide">
      <header class="popup-header popup-header-split">
        <h2 id="popup-alarm-notify-title">Alarm notification users</h2>
        <div class="popup-header-actions">
          <button type="button" class="btn btn-sm btn-help-context" data-help-section="alarms" title="Help: Alarms">Help</button>
          <button type="button" class="btn popup-close" data-popup-close="alarm-notify" title="Close">Close</button>
        </div>
      </header>
      <div class="popup-body popup-scroll">
        <p class="panel-hint">Who receives email/SMS when tags enter alarm states. Delivery integration is pending — notifications are queued locally for now.</p>
        <div class="toolbar wrap">
          <button type="button" id="btn-user-add" class="btn primary">Add user</button>
          <span id="users-msg" class="muted"></span>
        </div>
        <div id="users-table-host" class="users-table-host"></div>
        <details id="user-editor" class="user-editor" open>
          <summary>Edit profile</summary>
          <div class="form-grid compact">
            <label>Email <input id="user-email" type="email"></label>
            <label>Role
              <select id="user-role">
                <option value="admin">Admin</option>
                <option value="operator">Operator</option>
                <option value="viewer">Viewer</option>
              </select>
            </label>
            <label>Display name <input id="user-display-name"></label>
            <label>First name <input id="user-first-name"></label>
            <label>Last name <input id="user-last-name"></label>
            <label>Title <input id="user-title"></label>
            <label>Department <input id="user-department"></label>
            <label>Phone <input id="user-phone"></label>
            <label>Mobile <input id="user-mobile"></label>
            <label>Timezone <input id="user-timezone" placeholder="America/New_York"></label>
          </div>
          <h4 class="setup-subhead">Alarm notifications</h4>
          <div class="form-grid compact">
            <label class="historian-ctl"><input type="checkbox" id="user-alarm-enabled" checked> Notifications enabled</label>
            <label class="historian-ctl"><input type="checkbox" id="user-alarm-email" checked> Email</label>
            <label class="historian-ctl"><input type="checkbox" id="user-alarm-sms"> SMS</label>
            <label class="historian-ctl"><input type="checkbox" id="user-alarm-push"> Push (future)</label>
            <label>Min level
              <select id="user-alarm-min-level">
                <option value="all">All alarms</option>
                <option value="inner">Inner + outer</option>
                <option value="outer">Outer only</option>
                <option value="alarm">Alarm only</option>
                <option value="none">None</option>
              </select>
            </label>
            <label>Notify email (override) <input id="user-alarm-email-addr" type="email" placeholder="blank = profile email"></label>
            <label>Notify phone <input id="user-alarm-phone" placeholder="SMS destination"></label>
            <label class="historian-ctl"><input type="checkbox" id="user-quiet-enabled"> Quiet hours</label>
            <label>Quiet start <input id="user-quiet-start" type="time" value="22:00"></label>
            <label>Quiet end <input id="user-quiet-end" type="time" value="07:00"></label>
          </div>
          <div class="toolbar wrap">
            <button type="button" id="btn-user-save" class="btn primary">Save user</button>
            <button type="button" id="btn-user-delete" class="btn danger">Delete user</button>
          </div>
        </details>
        <details id="cmms-integration" class="user-editor" open>
          <summary>CMMS / MQTT integration (PeakLogic v1)</summary>
          <p class="panel-hint">Publishes alarm events to MQTT for TPS CMMS or other subscribers. Topics: <code>peaklogic/v1/{siteId}/alarms</code> and <code>…/alarm-notify</code>. See <code>docs/CMMS_INTEGRATION.md</code>.</p>
          <div class="form-grid compact">
            <label class="historian-ctl"><input type="checkbox" id="cmms-enabled"> Enable CMMS MQTT publish</label>
            <label>Broker URL <input id="cmms-broker-url" placeholder="mqtt://127.0.0.1:1883"></label>
            <label>Site ID <input id="cmms-site-id" placeholder="local"></label>
            <label>Tenant ID <input id="cmms-tenant-id" placeholder="local"></label>
            <label>Topic prefix <input id="cmms-topic-prefix" placeholder="peaklogic/v1"></label>
            <label>MQTT client ID <input id="cmms-client-id" placeholder="peaklogic-cmms"></label>
            <label class="historian-ctl"><input type="checkbox" id="cmms-publish-alarms" checked> Publish <code>…/alarms</code> topic</label>
            <label class="historian-ctl"><input type="checkbox" id="cmms-publish-notify" checked> Publish <code>…/alarm-notify</code> (with recipients)</label>
          </div>
