<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="icon" href="/peaklogic.ico" sizes="any">
  <link rel="icon" href="/branding/peaklogic-icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/pc.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/css/peaklogic-draw.css?v=<%= assetV %>">
</head>
<body class="peaklogic-draw-body">
  <header class="topbar peaklogic-draw-topbar">
    <div class="topbar-brand">
      <a href="/"><img src="/branding/peaklogic-icon.svg" alt="Logo" class="topbar-logo"></a>
    </div>
    <div class="peaklogic-draw-toolbar" role="toolbar" aria-label="Drawing tools">
      <button type="button" class="peaklogic-tool active" data-tool="select" title="Select / move">Select</button>
      <button type="button" class="peaklogic-tool" data-tool="connect" title="Connect ports with a pipe">Connect</button>
      <button type="button" class="peaklogic-tool" data-tool="calibrate" title="Calibrate scale from a known distance">Calibrate</button>
      <button type="button" class="peaklogic-tool" data-tool="extents" title="Set drawing/site extents">Extents</button>
      <span class="peaklogic-toolbar-sep" aria-hidden="true"></span>
      <button type="button" id="peaklogic-btn-undo" class="btn" title="Undo (Ctrl+Z)" disabled>Undo</button>
      <button type="button" id="peaklogic-btn-redo" class="btn" title="Redo (Ctrl+Y)" disabled>Redo</button>
      <span class="peaklogic-toolbar-sep" aria-hidden="true"></span>
      <button type="button" id="peaklogic-btn-bg" class="btn" title="Upload a background image">Background…</button>
      <input type="file" id="peaklogic-bg-file" accept="image/png,image/jpeg,image/webp" hidden>
      <span class="peaklogic-toolbar-sep" aria-hidden="true"></span>
      <button type="button" id="peaklogic-btn-pdf" class="btn" title="Export as PDF">PDF</button>
      <button type="button" id="peaklogic-btn-dxf" class="btn" title="Export as DXF">DXF</button>
      <span class="peaklogic-toolbar-sep" aria-hidden="true"></span>
      <button type="button" id="peaklogic-btn-save" class="btn primary" title="Save">Save</button>
    </div>
    <div class="topbar-about-meta">
      <span id="peaklogic-status" class="muted cell-mono">Loading…</span>
    </div>
  </header>

  <div class="peaklogic-draw-layout">
    <aside class="peaklogic-draw-sidebar">
      <h2 class="peaklogic-sidebar-title">Project</h2>
      <label>Name
        <input type="text" id="peaklogic-proj-name" placeholder="Site plan name">
      </label>
      <label>Site
        <input type="text" id="peaklogic-proj-site" placeholder="Site address">
      </label>
      <label>Client
        <input type="text" id="peaklogic-proj-client" placeholder="Client / owner">
      </label>
      <label>Notes
        <textarea id="peaklogic-proj-notes" rows="3"></textarea>
      </label>

      <hr class="peaklogic-inspector-sep">

      <h3 class="peaklogic-sidebar-subtitle">Scale</h3>
      <p id="peaklogic-scale-label" class="peaklogic-sidebar-hint">Not calibrated</p>

      <h3 class="peaklogic-sidebar-subtitle">Site extents</h3>
      <div id="peaklogic-extents-info" class="peaklogic-extents-info">
        <p id="peaklogic-extents-label" class="peaklogic-sidebar-hint">Not set</p>
        <label>Label
          <input type="text" id="peaklogic-extents-label-inp" placeholder="Site extents">
        </label>
        <div class="peaklogic-extents-actions">
          <button type="button" id="peaklogic-btn-fit-extents" class="btn">Fit view</button>
          <button type="button" id="peaklogic-btn-clear-extents" class="btn">Clear</button>
        </div>
      </div>

      <hr class="peaklogic-inspector-sep">

      <h3 class="peaklogic-sidebar-subtitle">Symbol library</h3>
      <p class="peaklogic-sidebar-hint">Pick a symbol, then click the canvas to place it.</p>
      <div id="peaklogic-symbol-list" class="peaklogic-symbol-list"></div>
    </aside>

    <main class="peaklogic-draw-main">
      <div class="peaklogic-canvas-wrap">
        <canvas id="peaklogic-canvas"></canvas>
      </div>
      <div class="peaklogic-draw-hud">
        <span id="peaklogic-cursor-label" class="cell-mono">0.0, 0.0</span>
      </div>
    </main>

    <aside class="peaklogic-draw-inspector">
      <h2 class="peaklogic-sidebar-title">Inspector</h2>
      <p id="peaklogic-inspector-empty" class="peaklogic-sidebar-hint">Select a symbol on the canvas to edit it.</p>
      <form id="peaklogic-inspector-form" class="peaklogic-inspector-form view-hidden" onsubmit="return false">
        <label>Label
          <input type="text" id="peaklogic-insp-label">
        </label>
        <label>Type
          <input type="text" id="peaklogic-insp-type" readonly>
        </label>
        <label>X
          <input type="number" step="0.01" id="peaklogic-insp-x">
        </label>
        <label>Y
          <input type="number" step="0.01" id="peaklogic-insp-y">
        </label>
        <label>Rotation (°)
          <input type="number" step="1" id="peaklogic-insp-rot">
        </label>
        <hr class="peaklogic-inspector-sep">
        <button type="button" id="peaklogic-insp-delete" class="btn danger">Delete symbol</button>
      </form>
    </aside>
  </div>

  <dialog id="peaklogic-calibrate-dialog" class="peaklogic-dialog">
    <form method="dialog">
      <h3 class="peaklogic-sidebar-title">Calibrate scale</h3>
      <p id="peaklogic-calibrate-step" class="peaklogic-sidebar-hint">Step 1: click first point on canvas</p>
      <label>Known distance
        <input type="number" step="0.01" min="0" id="peaklogic-calibrate-dist">
      </label>
      <label>Units
        <select id="peaklogic-calibrate-units">
          <option value="ft">feet</option>
          <option value="m">meters</option>
        </select>
      </label>
      <div class="peaklogic-dialog-actions">
        <button type="button" id="peaklogic-calibrate-cancel" class="btn">Cancel</button>
        <button type="submit" id="peaklogic-calibrate-apply" class="btn primary" disabled>Apply</button>
      </div>
    </form>
  </dialog>

  <script src="/js/peaklogicDrawApp.js"></script>
</body>
</html>
