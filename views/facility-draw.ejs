<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#7C3AED">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icons/icon-512.png">
  <script src="/js/pwa.js" defer></script>
  <title>Facility Draw — PeakLogic</title>
  <link rel="stylesheet" href="/css/pc.css?v=<%= assetV %>&facilitydraw=12">
  <link rel="stylesheet" href="/css/facility-draw.css?v=<%= assetV %>&facilitydraw=12">
</head>
<body class="facility-draw-body<%= (typeof embedded !== 'undefined' && embedded) ? ' facility-draw-embedded' : '' %>">
  <header class="topbar standalone-topbar facility-draw-topbar">
    <div class="topbar-brand"><a href="/" class="standalone-home-link">Peak<span>Logic</span></a></div>
    <div class="mv-file-menu-wrap">
      <button type="button" id="mv-file-menu-btn" class="topbar-project-trigger mv-file-menu-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="mv-file-menu-panel">
        File <span class="topbar-project-caret" aria-hidden="true">▾</span>
      </button>
      <div id="mv-file-menu-panel" class="topbar-project-dropdown mv-file-menu-panel view-hidden" role="menu" aria-label="File">
        <button type="button" class="topbar-menu-item" id="mv-menu-new" role="menuitem">New</button>
        <button type="button" class="topbar-menu-item" id="mv-menu-open" role="menuitem">Open…</button>
        <div class="topbar-menu-sep" role="separator"></div>
        <button type="button" class="topbar-menu-item" id="mv-menu-save" role="menuitem">Save</button>
        <button type="button" class="topbar-menu-item" id="mv-menu-save-as" role="menuitem">Save as…</button>
        <button type="button" class="topbar-menu-item" id="mv-menu-export-package" role="menuitem">Export package…</button>
        <button type="button" class="topbar-menu-item" id="mv-menu-save-to-project" role="menuitem">Save to PeakLogic project…</button>
        <button type="button" class="topbar-menu-item" id="mv-menu-compile-hmi" role="menuitem">Compile HMI faceplates…</button>
        <button type="button" class="topbar-menu-item" id="mv-menu-load-from-project" role="menuitem">Load from PeakLogic project</button>
        <div class="topbar-menu-sep" role="separator"></div>
        <button type="button" class="topbar-menu-item" id="mv-menu-help" role="menuitem">Help</button>
        <div class="topbar-menu-sep" role="separator"></div>
        <div class="mv-file-menu-path" aria-live="polite">
          <div class="mv-file-menu-path-label">Current file</div>
          <div id="mv-file-menu-path" class="mv-file-menu-path-value cell-mono">—</div>
          <div id="mv-file-menu-peaklogic" class="mv-file-menu-peaklogic cell-mono">PeakLogic project: —</div>
          <div id="mv-file-menu-session" class="mv-file-menu-session cell-mono">Session: data/facility-draw/active.json</div>
        </div>
      </div>
    </div>
    <div class="mv-composer-modes" role="group" aria-label="HMI composer mode">
      <span class="mv-composer-modes-label muted">Composer</span>
      <button type="button" class="btn btn-sm mv-composer-mode-btn" data-composer-mode="grid" title="2D tile grid — edit HMI symbols, composites, and tag bindings">2D grid</button>
      <button type="button" class="btn btn-sm mv-composer-mode-btn" data-composer-mode="3d" title="3D facility spatial preview">3D</button>
      <button type="button" class="btn btn-sm mv-composer-mode-btn active" data-composer-mode="plan" title="Facility Draw site plan (this view)">Plan</button>
    </div>
    <div class="mv-project-status-block">
      <span id="mv-project-name" class="topbar-project-status mv-project-name" title="Current project">Loading…</span>
      <span id="mv-project-path" class="mv-project-path cell-mono" title="Saved file path">—</span>
    </div>
    <h1 class="standalone-title">Facility Draw</h1>
    <div class="facility-draw-toolbar" role="toolbar" aria-label="Drawing tools">
      <button type="button" class="btn btn-sm facility-draw-btn mv-tool active" data-tool="select" title="Select / move" aria-pressed="true">Select</button>
      <button type="button" class="btn btn-sm facility-draw-btn mv-tool" data-tool="rotate" title="Rotate symbol (Shift = 15° snap)" aria-pressed="false">Rotate</button>
      <button type="button" class="btn btn-sm facility-draw-btn mv-tool" data-tool="stretch" title="Stretch symbol to align ports (Shift = uniform)" aria-pressed="false">Stretch</button>
      <button type="button" class="btn btn-sm facility-draw-btn mv-tool" data-tool="place" title="Place symbol" aria-pressed="false">Place</button>
      <button type="button" class="btn btn-sm facility-draw-btn mv-tool" data-tool="connect" title="Draw connection (pick line color first)" aria-pressed="false">Connect</button>
      <span class="mv-line-palette" id="mv-line-palette" hidden role="group" aria-label="Line color">
        <button type="button" class="mv-line-kind active" data-line-kind="src" title="Source — blue" aria-pressed="true">Src</button>
        <button type="button" class="mv-line-kind" data-line-kind="return" title="Return — red" aria-pressed="false">Return</button>
        <button type="button" class="mv-line-kind" data-line-kind="electric" title="Electric — yellow" aria-pressed="false">Electric</button>
      </span>
      <button type="button" class="btn btn-sm facility-draw-btn mv-tool" data-tool="calibrate" title="Two-point scale" aria-pressed="false">Calibrate</button>
      <button type="button" class="btn btn-sm facility-draw-btn mv-tool" data-tool="extents" title="Set drawing extents (two corners)" aria-pressed="false">Extents</button>
      <button type="button" class="btn btn-sm" id="mv-btn-zoom-extents" title="Zoom to drawing extents (Home)">Zoom extents</button>
      <span class="mv-toolbar-sep"></span>
      <label class="mv-snap-toggle" title="Snap to grid and nearby symbols (S toggles · Alt hold while dragging to suspend)">
        <input type="checkbox" id="mv-snap-enabled" checked> Snap
      </label>
      <select id="mv-snap-grid" class="mv-snap-grid" title="Grid snap spacing" aria-label="Grid snap spacing">
        <option value="1">1 ft</option>
        <option value="5" selected>5 ft</option>
        <option value="10">10 ft</option>
      </select>
      <span class="mv-toolbar-sep"></span>
      <button type="button" class="btn btn-sm" id="mv-btn-undo" title="Undo (Ctrl+Z)" disabled>Undo</button>
      <button type="button" class="btn btn-sm" id="mv-btn-redo" title="Redo (Ctrl+Y)" disabled>Redo</button>
      <button type="button" class="btn btn-sm facility-draw-btn facility-draw-btn--danger" id="mv-btn-delete" title="Delete selected object (Delete)" disabled>Delete</button>
      <span class="mv-toolbar-sep"></span>
      <button type="button" class="btn btn-sm" id="mv-btn-bg" title="Import site plan image">Background…</button>
      <button type="button" class="btn btn-sm" id="mv-btn-save">Save</button>
      <select id="mv-export-orientation" class="mv-export-orientation" title="PDF/DXF export orientation" aria-label="Export orientation">
        <option value="landscape" selected>Landscape</option>
        <option value="portrait">Portrait</option>
      </select>
      <button type="button" class="btn btn-sm" id="mv-btn-pdf">PDF</button>
      <button type="button" class="btn btn-sm" id="mv-btn-dxf">DXF</button>
      <button type="button" class="btn btn-sm" id="mv-btn-3d" title="Generate 3D site view from layout">View 3D</button>
      <input type="file" id="mv-bg-file" accept="image/png,image/jpeg,image/webp" hidden>
    </div>
    <div class="standalone-meta popup-header-actions">
      <span id="mv-status" class="muted cell-mono" aria-live="polite">Loading…</span>
      <span class="topbar-version muted cell-mono">v<%= appVersion %></span>
      <button type="button" class="btn btn-sm" id="mv-btn-help" title="Help (F1)">Help</button>
      <button type="button" class="btn btn-sm" id="btn-standalone-sign-out" title="Sign out">Sign out</button>
      <a href="/" class="btn popup-close page-close" title="Return to dashboard">Close</a>
    </div>
  </header>

  <div class="facility-draw-layout">
    <aside class="facility-draw-sidebar" aria-label="Symbol library">
      <h2 class="mv-sidebar-title">Library</h2>
      <label class="mv-library-search-label">Filter
        <input type="search" id="mv-library-search" class="mv-library-search" placeholder="Search symbols…" autocomplete="off">
      </label>
      <p class="panel-hint mv-sidebar-hint">Expand a category, pick a symbol, then click the canvas to place. <strong>HMI —</strong> groups are Composer SVG symbols. <strong>Select</strong>: drag symbols or marquee-drag empty canvas; click a connection to edit bends. <strong>Shift</strong> adds to selection. Use <strong>Connect</strong> for new polylines.</p>
      <div id="mv-symbol-list" class="mv-symbol-list"></div>
    </aside>

    <main class="facility-draw-main">
      <div class="mv-canvas-wrap">
        <canvas id="mv-canvas" aria-label="Site plan canvas"></canvas>
      </div>
      <div class="facility-draw-hud">
        <span id="mv-scale-label" class="muted cell-mono">Scale: not calibrated</span>
        <span id="mv-extents-label" class="muted cell-mono">Extents: not set</span>
        <span id="mv-cursor-label" class="muted cell-mono"></span>
        <span id="mv-snap-label" class="muted cell-mono"></span>
        <span class="muted cell-mono">Pan: Space+drag · S snap · X stretch · ↑↓←→ nudge · Shift ×5</span>
      </div>
    </main>

    <aside class="facility-draw-inspector" aria-label="Properties">
      <h2 class="mv-sidebar-title">Properties</h2>
      <div id="mv-inspector-empty" class="panel-hint">Select a component or connection.</div>
      <form id="mv-inspector-form" class="mv-inspector-form view-hidden">
        <label>Label <input type="text" id="mv-insp-label" maxlength="120"></label>
        <label>Type <input type="text" id="mv-insp-type" readonly class="cell-mono"></label>
        <label>X (ft) <input type="number" id="mv-insp-x" step="0.1"></label>
        <label>Y (ft) <input type="number" id="mv-insp-y" step="0.1"></label>
        <label>Rotation ° <input type="number" id="mv-insp-rot" step="15"></label>
        <label>Width × <input type="number" id="mv-insp-scale-x" step="0.05" min="0.2" max="8"></label>
        <label>Height × <input type="number" id="mv-insp-scale-y" step="0.05" min="0.2" max="8"></label>
        <hr class="mv-inspector-sep">
        <h3 class="mv-sidebar-subtitle">3D / SCADA</h3>
        <p class="panel-hint">Bind symbols to PeakLogic devices for live alarm/level colors in the 3D viewer.</p>
        <label>Device ID <input type="text" id="mv-insp-device-id" maxlength="80" placeholder="e.g. ls_house_1" class="cell-mono"></label>
        <label>Zone ID <input type="text" id="mv-insp-zone-id" maxlength="80" placeholder="e.g. zone-a" class="cell-mono"></label>
        <label>Role
          <select id="mv-insp-role">
            <option value="">— auto —</option>
            <option value="collection">Collection (simplex)</option>
            <option value="booster">Booster (duplex)</option>
            <option value="plant">Plant (ATU)</option>
          </select>
        </label>
        <label>Alarm tag <input type="text" id="mv-insp-alarm-tag" maxlength="80" placeholder="SPX_ALM" class="cell-mono"></label>
        <label>Level tag <input type="text" id="mv-insp-level-tag" maxlength="80" placeholder="SPX_LEVEL" class="cell-mono"></label>
        <button type="button" class="btn btn-sm facility-draw-btn facility-draw-btn--danger" id="mv-insp-delete">Delete</button>
      </form>
      <form id="mv-edge-inspector-form" class="mv-inspector-form view-hidden">
        <label>Line type
          <select id="mv-edge-insp-kind">
            <option value="src">Source (blue)</option>
            <option value="return">Return (red)</option>
            <option value="electric">Electric (yellow)</option>
          </select>
        </label>
        <label>Route <input type="text" id="mv-edge-insp-route" readonly class="cell-mono"></label>
        <label>Bends <input type="number" id="mv-edge-insp-bends" readonly></label>
        <p>Drag yellow handles to move bends (snap applies). Drag silver midpoint dots on a selected line to add/route a bend. Double-click the line to insert a bend. <kbd>Delete</kbd> removes the connection; <kbd>Backspace</kbd> removes a selected bend or the last bend.</p>
        <button type="button" class="btn btn-sm facility-draw-btn facility-draw-btn--danger" id="mv-edge-insp-delete">Delete connection</button>
      </form>
      <hr class="mv-inspector-sep">
      <h3 class="mv-sidebar-subtitle">Snap &amp; align</h3>
      <p class="panel-hint mv-align-hint">With <strong>Snap</strong> on, symbols align to the grid and nearby edges/centers while dragging. Press <strong>S</strong> to toggle snap, or hold <strong>Alt</strong> while dragging to move freely. Use <strong>Stretch</strong> (<strong>X</strong>) to resize a symbol so connection ports line up with pipes.</p>
      <div class="mv-align-grid" role="group" aria-label="Align selection">
        <button type="button" class="btn btn-sm facility-draw-btn mv-align-btn" data-align="left" title="Align left edges" disabled>Left</button>
        <button type="button" class="btn btn-sm facility-draw-btn mv-align-btn" data-align="centerH" title="Align horizontal centers" disabled>Center H</button>
        <button type="button" class="btn btn-sm facility-draw-btn mv-align-btn" data-align="right" title="Align right edges" disabled>Right</button>
        <button type="button" class="btn btn-sm facility-draw-btn mv-align-btn" data-align="bottom" title="Align bottom edges" disabled>Bottom</button>
        <button type="button" class="btn btn-sm facility-draw-btn mv-align-btn" data-align="centerV" title="Align vertical centers" disabled>Middle</button>
        <button type="button" class="btn btn-sm facility-draw-btn mv-align-btn" data-align="top" title="Align top edges" disabled>Top</button>
      </div>
      <div class="mv-align-actions">
        <button type="button" class="btn btn-sm facility-draw-btn mv-align-btn" data-align="distributeH" title="Even horizontal spacing (3+ selected)" disabled>Distribute H</button>
        <button type="button" class="btn btn-sm facility-draw-btn mv-align-btn" data-align="distributeV" title="Even vertical spacing (3+ selected)" disabled>Distribute V</button>
        <button type="button" class="btn btn-sm facility-draw-btn" id="mv-align-extents" title="Align to drawing extents boundary" disabled>Align to extents</button>
      </div>
      <hr class="mv-inspector-sep">
      <h3 class="mv-sidebar-subtitle">Grouping</h3>
      <p class="panel-hint mv-group-hint">Drag a box on empty canvas to select multiple symbols. <strong>Group</strong> keeps them together when dragging. Click any group member to move the whole group.</p>
      <div class="mv-group-actions">
        <button type="button" class="btn btn-sm facility-draw-btn" id="mv-btn-group" title="Group selection (Ctrl+G)" disabled>Group</button>
        <button type="button" class="btn btn-sm facility-draw-btn" id="mv-btn-ungroup" title="Ungroup (Ctrl+Shift+G)" disabled>Ungroup</button>
      </div>
      <hr class="mv-inspector-sep">
      <h3 class="mv-sidebar-subtitle">Workspace</h3>
      <p class="panel-hint">Standard architectural sheets (landscape). Sets drawing extents centered on the current view or content.</p>
      <label class="mv-workspace-scale-label">Plot scale
        <span class="mv-workspace-scale-row">
          <span>1 in =</span>
          <input type="number" id="mv-workspace-wpi" min="1" step="1" value="10">
          <span id="mv-workspace-wpi-units">ft</span>
        </span>
      </label>
      <div class="mv-sheet-grid" role="group" aria-label="Standard sheet workspace">
        <button type="button" class="btn btn-sm facility-draw-btn mv-sheet-btn" data-sheet="A" title="Arch A — 12×9 in" aria-pressed="false">A</button>
        <button type="button" class="btn btn-sm facility-draw-btn mv-sheet-btn" data-sheet="B" title="Arch B — 18×12 in" aria-pressed="false">B</button>
        <button type="button" class="btn btn-sm facility-draw-btn mv-sheet-btn" data-sheet="C" title="Arch C — 24×18 in" aria-pressed="false">C</button>
        <button type="button" class="btn btn-sm facility-draw-btn mv-sheet-btn" data-sheet="D" title="Arch D — 36×24 in" aria-pressed="false">D</button>
      </div>
      <p id="mv-sheet-hint" class="panel-hint mv-sheet-hint">Arch D (36×24 in) → 360×240 ft at 1 in = 10 ft</p>
      <hr class="mv-inspector-sep">
      <h3 class="mv-sidebar-subtitle">Drawing extents</h3>
      <p id="mv-extents-info" class="panel-hint mv-extents-info">Not set — pick a sheet above or use <strong>Extents</strong> to click two corners.</p>
      <label>Label <input type="text" id="mv-extents-label-inp" maxlength="120" placeholder="Site extents"></label>
      <div class="mv-extents-actions">
        <button type="button" class="btn btn-sm facility-draw-btn" id="mv-btn-clear-extents" disabled>Clear extents</button>
      </div>
      <hr class="mv-inspector-sep">
      <h3 class="mv-sidebar-subtitle">Project</h3>
      <label>Name <input type="text" id="mv-proj-name" maxlength="80"></label>
      <label>Site <input type="text" id="mv-proj-site" maxlength="200"></label>
      <label>Client <input type="text" id="mv-proj-client" maxlength="200"></label>
      <label>Notes <textarea id="mv-proj-notes" rows="3" maxlength="2000"></textarea></label>
    </aside>
  </div>

  <div id="mv-open-overlay" class="mv-modal-overlay view-hidden" aria-hidden="true">
    <div class="mv-dialog mv-open-dialog mv-modal-panel" role="dialog" aria-modal="true" aria-labelledby="mv-open-title">
      <form id="mv-open-form">
        <h3 id="mv-open-title">Open project</h3>
        <p class="panel-hint">Choose a saved layout on this server, or open a portable <code>.mvbundle</code> / <code>.facilitydraw.json</code> file.</p>
        <div class="project-list-sort mv-project-list-sort" data-mv-project-sort-scope="open" role="group" aria-label="Sort projects">
          <span class="project-list-sort-label">Sort</span>
          <button type="button" class="btn btn-sm project-sort-btn" data-mv-project-sort="name">Name</button>
          <button type="button" class="btn btn-sm project-sort-btn" data-mv-project-sort="date">Date</button>
          <button type="button" class="btn btn-sm project-sort-btn" data-mv-project-sort="type">Type</button>
        </div>
        <div id="mv-open-list" class="mv-project-list" role="listbox" aria-label="Saved projects">
          <p class="panel-hint mv-open-loading">Loading projects…</p>
        </div>
        <p id="mv-open-empty" class="panel-hint view-hidden">No saved projects yet — use <strong>Save as…</strong> first.</p>
        <div class="mv-dialog-actions">
          <button type="button" class="btn" id="mv-open-browse">Open from file…</button>
          <button type="button" class="btn" id="mv-open-cancel">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <dialog id="mv-save-as-dialog" class="mv-dialog">
    <form method="dialog" id="mv-save-as-form">
      <h3>Save as</h3>
      <p class="panel-hint">Save a copy to the server library. The <strong>file name</strong> is independent of the project name in Properties.</p>
      <label>File name
        <input type="text" id="mv-save-as-name" maxlength="80" required autocomplete="off" placeholder="site-plan">
      </label>
      <div class="mv-dialog-actions">
        <button type="button" class="btn" id="mv-save-as-cancel">Cancel</button>
        <button type="submit" class="btn btn-primary" id="mv-save-as-apply">Save</button>
      </div>
    </form>
  </dialog>

  <input type="file" id="mv-open-file" accept=".mvbundle,.json,.facilitydraw.json,application/json" hidden>

  <dialog id="mv-help-dialog" class="mv-dialog mv-help-dialog" aria-labelledby="mv-help-title">
    <div class="mv-help-header">
      <h3 id="mv-help-title">Facility Draw help</h3>
      <button type="button" class="btn btn-sm" id="mv-help-close" aria-label="Close help">Close</button>
    </div>
    <div class="mv-help-layout">
      <nav id="mv-help-nav" class="mv-help-nav" aria-label="Help topics"></nav>
      <div id="mv-help-body" class="mv-help-body"></div>
    </div>
  </dialog>

  <div id="mv-unsaved-overlay" class="mv-modal-overlay view-hidden" aria-hidden="true">
    <div class="mv-dialog mv-unsaved-dialog mv-modal-panel" role="alertdialog" aria-modal="true" aria-labelledby="mv-unsaved-title">
      <form id="mv-unsaved-form">
        <h3 id="mv-unsaved-title">Save changes?</h3>
        <p id="mv-unsaved-message" class="panel-hint">Your layout has unsaved changes.</p>
        <div class="mv-dialog-actions mv-unsaved-actions">
          <button type="button" class="btn" id="mv-unsaved-cancel">Cancel</button>
          <button type="button" class="btn" id="mv-unsaved-discard">Don't save</button>
          <button type="submit" class="btn btn-primary" id="mv-unsaved-save">Save</button>
        </div>
      </form>
    </div>
  </div>

  <dialog id="mv-calibrate-dialog" class="mv-dialog">
    <form method="dialog">
      <h3>Scale calibration</h3>
      <p class="panel-hint">Click two points on the background with a known distance between them.</p>
      <p id="mv-calibrate-step" class="cell-mono">Step 1: click first point on canvas</p>
      <label>Known distance
        <input type="number" id="mv-calibrate-dist" min="0.1" step="0.1" value="100">
        <select id="mv-calibrate-units">
          <option value="ft">ft</option>
          <option value="m">m</option>
        </select>
      </label>
      <div class="mv-dialog-actions">
        <button type="button" class="btn" id="mv-calibrate-cancel">Cancel</button>
        <button type="submit" class="btn btn-primary" id="mv-calibrate-apply" disabled>Apply scale</button>
      </div>
    </form>
  </dialog>

  <script src="/js/api.js?v=<%= assetV %>"></script>
  <script src="/js/signOut.js?v=<%= assetV %>"></script>
  <script src="/js/facilityDrawSnap.js?v=<%= assetV %>&facilitydraw=12"></script>
  <script src="/js/facilityDrawPorts.js?v=<%= assetV %>&facilitydraw=12"></script>
  <script src="/js/facilityDrawEdgePath.js?v=<%= assetV %>&facilitydraw=12"></script>
  <script src="/js/facilityDrawGroups.js?v=<%= assetV %>&facilitydraw=12"></script>
  <script src="/js/facilityDrawSheetSizes.js?v=<%= assetV %>&facilitydraw=12"></script>
  <script src="/js/facilityDrawLabelWrap.js?v=<%= assetV %>&facilitydraw=12"></script>
  <script src="/js/facilityDrawHelp.js?v=<%= assetV %>&facilitydraw=12"></script>
  <script src="/js/facilityDrawApp.js?v=<%= assetV %>&facilitydraw=12"></script>
  <script>PeaklogicSignOut.bind('btn-standalone-sign-out');</script>
</body>
</html>
