<%- include('../partials/shell-head', { title: 'Fleet' }) %>
<link rel="stylesheet" href="/css/fleet.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js" crossorigin=""></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
<%- include('../partials/shell-nav', { user, tenant, cmmsEnabled, activeNav }) %>

<main class="container-fluid py-3 px-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
      <h1 class="h3 mb-0">Fleet operations</h1>
      <p class="text-muted small mb-0"><%= tenant.name %> — <%= stations.length %> lift stations on map</p>
    </div>
    <form class="d-flex flex-wrap gap-2 align-items-end" method="GET" action="/fleet">
      <div>
        <label class="form-label small mb-0">County</label>
        <select name="county" class="form-select form-select-sm">
          <option value="">All counties</option>
          <% counties.forEach(function(c) { %>
            <option value="<%= c %>" <%= filters.county === c ? 'selected' : '' %>><%= c %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label class="form-label small mb-0">Type</label>
        <select name="stationType" class="form-select form-select-sm">
          <option value="">All types</option>
          <% stationTypes.forEach(function(t) { %>
            <option value="<%= t.id %>" <%= filters.stationType === t.id ? 'selected' : '' %>><%= t.label %></option>
          <% }); %>
        </select>
      </div>
      <button type="submit" class="btn btn-sm btn-purple">Filter</button>
      <a href="/fleet/reports" class="btn btn-sm btn-outline-secondary">Daily report</a>
    </form>
  </div>

  <% if (importResult) { %>
    <div class="alert alert-success py-2 small">Import complete — <%= importResult.created %> created, <%= importResult.errors %> errors.</div>
  <% } %>

  <div class="row g-3">
    <div class="col-lg-3">
      <div class="card shadow-sm fleet-coverage-panel">
        <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center py-2">
          <span>Map coverage</span>
          <span class="text-muted small" id="fleet-coverage-count"></span>
        </div>
        <div class="card-body py-2 px-3">
          <div class="btn-group btn-group-sm w-100 mb-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="fleet-coverage-all">All</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="fleet-coverage-none">None</button>
          </div>
          <div class="fleet-coverage-list">
            <% Object.keys(coverageRegions).sort().forEach(function(region) { %>
              <div class="mb-2">
                <div class="text-muted text-uppercase fleet-region-label"><%= region %></div>
                <% coverageRegions[region].forEach(function(c) { %>
                  <div class="form-check form-check-sm">
                    <input
                      class="form-check-input fleet-county-cb"
                      type="checkbox"
                      value="<%= c.slug %>"
                      id="fleet-county-<%= c.slug %>"
                      data-lat="<%= c.lat %>"
                      data-lng="<%= c.lng %>"
                      <%= defaultCoverageSlugs.includes(c.slug) ? 'checked' : '' %>
                    >
                    <label class="form-check-label small" for="fleet-county-<%= c.slug %>"><%= c.name %></label>
                  </div>
                <% }); %>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div id="fleet-map" class="fleet-map border rounded shadow-sm"></div>
    </div>
    <div class="col-lg-3">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white fw-semibold d-flex justify-content-between">
          <span>Active alarms</span>
          <span class="badge bg-danger"><%= alarms.length %></span>
        </div>
        <div class="list-group list-group-flush fleet-alarm-list" style="max-height:520px;overflow:auto">
          <% if (!alarms.length) { %>
            <div class="list-group-item text-muted small">No active alarms.</div>
          <% } else { %>
            <% alarms.forEach(function(a) { %>
              <a href="/fleet/stations/<%= a.systemId %>" class="list-group-item list-group-item-action py-2">
                <div class="d-flex justify-content-between">
                  <strong class="small"><%= a.name %></strong>
                  <span class="badge <%= a.alarmState === 'alarm' ? 'bg-danger' : a.alarmState === 'offline' ? 'bg-secondary' : 'bg-warning text-dark' %>"><%= a.alarmState %></span>
                </div>
                <div class="text-muted small"><%= a.countyName %> · <%= a.stationTypeLabel %></div>
              </a>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <% if (canManage) { %>
    <div class="card shadow-sm mt-3">
      <div class="card-body">
        <h2 class="h6">Bulk import stations (CSV)</h2>
        <p class="text-muted small">Columns: <code>county, station_name, station_slug, station_type, lat, lng, device_id, device_slug</code>.
          Types: <code>dual_duplex</code>, <code>single_atu</code>, <code>dual_atu</code>, <code>quad_atu</code>.</p>
        <form method="POST" action="/fleet/import">
          <textarea name="csv" class="form-control font-monospace small mb-2" rows="5" placeholder="county,station_name,station_slug,station_type,lat,lng,device_id
palm-beach,LS-001,ls-001,single_atu,26.7153,-80.0534,opta_ls_001"></textarea>
          <button type="submit" class="btn btn-purple btn-sm">Import CSV</button>
        </form>
      </div>
    </div>
  <% } %>
</main>

<script>
  window.FLEET_STATIONS = <%- JSON.stringify(stations) %>;
  window.FLEET_COVERAGE_RADIUS_M = <%= coverageRadiusM %>;
</script>
<script src="/js/fleetPage.js?v=<%= typeof version !== 'undefined' ? version : '1' %>"></script>
<%- include('../partials/shell-foot') %>
