<%- include('../partials/shell-head', { title: station.name }) %>
<%- include('../partials/shell-nav', { user, tenant, cmmsEnabled, activeNav }) %>

<main class="container py-4">
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
      <li class="breadcrumb-item"><a href="/fleet">Fleet</a></li>
      <li class="breadcrumb-item active"><%= station.name %></li>
    </ol>
  </nav>

  <% if (typeof query !== 'undefined' && query.acked) { %>
    <div class="alert alert-success py-2 small">Alarm acknowledged.</div>
  <% } %>

  <div class="row g-3">
    <div class="col-lg-7">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h1 class="h4 mb-1"><%= station.name %></h1>
              <p class="text-muted small mb-0">
                <code><%= station.slug %></code> · <%= station.metadata.countyName || station.county?.name || '' %>
              </p>
            </div>
            <span class="badge fs-6 <%= station.alarmState === 'alarm' ? 'bg-danger' : station.alarmState === 'offline' ? 'bg-secondary' : station.alarmState === 'warning' ? 'bg-warning text-dark' : 'bg-success' %>">
              <%= station.alarmState %>
            </span>
          </div>
          <dl class="row small mt-3 mb-0">
            <dt class="col-sm-4">Type</dt>
            <dd class="col-sm-8"><%= station.profile?.label || station.metadata.stationType %></dd>
            <dt class="col-sm-4">Program</dt>
            <dd class="col-sm-8"><code><%= station.metadata.program || station.profile?.program %></code></dd>
            <dt class="col-sm-4">Template</dt>
            <dd class="col-sm-8"><code><%= station.metadata.templateId || station.profile?.templateId %></code></dd>
            <dt class="col-sm-4">Coordinates</dt>
            <dd class="col-sm-8"><%= station.metadata.lat %>, <%= station.metadata.lng %></dd>
            <dt class="col-sm-4">Last seen</dt>
            <dd class="col-sm-8"><%= station.lastSeenAt ? new Date(station.lastSeenAt).toLocaleString() : '—' %></dd>
          </dl>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">Devices</div>
        <ul class="list-group list-group-flush">
          <% if (!station.devices.length) { %>
            <li class="list-group-item text-muted small">No devices registered.</li>
          <% } else { %>
            <% station.devices.forEach(function(d) { %>
              <li class="list-group-item small">
                <strong><%= d.name %></strong> <code><%= d.slug %></code><br>
                <span class="text-muted"><%= d.driverType %> · <%= d.driverConfig?.deviceId || '' %></span>
              </li>
            <% }); %>
          <% } %>
        </ul>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <% if (station.metadata.locationId || station.locationId) { %>
          <a href="/studio?locationId=<%= station.locationId %>" class="btn btn-sm btn-purple">Open Studio</a>
        <% } %>
        <a href="/sites/<%= station.locationId %>" class="btn btn-sm btn-outline-purple">Sites</a>
        <% if (canManage && station.alarmState !== 'normal') { %>
          <form method="POST" action="/fleet/stations/<%= station.id %>/ack" class="d-inline">
            <button type="submit" class="btn btn-sm btn-outline-secondary">Ack alarm</button>
          </form>
        <% } %>
        <% if (cmmsEnabled) { %>
          <a href="/cmms/work-orders" class="btn btn-sm btn-outline-secondary">CMMS</a>
        <% } %>
      </div>
    </div>
  </div>

  <% if (station.tags && station.tags.length) { %>
    <div class="card shadow-sm mt-3">
      <div class="card-header bg-white fw-semibold">Live tags (sample)</div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead><tr><th>Tag</th><th>Value</th></tr></thead>
          <tbody>
            <% station.tags.slice(0, 24).forEach(function(t) { %>
              <tr><td><code><%= t.id %></code></td><td><%= t.value %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</main>
<%- include('../partials/shell-foot') %>
