<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof productLabel !== 'undefined' ? productLabel : 'PeakLogic Cloud' %> — <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/peaklogic.css">
</head>
<body class="bg-light">
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card shadow border-0" style="border-radius: 1rem;">
        <div class="card-body p-5">
          <h3 class="fw-bold text-secondary mb-2">Forgot password</h3>
          <p class="text-muted small mb-4">Enter your organization and email. We will send a reset link if the account exists.</p>

          <% if (error) { %>
            <div class="alert alert-danger py-2 small"><%= error %></div>
          <% } %>
          <% if (message) { %>
            <div class="alert alert-success py-2 small"><%= message %></div>
          <% } %>

          <form action="/forgot-password" method="POST">
            <div class="form-floating mb-3">
              <input type="text" name="tenantSlug" class="form-control" id="tenantSlug"
                     value="<%= tenantSlug %>" required>
              <label for="tenantSlug">Organization slug</label>
            </div>
            <div class="form-floating mb-4">
              <input type="email" name="email" class="form-control" id="email"
                     value="<%= email %>" required>
              <label for="email">Email</label>
            </div>
            <div class="d-grid mb-3">
              <button type="submit" class="btn btn-purple btn-lg">Send reset link</button>
            </div>
          </form>
          <p class="text-center small mb-0"><a href="/login">Back to sign in</a></p>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
