<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof productLabel !== 'undefined' ? productLabel : 'mooreVIEW Cloud' %> — <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" href="/mv.ico" sizes="any">
  <link rel="icon" href="/branding/mv-icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/mooreview.css">
</head>
<body class="bg-light">

<div class="container-fluid vh-100 p-0 overflow-hidden">
  <div class="row h-100 g-0">

    <div class="col-lg-7 d-none d-lg-block position-relative">
      <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=2070&auto=format&fit=crop"
           alt="Industrial monitoring"
           class="w-100 h-100 object-fit-cover">
      <div class="position-absolute top-0 start-0 w-100 h-100 splash-gradient"
           style="mix-blend-mode: multiply;">
      </div>
      <div class="position-absolute top-50 start-50 translate-middle text-center text-white w-75">
        <div class="mb-4">
          <i class="bi bi-buildings-fill display-1 text-white-50"></i>
        </div>
        <h1 class="display-4 fw-bold mb-3 brand-mark"><%= typeof productLabel !== 'undefined' ? productLabel : 'mooreVIEW Cloud' %></h1>
        <p class="lead text-light opacity-75">
          <%= typeof edition !== 'undefined' && edition.tagline ? edition.tagline : 'Multi-tenant plant monitoring — locations, systems, devices, and CMMS integration from the cloud.' %>
        </p>
        <div class="mt-5">
          <span class="badge rounded-pill bg-white text-purple px-3 py-2 me-2">
            <i class="bi bi-check-circle-fill me-1"></i> SCADA / Tags
          </span>
          <span class="badge rounded-pill bg-white text-purple px-3 py-2 me-2">
            <i class="bi bi-check-circle-fill me-1"></i> Alarms
          </span>
          <span class="badge rounded-pill bg-white text-purple px-3 py-2">
            <i class="bi bi-check-circle-fill me-1"></i> CMMS
          </span>
        </div>
      </div>
      <div class="position-absolute bottom-0 start-0 w-100 p-4 text-center text-white-50 small">
        &copy; <%= new Date().getFullYear() %> mooreVIEW · Purple Standard
      </div>
    </div>

    <div class="col-lg-5 d-flex align-items-center justify-content-center bg-light">
      <div class="card shadow-lg border-0" style="width: 100%; max-width: 450px; border-radius: 1rem;">
        <div class="card-body p-5">

          <div class="d-lg-none text-center mb-4">
            <i class="bi bi-buildings-fill display-4 text-purple"></i>
            <h2 class="fw-bold brand-mark">moore<span>VIEW</span></h2>
          </div>

          <div class="text-center mb-4">
            <h3 class="fw-bold text-secondary">Welcome Back</h3>
            <p class="text-muted small">Sign in to your organization</p>
          </div>

          <% if (error) { %>
            <div class="alert alert-danger py-2 small" role="alert"><%= error %></div>
          <% } %>
          <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success py-2 small" role="alert"><%= message %></div>
          <% } %>

          <form action="/login" method="POST">
            <% if (typeof next !== 'undefined' && next) { %>
              <input type="hidden" name="next" value="<%= next %>">
            <% } %>
            <div class="form-floating mb-3">
              <input type="text" name="tenantSlug" class="form-control" id="tenantSlug"
                     placeholder="demo" value="<%= tenantSlug %>" required autofocus>
              <label for="tenantSlug">Organization slug</label>
            </div>
            <div class="form-floating mb-3">
              <input type="email" name="email" class="form-control" id="email"
                     placeholder="you@example.com" value="<%= email %>" required>
              <label for="email">Email</label>
            </div>
            <div class="form-floating mb-4">
              <input type="password" name="password" class="form-control" id="password"
                     placeholder="Password" required>
              <label for="password">Password</label>
            </div>
            <div class="d-grid mb-3">
              <button type="submit" class="btn btn-purple btn-lg py-3 fw-bold shadow-sm transition-btn">
                Log In
              </button>
            </div>
            <p class="text-center small mb-0">
              <a href="/forgot-password">Forgot password?</a>
            </p>
          </form>

          <p class="text-center text-muted small mb-0">
            Dev seed: tenant <code>demo</code>, <code>admin@demo.test</code> / <code>admin123</code>
          </p>
        </div>
      </div>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
