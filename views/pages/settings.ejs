<p class="muted">Scan interval and graph buffer. Port is set via <code>PORT</code> env (default 3090).</p>
<div class="form-grid">
  <label>Scan interval (ms) <input id="set-scan" type="number" value="100"></label>
  <label>Graph max points <input id="set-graph-pts" type="number" value="600"></label>
</div>
<div class="toolbar">
  <button type="button" id="btn-save-settings" class="btn primary">Save</button>
  <button type="button" id="btn-export" class="btn">Export config</button>
  <label class="btn">Import <input type="file" id="import-file" hidden accept="application/json"></label>
</div>
