<%
  const tenantSeed = String((typeof tenant !== 'undefined' && tenant && (tenant.id || tenant.name)) || '');
  let tenantHash = 0;
  for (let i = 0; i < tenantSeed.length; i++) tenantHash = (tenantHash * 31 + tenantSeed.charCodeAt(i)) >>> 0;
  const badgeColors = ['#7c3aed', '#0ea5e9', '#15803d', '#b45309', '#be123c', '#4338ca'];
  const badgeColor = badgeColors[tenantHash % badgeColors.length];
  const tenantInitials = tenantSeed
    ? tenantSeed.trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase()
    : '—';
  const userLabel = (typeof user !== 'undefined' && user && (user.profile && user.profile.displayName || user.email)) || '';
  const userInitial = userLabel ? userLabel.trim()[0].toUpperCase() : '?';
%>
<nav class="navbar navbar-expand-lg navbar-dark nav-peaklogic px-3">
  <a class="navbar-brand mb-0 h1 text-decoration-none d-flex" href="/" style="align-items: baseline;">
    <svg class="brand-logo-icon" viewBox="4 10 24 18" fill="none" role="img" aria-label="PeakLogic"><path d="M4 28 L12 10 L18 20 L23 12 L28 28 Z" fill="#7C3AED"/><path d="M18 20 L23 12 L28 28 Z" fill="#22C55E" opacity="0.85"/></svg>
    <span class="brand-logotype"><span class="brand-logotype-peak">Peak</span><span class="brand-logotype-logic">Logic</span></span>
  </a>
  <% if (typeof tenant !== 'undefined' && tenant && tenant.name) { %>
    <span class="tenant-badge-slot">
      <span class="tenant-badge" style="background: <%= badgeColor %>;"><%= tenantInitials %></span>
    </span>
  <% } %>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mvNav">
    <span class="navbar-toggler-icon"></span>
  </button>
  <div class="collapse navbar-collapse" id="mvNav">
    <ul class="navbar-nav me-auto">
      <li class="nav-item">
        <a class="nav-link <%= activeNav === 'home' ? 'active' : '' %>" href="/"><i class="bi bi-house"></i> Home</a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= activeNav === 'fleet' ? 'active' : '' %>" href="/fleet"><i class="bi bi-hdd-stack"></i> Assets</a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= activeNav === 'sites' ? 'active' : '' %>" href="/sites"><i class="bi bi-geo-alt"></i> Sites</a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= activeNav === 'connectivity' ? 'active' : '' %>" href="/cellular/sims"><i class="bi bi-broadcast"></i> Connectivity</a>
      </li>
      <% if (user.role === 'tenant_admin' || user.role === 'platform_admin') { %>
        <li class="nav-item">
          <a class="nav-link <%= activeNav === 'team' ? 'active' : '' %>" href="/people"><i class="bi bi-people"></i> Team</a>
        </li>
      <% } %>
      <% if (cmmsEnabled) { %>
        <li class="nav-item">
          <a class="nav-link <%= activeNav === 'cmms' ? 'active' : '' %>" href="/cmms"><i class="bi bi-clipboard-check"></i> CMMS</a>
        </li>
      <% } %>
    </ul>
    <ul class="navbar-nav">
      <li class="nav-item dropdown">
        <button class="user-menu-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
          <span class="user-avatar"><%= userInitial %></span>
          <span class="d-none d-lg-inline"><%= userLabel %></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><h6 class="dropdown-header">API</h6></li>
          <li><a class="dropdown-item" href="/health">Health</a></li>
          <li><a class="dropdown-item" href="/?format=json">Service JSON</a></li>
          <li><a class="dropdown-item" href="/api/locations">Locations API</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item" href="/logout"><i class="bi bi-box-arrow-right"></i> Log out</a></li>
        </ul>
      </li>
    </ul>
  </div>
</nav>
