<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PeakLogic Cloud</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" href="/branding/peaklogic-favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/peaklogic.css">
</head>
<body class="bg-light">
<div class="top-accent-bar"></div>

<nav class="navbar navbar-dark nav-peaklogic px-3">
  <span class="navbar-brand mb-0 h1 d-flex" style="align-items: baseline;">
    <svg class="brand-logo-icon" viewBox="4 10 24 18" fill="none" role="img" aria-label="PeakLogic"><path d="M4 28 L12 10 L18 20 L23 12 L28 28 Z" fill="#7C3AED"/><path d="M18 20 L23 12 L28 28 Z" fill="#22C55E" opacity="0.85"/></svg>
    <span class="brand-logotype"><span class="brand-logotype-peak">Peak</span><span class="brand-logotype-logic">Logic</span></span>
  </span>
  <div class="d-flex gap-2">
    <a href="/login" class="btn btn-outline-light btn-sm">Sign in</a>
    <a href="/admin/login" class="btn btn-light btn-sm text-purple">Control Center</a>
  </div>
</nav>

<main class="container py-5" style="max-width:720px">
  <h1 class="h3 mb-2">Assets operations &amp; SCADA in the cloud</h1>
  <p class="text-muted mb-4">Sign in with your organization slug and account, or use Control Center to manage tenants.</p>

  <div class="row g-3">
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h2 class="h5">Tenant sign in</h2>
          <p class="text-muted small">Operators and engineers — assets map, sites, Studio, CMMS.</p>
          <a href="/login" class="btn btn-purple">Log in</a>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h2 class="h5">Platform admin</h2>
          <p class="text-muted small">Create tenants, fix names, CMMS entitlements, onboarding.</p>
          <a href="/admin/login" class="btn btn-outline-purple">Admin login</a>
        </div>
      </div>
    </div>
  </div>
</main>

</body>
</html>
