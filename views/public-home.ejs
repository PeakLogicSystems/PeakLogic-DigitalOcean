<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PeakLogic Cloud</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/peaklogic.css">
</head>
<body class="bg-light">

<nav class="navbar navbar-dark nav-mv px-3">
  <span class="navbar-brand brand-mark mb-0 h1 text-white">moore<span>VIEW</span> Cloud</span>
  <div class="d-flex gap-2">
    <a href="/login" class="btn btn-outline-light btn-sm">Sign in</a>
    <a href="/admin/login" class="btn btn-light btn-sm text-purple">Platform admin</a>
  </div>
</nav>

<main class="container py-5" style="max-width:720px">
  <h1 class="h3 mb-2">Assets operations &amp; SCADA in the cloud</h1>
  <p class="text-muted mb-4">Sign in with your organization slug and account, or use platform admin to manage tenants.</p>

  <div class="row g-3">
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h2 class="h5">Tenant sign in</h2>
          <p class="text-muted small">Operators and engineers — assets map, sites, Studio, CMMS.</p>
          <a href="/login" class="btn btn-purple">Log in</a>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h2 class="h5">Platform admin</h2>
          <p class="text-muted small">Create tenants, fix names, CMMS entitlements, onboarding.</p>
          <a href="/admin/login" class="btn btn-outline-purple">Admin login</a>
        </div>
      </div>
    </div>
  </div>
</main>

</body>
</html>
