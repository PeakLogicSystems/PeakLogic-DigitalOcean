<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PeakLogic</title>
  <link rel="stylesheet" href="/css/pc.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/css/cloud-studio.css?v=<%= assetV %>">
</head>
<body class="dashboard-body" data-mv-deployment="<%= typeof deployment !== 'undefined' ? deployment : 'cloud' %>">
  <div class="top-accent-bar"></div>
  <header class="topbar">
    <div class="topbar-brand"><a href="/" class="text-white text-decoration-none"><img src="/branding/peaklogic-icon.svg" alt="" class="topbar-brand-icon">Peak<span>Logic</span></a><span class="topbar-cloud-badge" title="PeakLogic Control Center">Control Center</span></div>
    <a href="/" class="btn btn-sm btn-outline-light ms-2" style="align-self:center">Cloud home</a>
    <a href="/sites" class="btn btn-sm btn-outline-light ms-1" style="align-self:center">Sites</a>
    <a href="/remote-sites" class="btn btn-sm btn-outline-light ms-1" style="align-self:center" title="Generate pairing codes for appliance cameras">Camera sites</a>
    <div class="topbar-project-bar">
      <details class="topbar-project-details" id="project-menu-details">
        <summary class="topbar-project-trigger">Project <span class="topbar-project-caret" aria-hidden="true">▾</span></summary>
        <div id="project-menu" class="topbar-project-dropdown" role="menu" aria-label="Project">
          <button type="button" class="topbar-menu-item" id="btn-project-status" role="menuitem">Status…</button>
          <button type="button" class="topbar-menu-item" id="btn-project-setup" role="menuitem">System setup…</button>
          <button type="button" class="topbar-menu-item" id="btn-proj-new-menu" role="menuitem">New project…</button>
          <div class="topbar-menu-sep" role="separator"></div>
          <button type="button" class="topbar-menu-item" id="btn-deploy-project" role="menuitem">Deploy project…</button>
          <button type="button" class="topbar-menu-item" id="btn-share-project" role="menuitem">Share project…</button>
          <div class="topbar-menu-sep" role="separator"></div>
          <button type="button" class="topbar-menu-item" id="btn-open-est" role="menuitem">Open project…</button>
          <button type="button" class="topbar-menu-item" id="btn-save-est" role="menuitem">Save project</button>
          <button type="button" class="topbar-menu-item" id="btn-save-est-as" role="menuitem">Save project as…</button>
          <button type="button" class="topbar-menu-item" id="btn-save-ws" role="menuitem">Save workspace</button>
        </div>
        <input type="file" id="file-open-est" accept=".est,.json,application/json" hidden>
      </details>
      <span class="topbar-project-status" id="project-name" aria-live="polite" title="Current project">untitled</span>
    </div>
    <div class="topbar-location-bar ms-2" id="studio-location-bar" style="align-self:center;display:flex;align-items:center;gap:0.35rem">
      <label for="studio-location-select" class="text-white-50 small mb-0">Site</label>
      <select id="studio-location-select" class="form-select form-select-sm" style="width:auto;min-width:10rem" title="Projects publish and deploy for this location">
        <option value="">Loading…</option>
      </select>
    </div>
    <details class="topbar-tools-details topbar-project-details" id="tools-menu-details">
      <summary class="topbar-project-trigger topbar-tools-trigger">Tools <span class="topbar-project-caret" aria-hidden="true">▾</span></summary>
      <nav class="topbar-tools-dropdown topbar-project-dropdown" id="view-nav" aria-label="Tools" role="menu">
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="program" role="menuitem">Program</button>
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="tags" role="menuitem">Tags</button>
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="alarms" role="menuitem">Alarms <span id="alarms-tab-badge" class="alarms-tab-badge view-hidden" aria-hidden="true"></span></button>
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="drivers" role="menuitem">Drivers</button>
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="cameras" role="menuitem">Cameras</button>
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="historian" role="menuitem">Historian</button>
        <button type="button" class="topbar-menu-item view-tab" data-popup-open="report" role="menuitem">Report</button>
        <a href="/studio/connectivity" class="topbar-menu-item" role="menuitem">Connectivity…</a>
        <button type="button" class="topbar-menu-item view-tab" id="btn-training" data-popup-open="training" title="Training curriculum (F2)" role="menuitem">Training</button>
        <button type="button" class="topbar-menu-item view-tab" id="btn-help" data-popup-open="help" title="Help (F1)" role="menuitem">Help</button>
      </nav>
    </details>
  </header>

  <main class="hmi-workspace">
    <section class="panel panel-hmi-main" id="sec-hmi-main">
      <div class="hmi-main-header">
        <h2>HMI</h2>
        <div class="hmi-main-actions">
          <button type="button" class="btn btn-sm btn-help-context" data-help-section="hmi-overview" title="Help: HMI — overview">Help</button>
          <button type="button" id="btn-hmi-setup" class="btn">Setup…</button>
          <button type="button" id="hmi-alarm-status" class="btn hmi-alarm-status view-hidden" title="Open the alarms list" aria-haspopup="dialog"><span class="hmi-alarm-status-label">Alarms</span><span id="hmi-alarm-status-detail" class="hmi-alarm-status-detail"></span></button>
          <button type="button" id="btn-hmi-reload" class="btn">Reload screen</button>
        </div>
      </div>
      <div class="hmi-main-body">
        <div class="hmi-screen-bar-shell">
          <div id="hmi-screen-bar" class="hmi-screen-bar">
            <nav id="hmi-nav-bar" class="hmi-nav-bar view-hidden" aria-label="HMI screen navigation"></nav>
            <div id="hmi-live-status" class="hmi-live-status">
              <div class="hmi-live-status-text">
                <div id="hmi-screen-title" class="muted cell-mono"></div>
                <p class="panel-hint hmi-display-hint">Live display — composed screen without grid lines. Open <strong>Setup…</strong> to edit on the tile grid.</p>
              </div>
            </div>
          </div>
          <button type="button" id="btn-hmi-toggle-screen-bar" class="btn btn-sm hmi-screen-bar-toggle" title="Hide screen tabs and status" aria-expanded="true" aria-controls="hmi-screen-bar">Hide</button>
        </div>
        <div class="hmi-live-stage-wrap">
          <div id="hmi-viewport" class="hmi-viewport hmi-viewport-live hmi-display-viewport"></div>
        </div>
        <div id="hmi-camera-popup" class="hmi-camera-popup view-hidden" role="dialog" aria-modal="true" aria-labelledby="hmi-camera-popup-title" aria-hidden="true">
          <div class="hmi-camera-popup-backdrop" data-hmi-camera-close></div>
          <div class="hmi-camera-popup-panel">
            <header class="hmi-camera-popup-header">
              <h2 id="hmi-camera-popup-title" class="hmi-camera-popup-title">Camera</h2>
              <button type="button" class="btn btn-sm hmi-camera-popup-close" data-hmi-camera-close title="Close camera view">Close</button>
            </header>
            <div class="hmi-camera-popup-body">
              <iframe id="hmi-camera-popup-frame" class="hmi-camera-popup-frame" title="Camera live view" allow="autoplay; fullscreen"></iframe>
            </div>
          </div>
        </div>
        <div id="hmi-room-popup" class="hmi-room-popup view-hidden" role="dialog" aria-modal="true" aria-labelledby="hmi-room-popup-title" aria-hidden="true">
          <div class="hmi-room-popup-backdrop" data-hmi-room-close></div>
          <div class="hmi-room-popup-panel">
            <header class="hmi-room-popup-header">
              <h2 id="hmi-room-popup-title" class="hmi-room-popup-title">Room</h2>
              <button type="button" class="btn btn-sm hmi-room-popup-close" data-hmi-room-close title="Close room detail">Close</button>
            </header>
            <div class="hmi-room-popup-body">
              <div id="hmi-room-popup-main" class="hmi-room-popup-main" aria-label="Room layout"></div>
              <aside id="hmi-room-popup-condenser" class="hmi-room-popup-condenser" aria-label="Roof condenser"></aside>
            </div>
            <div id="hmi-room-popup-flash" class="hmi-room-popup-flash view-hidden" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ST Program floating panel -->
  <!-- Cameras popup -->
  <div class="app-popup view-hidden" data-popup="cameras" role="dialog" aria-labelledby="popup-cameras-title">
    <div class="popup-chrome popup-chrome-wide popup-chrome-cameras popup-chrome-cameras-full">
      <header class="popup-header popup-header-split">
        <h2 id="popup-cameras-title">Cameras — administration</h2>
        <div class="popup-header-actions">
          <button type="button" id="btn-cameras-discover" class="btn btn-sm primary">Discover ONVIF</button>
          <button type="button" id="btn-cameras-refresh-all" class="btn btn-sm">Refresh all</button>
        </div>
      </header>
      <div class="cameras-shell cameras-shell-full">
        <nav class="cameras-nav setup-nav" aria-label="Camera sections">
          <button type="button" class="setup-tab active" data-cameras-tab-btn="overview">Overview</button>
          <button type="button" class="setup-tab" data-cameras-tab-btn="inventory">Inventory</button>
          <button type="button" class="setup-tab" data-cameras-tab-btn="detail">Detail</button>
          <button type="button" class="setup-tab" data-cameras-tab-btn="archive">Archive</button>
          <button type="button" class="setup-tab" data-cameras-tab-btn="events">Events</button>
          <button type="button" class="setup-tab" data-cameras-tab-btn="ai">AI history</button>
          <button type="button" class="setup-tab" data-cameras-tab-btn="discover">Discover</button>
          <button type="button" class="setup-tab" data-cameras-tab-btn="system">System</button>
          <button type="button" class="setup-tab" data-cameras-tab-btn="settings">Settings</button>
        </nav>
        <div class="cameras-panels setup-panels popup-scroll">
          <section class="cameras-panel setup-panel" data-cameras-tab="overview">
            <p class="panel-hint">Fleet health: probe status, streaming, archive, and vision AI at a glance.</p>
            <div id="cameras-overview-cards" class="cameras-overview-cards"></div>
            <h3 class="hmi-block-title">Camera fleet</h3>
            <div id="cameras-overview-fleet" class="cameras-overview-fleet"></div>
            <p id="cameras-overview-msg" class="muted cell-mono" aria-live="polite"></p>
          </section>
          <section class="cameras-panel setup-panel view-hidden" data-cameras-tab="inventory">
            <p class="panel-hint">Manage IP cameras for HMI popup iframes. Enable ONVIF (8000) and RTSP (554) on Reolink cameras, set credentials in Settings, then Discover or Probe.</p>
            <div class="toolbar wrap">
              <button type="button" id="btn-camera-add" class="btn">Add camera</button>
              <button type="button" id="btn-cameras-refresh" class="btn">Refresh</button>
              <button type="button" id="btn-cameras-probe-all" class="btn primary">Probe all</button>
            </div>
            <div id="cameras-inventory-table" class="cameras-inventory-table"></div>
            <form id="camera-edit-form" class="camera-edit-form view-hidden">
              <h3 class="hmi-block-title" id="camera-edit-title">Edit camera</h3>
              <div class="form-grid compact">
                <label>Camera ID <input id="cam-edit-id" maxlength="64" class="cell-mono" placeholder="auto from host"></label>
                <label>Name <input id="cam-edit-name" maxlength="120"></label>
                <label>Host <input id="cam-edit-host" required class="cell-mono" placeholder="192.168.1.50"></label>
                <label>Port <input id="cam-edit-port" type="number" min="1" max="65535" value="80"></label>
                <label>ONVIF URL <input id="cam-edit-onvif" class="cell-mono" placeholder="http://host:8000/onvif/device_service"></label>
                <label>Viewer URL (iframe) <input id="cam-edit-viewer" class="cell-mono" placeholder="/api/cameras/id/player"></label>
                <label>RTSP URL <input id="cam-edit-rtsp" class="cell-mono" placeholder="rtsp://user:pass@host:554/h264Preview_01_sub"></label>
                <label>Vendor <input id="cam-edit-vendor" readonly class="cell-mono" placeholder="reolink"></label>
                <label>ONVIF profile
                  <select id="cam-edit-profile">
                    <option value="">— unknown —</option>
                    <option value="T">Profile T (recommended)</option>
                    <option value="S">Profile S (legacy)</option>
                  </select>
                </label>
                <label>Username <input id="cam-edit-user" autocomplete="username"></label>
                <label>Password <input id="cam-edit-pass" type="password" autocomplete="current-password"></label>
                <label>Manufacturer <input id="cam-edit-mfg" readonly class="cell-mono"></label>
                <label>Model <input id="cam-edit-model" readonly class="cell-mono"></label>
                <label>Probe status <input id="cam-edit-probe-status" readonly class="cell-mono"></label>
                <label class="span-all">Probe message <input id="cam-edit-probe-error" readonly class="cell-mono"></label>
                <label class="span-all">Notes <textarea id="cam-edit-notes" rows="2" maxlength="500"></textarea></label>
              </div>
              <div class="toolbar wrap">
                <button type="submit" class="btn primary">Save</button>
                <button type="button" id="btn-camera-probe" class="btn">Probe ONVIF</button>
                <button type="button" id="btn-camera-snapshot" class="btn">Capture snapshot</button>
                <button type="button" id="btn-camera-infer" class="btn">Run AI infer</button>
                <button type="button" id="btn-camera-view-snapshots" class="btn">View archive</button>
                <button type="button" id="btn-camera-test" class="btn">Test popup</button>
                <button type="button" id="btn-camera-cancel-edit" class="btn">Cancel</button>
                <button type="button" id="btn-camera-delete" class="btn danger view-hidden">Delete</button>
              </div>
            </form>
            <p id="cameras-inventory-msg" class="muted cell-mono" aria-live="polite"></p>
          </section>
          <section class="cameras-panel setup-panel view-hidden" data-cameras-tab="detail">
            <div class="toolbar wrap cameras-detail-toolbar">
              <label class="cameras-filter-label">Camera
                <select id="cameras-detail-select" class="cameras-select">
                  <option value="">— select camera —</option>
                </select>
              </label>
              <button type="button" id="btn-detail-probe" class="btn btn-sm">Probe</button>
              <button type="button" id="btn-detail-snapshot" class="btn btn-sm">Snapshot</button>
              <button type="button" id="btn-detail-infer" class="btn btn-sm">AI infer</button>
              <button type="button" id="btn-detail-popup" class="btn btn-sm primary">Live popup</button>
              <button type="button" id="btn-detail-edit" class="btn btn-sm">Edit</button>
            </div>
            <div id="cameras-detail-body" class="cameras-detail-body">
              <p class="panel-hint">Select a camera to view live stream, URLs, and latest snapshot.</p>
            </div>
            <p id="cameras-detail-msg" class="muted cell-mono" aria-live="polite"></p>
          </section>
          <section class="cameras-panel setup-panel view-hidden" data-cameras-tab="archive">
            <div class="toolbar wrap">
              <label class="cameras-filter-label">Camera
                <select id="cameras-archive-filter" class="cameras-select">
                  <option value="">All cameras</option>
                </select>
              </label>
              <button type="button" id="btn-archive-refresh" class="btn btn-sm primary">Refresh gallery</button>
              <button type="button" id="btn-archive-capture" class="btn btn-sm">Capture now</button>
            </div>
            <div id="cameras-archive-gallery" class="cameras-archive-gallery"></div>
            <p id="cameras-archive-msg" class="muted cell-mono" aria-live="polite"></p>
          </section>
          <section class="cameras-panel setup-panel view-hidden" data-cameras-tab="events">
            <div class="toolbar wrap">
              <label class="cameras-filter-label">Camera
                <select id="cameras-events-filter" class="cameras-select">
                  <option value="">All cameras</option>
                </select>
              </label>
              <label class="cameras-filter-label">Type
                <select id="cameras-events-type" class="cameras-select">
                  <option value="">All types</option>
                  <option value="snapshot">snapshot</option>
                  <option value="motion">motion</option>
                  <option value="inference">inference</option>
                  <option value="inference_alarm">inference_alarm</option>
                  <option value="error">error</option>
                  <option value="info">info</option>
                </select>
              </label>
              <button type="button" id="btn-events-refresh" class="btn btn-sm primary">Refresh</button>
            </div>
            <div id="cameras-events-table" class="cameras-events-table"></div>
            <p id="cameras-events-msg" class="muted cell-mono" aria-live="polite"></p>
          </section>
          <section class="cameras-panel setup-panel view-hidden" data-cameras-tab="ai">
            <div class="toolbar wrap">
              <label class="cameras-filter-label">Camera
                <select id="cameras-ai-filter" class="cameras-select">
                  <option value="">All cameras</option>
                </select>
              </label>
              <label class="cameras-filter-label">Hours
                <select id="cameras-ai-hours" class="cameras-select">
                  <option value="6">6 h</option>
                  <option value="24" selected>24 h</option>
                  <option value="72">72 h</option>
                  <option value="168">7 d</option>
                </select>
              </label>
              <button type="button" id="btn-ai-refresh" class="btn btn-sm primary">Refresh</button>
              <button type="button" id="btn-ai-infer-selected" class="btn btn-sm">Run infer on selected</button>
            </div>
            <div id="cameras-ai-table" class="cameras-ai-table"></div>
            <p id="cameras-ai-msg" class="muted cell-mono" aria-live="polite"></p>
          </section>
          <section class="cameras-panel setup-panel view-hidden" data-cameras-tab="discover">
            <p class="panel-hint">Scans with <strong>WS-Discovery</strong> (every network adapter + broadcast) and a <strong>TCP subnet sweep</strong> of your local /24 (ONVIF 8000/80, plus native 9000 &amp; RTSP 554 to detect cameras that have ONVIF turned off). Reolink ONVIF is on port <strong>8000</strong> and is <strong>disabled by default</strong>.</p>
            <div class="toolbar wrap">
              <button type="button" id="btn-cameras-discover-tab" class="btn primary">Scan network</button>
              <label class="cameras-inline-check"><input type="checkbox" id="cam-discover-subnet-sweep" checked> Subnet TCP sweep</label>
            </div>
            <div class="cameras-addip-bar">
              <p class="panel-hint">Camera not found by scan? Enter its IP address (from your router's DHCP list or the Reolink app) to add it directly.</p>
              <div class="toolbar wrap">
                <label class="cameras-filter-label">IP address
                  <input id="cameras-addip-host" type="text" inputmode="decimal" placeholder="192.168.1.88" class="cell-mono">
                </label>
                <button type="button" id="btn-cameras-add-ip" class="btn">Add &amp; probe by IP</button>
              </div>
              <p class="panel-hint">Uses the default credentials from <strong>Settings</strong>. Set them first if your camera requires a login.</p>
            </div>
            <div id="cameras-discover-needs-setup" class="cameras-discover-needs-setup view-hidden"></div>
            <div id="cameras-discover-results" class="cameras-discover-results"></div>
            <p id="cameras-discover-msg" class="muted cell-mono" aria-live="polite"></p>
          </section>
          <section class="cameras-panel setup-panel view-hidden" data-cameras-tab="system">
            <p class="panel-hint">go2rtc streaming proxy, MongoDB GridFS archive, and background services.</p>
            <div id="cameras-system-panels" class="cameras-system-panels"></div>
            <div class="toolbar wrap">
              <button type="button" id="btn-system-sync-go2rtc" class="btn primary">Sync streams to go2rtc</button>
              <button type="button" id="btn-system-ai-refresh" class="btn">Refresh AI monitors</button>
              <button type="button" id="btn-system-refresh" class="btn">Refresh status</button>
            </div>
            <p id="cameras-system-msg" class="muted cell-mono" aria-live="polite"></p>
          </section>
          <section class="cameras-panel setup-panel view-hidden" data-cameras-tab="settings">
            <div id="cameras-cloud-host-panel" class="view-hidden">
              <h3 class="hmi-block-title">Remote camera sites (cloud)</h3>
              <p class="panel-hint">Generate pairing codes here, then paste them on the edge appliance under <strong>Tools → Cameras → Settings → Cloud Studio</strong>. ONVIF credentials stay on the appliance; only a redacted camera catalog syncs to the cloud.</p>
              <div class="toolbar wrap">
                <label>Site ID <input id="cam-cloud-new-site-id" type="text" placeholder="plant_a" class="cell-mono"></label>
                <label>Name <input id="cam-cloud-new-site-name" type="text" placeholder="Plant A"></label>
                <button type="button" id="btn-cam-cloud-create-site" class="btn primary">Create site &amp; keys</button>
                <a href="/remote-sites" class="btn">Full camera sites page</a>
                <button type="button" id="btn-cam-cloud-refresh-sites" class="btn">Refresh</button>
              </div>
              <div id="cam-cloud-pairing-banner" class="cameras-cloud-pairing-banner"></div>
              <div id="cam-cloud-sites-table" class="cameras-cloud-sites-table"></div>
              <p id="cam-cloud-sites-msg" class="muted cell-mono" aria-live="polite"></p>
            </div>
            <div id="cameras-appliance-settings">
            <p class="panel-hint">Discovery defaults, credentials (<code>data/cameras.json</code>), archive, and vision AI. Install go2rtc: <code>npm run go2rtc:download</code>.</p>
            <div class="form-grid compact">
              <label>Discover timeout (ms) <input id="cam-set-timeout" type="number" min="1000" max="15000" step="500" value="4000"></label>
              <label>ONVIF port (Reolink) <input id="cam-set-onvif-port" type="number" min="1" max="65535" value="8000"></label>
              <label>RTSP port <input id="cam-set-rtsp-port" type="number" min="1" max="65535" value="554"></label>
              <label>go2rtc port <input id="cam-set-go2rtc-port" type="number" min="1024" max="65535" value="1984"></label>
              <label>MJPEG interval (ms) <input id="cam-set-mjpeg-ms" type="number" min="100" max="2000" step="50" value="200"></label>
              <label>Stream backend
                <select id="cam-set-stream-backend">
                  <option value="go2rtc">go2rtc (H.264 WebRTC/MSE)</option>
                  <option value="mjpeg">ONVIF snapshot MJPEG</option>
                </select>
              </label>
              <label>Default username <input id="cam-set-user" autocomplete="username" placeholder="admin"></label>
              <label>Default password <input id="cam-set-pass" type="password" autocomplete="current-password"></label>
              <label class="checkbox-inline span-all"><input type="checkbox" id="cam-set-go2rtc-enabled" checked> Enable go2rtc (auto-start on server boot)</label>
              <label class="checkbox-inline span-all"><input type="checkbox" id="cam-set-auto-add" checked> Auto-add discovered cameras to inventory</label>
              <label class="checkbox-inline span-all"><input type="checkbox" id="cam-set-auto-probe" checked> Auto-probe after discover</label>
              <label class="checkbox-inline span-all"><input type="checkbox" id="cam-set-gridfs-mirror" checked> Mirror HMI/Facility Builder uploads to GridFS</label>
              <label class="checkbox-inline span-all"><input type="checkbox" id="cam-set-snapshot-archive" checked> Archive camera snapshots to GridFS</label>
              <label>Snapshot interval (ms) <input id="cam-set-snapshot-ms" type="number" min="15000" max="3600000" step="1000" value="60000"></label>
              <label>Snapshot retention (days) <input id="cam-set-snapshot-days" type="number" min="1" max="365" value="30"></label>
              <label class="checkbox-inline span-all"><input type="checkbox" id="cam-set-prefer-sub" checked> Prefer substream (Reolink h264Preview_01_sub)</label>
            </div>
            <h3 class="hmi-block-title">Camera AI (edge + post-capture)</h3>
            <div class="form-grid compact">
              <label class="checkbox-inline span-all"><input type="checkbox" id="cam-set-ai-enabled" checked> Enable camera vision AI</label>
              <label>Backend
