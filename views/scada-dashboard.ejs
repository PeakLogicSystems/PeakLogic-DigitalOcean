              </label>
            </div>
            <div class="toolbar wrap">
              <button type="button" id="btn-proj-save" class="btn">Save project</button>
              <button type="button" id="btn-proj-save-as" class="btn primary">Save as…</button>
              <button type="button" id="btn-proj-open" class="btn">Open selected</button>
              <button type="button" id="btn-proj-delete" class="btn danger">Delete selected</button>
            </div>
          </section>

        </div>
      </div>
      <footer class="popup-footer setup-footer">
        <div class="popup-footer-leading">
          <button type="button" id="btn-proj-apply" class="btn primary">Apply all settings</button>
          <span id="proj-msg" class="muted"></span>
        </div>
        <button type="button" class="btn popup-close" data-popup-close="project">Close</button>
      </footer>
    </div>
