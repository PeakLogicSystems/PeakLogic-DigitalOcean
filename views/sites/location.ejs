<%- include('../partials/shell-head', { title }) %>
<%- include('../partials/shell-nav', { user, tenant, cmmsEnabled, activeNav }) %>

<main class="container py-4">
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
      <li class="breadcrumb-item"><a href="/sites">Sites</a></li>
      <li class="breadcrumb-item active"><%= location.name %></li>
    </ol>
  </nav>

  <% if (error) { %>
    <div class="alert alert-danger py-2 small"><%= error %></div>
  <% } %>
  <% if (message) { %>
    <div class="alert alert-success py-2 small"><%= message %></div>
  <% } %>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h1 class="h4 mb-1"><%= location.name %></h1>
      <p class="text-muted small mb-0">
        Slug <code><%= location.slug %></code>
        <% if (location.description) { %> · <%= location.description %><% } %>
      </p>
    </div>
  </div>

  <% if (canManage) { %>
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <h2 class="h5 mb-3">Add system</h2>
        <p class="text-muted small">Systems are used when pairing edge appliances (<code>locationSlug</code> / <code>systemSlug</code>).</p>
        <form action="/sites/<%= location.id %>/systems" method="POST" class="row g-3 align-items-end">
          <div class="col-md-4">
            <label class="form-label small" for="sys-name">Name</label>
            <input type="text" class="form-control" id="sys-name" name="name" required placeholder="Line 1">
          </div>
          <div class="col-md-3">
            <label class="form-label small" for="sys-slug">Slug</label>
            <input type="text" class="form-control" id="sys-slug" name="slug" required placeholder="line-1"
                   pattern="[a-z0-9][a-z0-9-]*" title="Lowercase letters, numbers, hyphens">
          </div>
          <div class="col-md-2">
            <label class="form-label small" for="sys-scan">Scan (ms)</label>
            <input type="number" class="form-control" id="sys-scan" name="scanMs" value="100" min="10">
          </div>
          <div class="col-md-3">
            <button type="submit" class="btn btn-purple w-100">Add system</button>
          </div>
        </form>
      </div>
    </div>
  <% } %>

  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Systems</div>
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Scan</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!systems.length) { %>
            <tr>
              <td colspan="4" class="text-muted p-4">
                No systems yet.<% if (canManage) { %> Add one above.<% } %>
              </td>
            </tr>
          <% } else { %>
            <% systems.forEach(function(sys) { %>
              <tr>
                <td><strong><%= sys.name %></strong></td>
                <td><code><%= sys.slug %></code></td>
                <td><%= sys.scanMs %> ms</td>
                <td class="text-end">
                  <a href="/sites/<%= location.id %>/systems/<%= sys.id %>" class="btn btn-sm btn-outline-purple">Devices</a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Studio projects</span>
      <% if (canManage) { %>
        <a href="/studio?locationId=<%= location.id %>" class="btn btn-sm btn-purple">Open Studio for this site</a>
      <% } %>
    </div>
    <div class="card-body">
      <p class="text-muted small mb-3">
        Each location can have its own published project catalog in PeakLogic Cloud.
        Publish from Studio with this site selected, or open Studio here to edit and deploy.
      </p>
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th>Project</th>
              <th>Slug</th>
              <th>Version</th>
              <th>Updated</th>
              <% if (user.role === 'admin') { %><th></th><% } %>
            </tr>
          </thead>
          <tbody>
            <% if (!projects.length) { %>
              <tr>
                <td colspan="<%= user.role === 'admin' ? 5 : 4 %>" class="text-muted p-4">
                  No projects for this site yet.<% if (canManage) { %>
                    Open Studio above, build your project, then use <strong>Share project → PeakLogic Cloud</strong>.
                  <% } %>
                </td>
              </tr>
            <% } else { %>
              <% projects.forEach(function(p) { %>
                <tr>
                  <td><strong><%= p.name %></strong></td>
                  <td><code><%= p.slug %></code></td>
                  <td>v<%= p.version %></td>
                  <td class="small text-muted">
                    <%= p.updatedAt ? new Date(p.updatedAt).toLocaleDateString() : '—' %>
                  </td>
                  <% if (user.role === 'admin') { %>
                    <td class="text-end">
                      <form action="/sites/<%= location.id %>/projects/<%= p.id %>/delete" method="POST" class="d-inline"
                            onsubmit="return confirm('Delete this published project?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                      </form>
                    </td>
                  <% } %>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <% if (user.role === 'admin') { %>
    <form action="/sites/<%= location.id %>/delete" method="POST"
          onsubmit="return confirm('Delete this location, all systems, devices, and published projects?');">
      <button type="submit" class="btn btn-outline-danger btn-sm">Delete location</button>
    </form>
  <% } %>
</main>

<%- include('../partials/shell-foot') %>
